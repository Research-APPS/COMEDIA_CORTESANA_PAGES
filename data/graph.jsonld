      "identifier": "CMC002634",
      "name": "El Austria en Jerusalén",
      "titulo": "El Austria en Jerusalén",
      "titulo_limpio": "El Austria en Jerusalén",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
