      ],
      "identifier": "CMC002535",
      "name": "Cueva y castillo de amor",
      "titulo": "Cueva y castillo de amor",
      "titulo_limpio": "Cueva y castillo de amor",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=293&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nCueva y castillo de amor se publicó a nombre de Francisco Leiva Ramírez de Arellano en la Parte 43 de la colección de Comedias Escogidas (Madrid, Antonio González de Reyes, 1678)[[ (CM15, 166-67)]]. Se tiene noticia de una suelta impresa en Sevilla por la viuda de Francisco de Leefdael, sin año pero del siglo XVIII, donde también se atribuye la comedia a Francisco Leiva[[ (BS, 301)]]. Fajardo, por su parte, dejó constancia de la existencia de sueltas publicadas en Madrid y Valencia de esta comedia, hoy perdidas[[ (Faj, 14v)]]. La crítica no ha dudado en dar por válida la atribución de los impresos, tal y como reflejan catálogos como los del citado Fajardo, Medel del Castillo, García de la Huerta, Arteaga, Mesonero Romanos, La Barrera y Urzáiz[[ (MC, 27; GaH, 48; Art, 88v; MeR, XXIX; BL, 539; UT, I, 392)]]. También González Hernández, al dar cuenta de la noticia de 1692 recogida en el apartado de cronología, atribuye Cueva y castillo de amor a Francisco Leiva Ramírez de Arellano[[ (GH, 266)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
