        "schema:CreativeWork"
      ],
      "identifier": "CMC004228",
      "name": "Ofensas mudan afectos",
      "titulo": "Ofensas mudan afectos",
      "titulo_limpio": "Ofensas mudan afectos",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "comedia",
      "estado_ficha": "cruda",
      "fuente_principal": "AMBAS",
      "pagina_pdf": 177,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1382&mode=indice&letter=o",
      "notas": "",
      "notas_bibliograficas": "Comedia de Pérez de Montalbán, impresa en el Primero tomo de sus comedias (Madrid, 1635). En la B.N.M. hay manuscrito de las jornadas segunda y tercera de El impossible vencido y ystoria de Olimpa y Vireno, 17.450(21), sin atribución. Paz, I, 261, confunde esta comedia, completamente distinta, con la de Montalbán.",
      "observaciones": "Atribución (CATCOM):\nOfensas mudan afectos es una comedia de Pedro de Arce, tal y como se indica en la noticia de representación de 1688[[ (F, VI, 289; F, IX, 176-77)]]. No nos consta la existencia de testimonios de esta obra[[ (UT, I, 136)]]. Cabe señalar que, según Shergold y Varey, en el ensayo de la obra, el 20 de diciembre de 1688, el título de la obra se da en la documentación equivocadamente como Ofensas me dan afectos y que se escribió así en el certificado del 22, pero que luego se corrigió[[ (F, VI, 289)]].",
      "edicion_principe": "el Primero tomo de sus comedias (Madrid",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
