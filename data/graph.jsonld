      "identifier": "CMC003170",
      "name": "El rey Alfonso",
      "titulo": "El rey Alfonso",
      "titulo_limpio": "El rey Alfonso",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
