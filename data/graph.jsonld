      "identifier": "CMC002807",
      "name": "El bautismo de San Juan",
      "titulo": "El bautismo de San Juan",
      "titulo_limpio": "El bautismo de San Juan",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
