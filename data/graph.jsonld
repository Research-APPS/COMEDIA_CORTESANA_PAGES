        "schema:CreativeWork"
      ],
      "identifier": "CMC002894",
      "name": "El desposorio encubierto",
      "titulo": "El desposorio encubierto",
      "titulo_limpio": "El desposorio encubierto",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1966&mode=indice&letter=d",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl desposorio encubierto es obra de Lope de Vega, como señalan Morley y Bruerton y los catálogos clásicos que hemos consultado[[ (MoB, 309-10; Faj, 16v; MC, 30; GaH, 54; Art, 101r; MeR, XXX; BL, 541; Sal, 589; UT, II, 660)]]. Se publicó en la Parte 13 de su colección de comedias (Madrid, Viuda de Alonso Martín, 1620), donde el Fénix evocó el estreno de la obra por parte de Luis de Vergara indicando al frente de ella \"Representola Vergara\"[[ (ARTELOPE; TESO)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
