      ],
      "identifier": "CMC003501",
      "name": "La casa de Austria en España",
      "titulo": "La casa de Austria en España",
      "titulo_limpio": "La casa de Austria en España",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
