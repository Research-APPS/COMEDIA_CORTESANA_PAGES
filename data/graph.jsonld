    {
      "@id": "https://comedia-cortesana.local/obra/CMC003214",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003214",
      "name": "El seno de Abraham",
      "titulo": "El seno de Abraham",
      "titulo_limpio": "El seno de Abraham",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2064&mode=indice&letter=s",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ningún auto titulado El seno de Abraham en los catálogos clásicos que manejamos ni nos consta la existencia de testimonios de esta obra. Tampoco Alenda y Mira menciona en su catálogo obra alguna con este título. Hay otros autos antiguos que tratan asuntos relacionados con el patriarca bíblico. Por poner solo un ejemplo: en la colección del Códice de autos viejos figuran tres piezas relacionadas con Abraham, sin embargo ninguno de estos títulos apuntan a que se trate del auto que nos ocupa, cuyo título, y es solo una hipótesis, podría contener un error de copia, y ser más bien El sueño de Abraham, haciendo referencia al conocido episodio bíblico. Hay que señalar, no obstante, que los catálogos consultados no recogen ningún auto con este último título. Finalmente, pueden consultarse en CATCOM algunos registros que tienen títulos relacionados con la mencionada figura bíblica.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
