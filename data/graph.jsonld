      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=121&mode=indice&letter=m",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nTal y como se indica arriba, La muerte del maestre figura en el listado de comedias de Lope publicado en la edición de 1604 de El peregrino en su patria, aunque, como ya hizo constar La Barrera, el texto de esta comedia no se conserva actualmente[[ (Ch, 551; BL, 451, 566)]]. Morley y Bruerton no citan esta comedia y solo los catálogos de Arteaga y Mesoneros, además del citado de La Barrera, atribuyen la obra a Lope[[ (Art, 251r; MeR, XL)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
