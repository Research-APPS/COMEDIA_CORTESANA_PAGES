      "identifier": "CMC003107",
      "name": "El platicante de amor",
      "titulo": "El platicante de amor",
      "titulo_limpio": "El platicante de amor",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
