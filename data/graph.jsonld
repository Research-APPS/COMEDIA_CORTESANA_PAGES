    {
      "@id": "https://comedia-cortesana.local/obra/CMC002499",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002499",
      "name": "Coloquio de San Francisco de Borja",
      "titulo": "Coloquio de San Francisco de Borja",
      "titulo_limpio": "Coloquio de San Francisco de Borja",
      "alternateName": "",
      "tipo_obra": "otro",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2991&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nComo se puede ver en la base de datos TeatrEsco, las representaciones en honor a San Francisco de Borja abundan dentro de la tradición teatral jesuítica. Sin embargo, resulta sumamente difícil asimilar la noticia de 1650 a alguno de los textos conocidos. En 1674, se representó también en Lima El fénix de España, San Francisco de Borja, pieza atribuida a Pedro López de Lara. Remitimos a la entrada de CATCOM correspondiente para un detalle de la manera en la cual se registran en los catálogos clásicos las comedias dedicadas al santo. Por ahora, no tenemos motivos para pensar que la representación de 1650 nos conduzca a la misma obra que se representó en 1674.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
      "tiene_representacion": [
        {
          "@id": "https://comedia-cortesana.local/representacion/REP000690"
        }
      ]
    },
    {
      "@id": "https://comedia-cortesana.local/representacion/REP000690",
      "@type": [
        "cmc:Representacion",
        "schema:Event"
      ],
      "identifier": "REP000690",
