        "schema:CreativeWork"
      ],
      "identifier": "CMC002843",
      "name": "El carro del cielo",
      "titulo": "El carro del cielo",
      "titulo_limpio": "El carro del cielo",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1211&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl carro del cielo es una obra perdida de Pedro Calderón de la Barca. Cruickshank la lista entre las ‘lost works’ debido a su presencia en una lista de las obras contenidas en una supuesta décima parte incluida al final de la Parte 9 de Vera Tassis (Madrid, Francisco Sanz, 1691)[[ (Don Pedro Calderón, 343)]]. En la lista de Vera Tassis lleva el título El carro del cielo, San Elías, y así se incluye en los catálogos de Mesonero Romanos y Salvá, siempre con atribución a Calderón[[ (MeR, XXVII; Sal, 372)]]. Héctor Urzáiz cataloga El carro del cielo, también con atribución a Calderón de la Barca, entre las comedias de este autor[[ (UT, I, 182)]]. Cruickshank hace una breve mención de la obra —supuestamente la primera del dramaturgo— en su biografía[[ (Don Pedro Calderón, 39)]]. Como la obra de Calderón se halla perdida, desconocemos si se trataba de una comedia o de un auto o si pudo haber dos piezas de distinto género con idéntico o similar título. Lo que parece probable es que las dos noticias que mencionamos en el calendario se refieran a la misma obra que en la noticia de representación de Valencia se menciona como auto, lo que arroja alguna duda respecto a la identificación con la comedia perdida de Calderón.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
