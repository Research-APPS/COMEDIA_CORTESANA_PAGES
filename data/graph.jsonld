      ],
      "identifier": "CMC002775",
      "name": "El afanador de Utrera",
      "titulo": "El afanador de Utrera",
      "titulo_limpio": "El afanador de Utrera",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
