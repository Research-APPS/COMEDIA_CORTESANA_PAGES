      ],
      "identifier": "CMC004280",
      "name": "Quien todo lo quiere",
      "titulo": "Quien todo lo quiere",
      "titulo_limpio": "Quien todo lo quiere",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
