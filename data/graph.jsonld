    {
      "@id": "https://comedia-cortesana.local/obra/CMC004004",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004004",
      "name": "Los Tellos de Meneses (primera parte)",
      "titulo": "Los Tellos de Meneses (primera parte)",
      "titulo_limpio": "Los Tellos de Meneses (primera parte)",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=842&mode=indice&letter=t",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLos Tellos de Meneses (primera parte) es una obra de Lope de Vega[[ (Art, 367r; BL, 585, GaH, 180; MeR, XLIX; UT, II, 681)]] publicada en la Parte 21 de sus comedias (Madrid, viuda de Alonso Martin, 1635). También se publicó en forma de suelta (Madrid, Juan Sanz, s.a). Morley y Bruerton la consideran compuesta entre 1620 y 1628[[ (MoB, 397-398, 564-565)]]. Existe una segunda parte del mismo autor titulada Valor, fortuna y lealtad de los Tellos de Meneses. Puede verse el registro de esta última en CATCOM, y también lo apuntado en el registro de La infanta robada o El blasón de los Meneses, representada en 1605, y en el de Los Tellos de Meneses, representada en 1585. No pueden ser, a pesar de sus títulos y por razones de cronología, representaciones de ninguna de las dos obras de Lope de Vega.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
