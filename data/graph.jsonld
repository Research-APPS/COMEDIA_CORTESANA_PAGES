      "identifier": "CMC003116",
      "name": "El premio de la limosna",
      "titulo": "El premio de la limosna",
      "titulo_limpio": "El premio de la limosna",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
