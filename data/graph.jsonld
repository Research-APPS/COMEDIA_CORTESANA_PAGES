      "identifier": "CMC003046",
      "name": "El mejor amigo, el rey",
      "titulo": "El mejor amigo, el rey",
      "titulo_limpio": "El mejor amigo, el rey",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
