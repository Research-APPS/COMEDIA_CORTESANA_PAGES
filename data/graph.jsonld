    {
      "@id": "https://comedia-cortesana.local/obra/CMC003903",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003903",
      "name": "Las hostias",
      "titulo": "Las hostias",
      "titulo_limpio": "Las hostias",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1707&mode=indice&letter=h",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ningún auto titulado Las hostias en los catálogos clásicos que manejamos, con la excepción del catálogo más reciente de Urzáiz, donde figura como anónimo[[ (UT, I, 90)]]. Sin embargo, Sánchez Arjona da cuenta de cierta documentación del año 1639 del ayuntamiento de Sevilla en la que se hacía constar que se había pagado a Fernando de la Torre “por el trabajo que tuvo en hacer y componer un auto para el Corpus” y también a Francisco Jiménez, “sostituto de la Ciudad”, por la misma razón. Estos autos no se representaron finalmente en 1639, por lo que el ayuntamiento acordó reservarlos para otra fiesta del Corpus. Sabemos por la documentación aportada por Sánchez Arjona que uno de los autos representados en 1640 fue Los aplausos de la fe, de Francisco Jiménez Sedeño. Por ello, dicho investigador supone que el otro auto, el titulado Las hostias, que es el que nos ocupa, sería el escrito en 1639 por Fernando de la Torre, que se representaría en 1640 al no haberse podido representar el año anterior[[ (SA, 331, 344)]]. La hipótesis es verosímil, pero al carecer de ningún otro dato que corrobore la autoría de Fernando de la Torre del auto que nos ocupa, la damos como dudosa. No nos consta la existencia de testimonios de esta obra.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
      "tiene_representacion": [
        {
          "@id": "https://comedia-cortesana.local/representacion/REP003100"
        }
      ]
    },
