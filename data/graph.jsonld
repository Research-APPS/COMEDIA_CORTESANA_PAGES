      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/fuentesix"
        }
      ]
    },
    {
      "@id": "https://comedia-cortesana.local/obra/CMC002389",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002389",
      "name": "Aguardad, supremos dioses",
      "titulo": "Aguardad, supremos dioses",
      "titulo_limpio": "Aguardad, supremos dioses",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1811&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLos catálogos antiguos consultados no recogen ningún sainete con este título. Sin embargo, tanto La Barrera como Salvá citaban uno, sin título, que se representó y se imprimió junto a Triunfos de amor y fortuna y a los entremeses Salta en banco y El niño caballero y que se trata del que nos ocupa. Probablemente su noticia porcedía de la Parte XIII de Comedias Escogidas (Madrid, F. Serrano, 1660) y la Parte XLVII de la misma colección (Madrid, Melchor Álvarez, 1681), en donde se publicó sin título, acompañando a la comedia Triunfos de amor y fortuna y a los entremeses ya mencionados[[ (BL, 376; Sal, 511, 656; CM15, 187, 439)]]. También se imprimió en las Comedias de Antonio de Solís (Madrid, Melchor Álvarez, 1681) junto a las obras anteriormente referidas y otras comedias del autor, según Vázquez Estévez (Vázquez Estévez, 398-399). En la Biblioteca del Institut del Teatre de Barcelona, se conserva un manuscrito de esta obra con letra del siglo XIX, signatura ms. 47.229, en donde figura como fin de fiesta de Triunfos de amor y fortuna[[ (SiP, 63, nº710)]]. El sainete sí es mencionado en el más reciente catálogo de Urzáiz como obra de Solís[[ (UT, II, 612-13)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
