    {
      "@id": "https://comedia-cortesana.local/obra/CMC002485",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002485",
      "name": "Cegar para ver mejor",
      "titulo": "Cegar para ver mejor",
      "titulo_limpio": "Cegar para ver mejor",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=344&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nCegar para ver mejor aparece en los catálogos antiguos también por el título Cegar para ver mejor, Santa Lucía, Santa Lucía, cegar para ver mejor o simplemente Santa Lucía[[ (Faj, 12v; MC, 21, 105; Sal, 404;GaH, 40, 169; Art, 63v, 343v; BL, 16; MeR, XXVIII, XLVII)]]. La atribución en todos los catálogos es a Ambrosio Arce de los Reyes. Hay un manuscrito, autógrafo en gran parte, con censuras de 1653, que proviene de la biblioteca del duque de Osuna[[ (BL, 16)]], ahora en la BNE, signatura ms. 14.881[[ (PM, 88; UT, I, 135)]]. La obra se publicó en la Parte 13 de la colección Comedias Escogidas (Madrid, Mateo Fernández, 1660)[[ (CM15, 438)]]. Por su parte, Fajardo da noticia de un edición suelta[[ (Faj, 12v)]]. Véase también los detalles que suministra Juliá Martínez sobre un ejemplar del texto en Toledo[[ (JM4, 571)]]. Existe en CATCOM un auto titulado Santa Lucía, que no tiene que ver con la obra que nos ocupa.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
