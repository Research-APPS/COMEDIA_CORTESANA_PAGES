      "identifier": "CMC002947",
      "name": "El galán sin dama",
      "titulo": "El galán sin dama",
      "titulo_limpio": "El galán sin dama",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
