    {
      "@id": "https://comedia-cortesana.local/obra/CMC003792",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003792",
      "name": "La soberbia y caída de Lucifer",
      "titulo": "La soberbia y caída de Lucifer",
      "titulo_limpio": "La soberbia y caída de Lucifer",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1895&mode=indice&letter=s",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl auto La soberbia y caída de Lucifer no se registra en los catálogos consultados. La primera persona en pronunciarse acerca de la atribución de esta pieza fue Sánchez Arjona[[ (SA, 26)]], quien, como hipótesis, propuso que podría identificarse con la Farsa militar de Diego Sánchez Badajoz (caso en el cual, el otro auto que se representó en el Corpus hispalense de 1561, El rey Nabucodonosor y el horno, sería la Farsa moral del mismo dramaturgo). Jean Sentaurens[[ (Se, 166-167)]] comenta la teoría de Arjona y afirma que no hay documentación que la sostenga; al contrario, cree que es probable que los dos autos representados en 1561 provinieran de la pluma de Juan de Figueroa, el responsable de la puesta en escena, pues su formación como clérigo y presbítero le permitiría también componer.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
