    {
      "@id": "https://comedia-cortesana.local/obra/CMC002504",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002504",
      "name": "Coloquio del rico avariento y el pobre Lázaro",
      "titulo": "Coloquio del rico avariento y el pobre Lázaro",
      "titulo_limpio": "Coloquio del rico avariento y el pobre Lázaro",
      "alternateName": "",
      "tipo_obra": "otro",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2999&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nVisto que desconocemos el título preciso de la obra, su búsqueda en catálogos y repertorios resulta bastante complicada. Por ahora no hemos podido dar con ninguna composición cuya temática y fecha nos permita pensar que se relaciona con la noticia que presentamos en la cronología. El autor del coloquio con toda probabilidad fue un dramaturgo jesuita aficionado. Como se puede ver en la entrada correspondiente en CATCOM, existen varias obras dramáticas tituladas El rico avariento. No creemos que ninguna de ellas tenga relación con la pieza de la que ahora tratamos y proponemos más bien que Lohmann Villena, realizando un simple calco, propuso en el índice de su obra el título Coloquio del rico avariento y el pobre Lázaro.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
