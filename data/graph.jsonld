    {
      "@id": "https://comedia-cortesana.local/obra/CMC004789",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004789",
      "name": "El laurel de Apolo (1625)",
      "titulo": "El laurel de Apolo",
      "titulo_limpio": "El laurel de Apolo (1625)",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3012&mode=indice&letter=l",
      "notas": "",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ningún auto titulado El laurel de Apolo en los catálogos clásicos que manejamos ni nos consta la existencia de testimonios de la obra que nos ocupa. Tampoco Alenda y Mira hace referencia alguna a esta pieza religiosa. Existe un auto posterior de Juan Salvo y Vela, de mismo título, y que fue representado en el corral de Valladolid los días 24, 25 y 26 de julio de 1704, por la compañía de Manuel de Villaflo[[ (AC, 334-36)]], auto que no puede ser el que nos ocupa por cuestión de cronología. Hay que advertir que existe otra obra con este mismo título escrita por Calderón de la Barca, que es distinta de la que nos ocupa. Para más detalles, véase entrada correspondiente en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
