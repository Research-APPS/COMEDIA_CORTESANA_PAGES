        "schema:CreativeWork"
      ],
      "identifier": "CMC003720",
      "name": "La penitencia de la Magdalena",
      "titulo": "La penitencia de la Magdalena",
      "titulo_limpio": "La penitencia de la Magdalena",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1519&mode=indice&letter=p",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEs difícil identificar con seguridad este auto titulado La penitencia de la Magdalena con alguno de los autos conocidos que tratan sobre el personaje bíblico de María Magdalena. Por la fecha de la noticia de representación, el auto de La penitencia de la Magdalena podría estar relacionado con el Auto de la conversión de la Magdalena que figura en el Códice de Autos Viejos[[ (PM, 100)]], aunque no es posible determinar que sean la misma obra. Véase también el registro correspondiente en CATCOM a un auto titulado La Magdalena y representado por Jerónimo Velázquez en 1585 y 1586, el cual ha sido relacionado con el auto que nos ocupa por Agustín de la Granja (Gr9, 202-04). Sin embargo, la distancia cronológica que existe entre este auto y la obra que nos ocupa nos hace pensar que se trata de dos autos diferentes.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
