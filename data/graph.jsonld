      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "",
      "notas": "",
      "notas_bibliograficas": "Comedia de Calderón, impresa en Escogidas VIII (Madrid, 1657), fols. 66 v. - 89 v. Según Hesse, PQ, XXVII (1948), 44, esta es la edición príncipe. Véase también Dicha y desdicha no es más que imaginación.",
      "observaciones": "",
      "edicion_principe": "Escogidas VIII (Madrid",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
