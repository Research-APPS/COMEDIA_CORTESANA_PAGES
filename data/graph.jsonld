      "identifier": "CMC003030",
      "name": "El marqués de Santa Cruz",
      "titulo": "El marqués de Santa Cruz",
      "titulo_limpio": "El marqués de Santa Cruz",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
