      ],
      "identifier": "CMC002799",
      "name": "El ataúd para el vivo y tálamo para el muerto",
      "titulo": "El ataúd para el vivo y tálamo para el muerto",
      "titulo_limpio": "El ataúd para el vivo y tálamo para el muerto",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1834&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl ataúd para el vivo y tálamo para el muerto es una comedia de Andrés de Claramonte, tal y como recogen varios catálogos clásicos[[ (Art, 35r; MeR, xxvi; BL, 529)]] y el más reciente de Urzáiz[[ (UT, I, 255)]]. Arteaga ofrece como variante de título Tálamo para el muerto[[ (Art, 364r)]], mientras que La Barrera presenta el título como El ataúd para el vivo y el tálamo para el muerto[[ (BL, 529)]]. Se conservan dos copias manuscritas de esta obra en la BNE, ambas con el título El ataúd para el vivo y tálamo para el muerto: la primera, con la signatura Ms. 15.368 y atribución a Andrés de Claramonte, es una copia del siglo XVIII de un manuscrito del siglo XVII; la segunda copia, con la signatura Ms. 16.069, es de finales del siglo XVII o de principios del siglo XVIII. En este segundo manuscrito figura atribuida la obra a Claramonte y, sobre su nombre, otra atribución de una segunda mano a Antonio Valladares, y de otra tercera mano se añade “No es mía”, junto a una rúbrica[[ (Manos; PM, 37)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
