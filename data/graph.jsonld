      "identifier": "CMC002836",
      "name": "El capitán Chinchilla",
      "titulo": "El capitán Chinchilla",
      "titulo_limpio": "El capitán Chinchilla",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
