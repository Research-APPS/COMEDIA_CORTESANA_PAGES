      "identifier": "CMC003707",
      "name": "La noche de San Juan, y Juan Rana en el Prado con escribano y alguacil",
      "titulo": "La noche de San Juan, y Juan Rana en el Prado con escribano y alguacil",
      "titulo_limpio": "La noche de San Juan, y Juan Rana en el Prado con escribano y alguacil",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
