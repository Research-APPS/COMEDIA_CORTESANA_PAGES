      "identifier": "CMC003254",
      "name": "El valiente Pedro Lobón",
      "titulo": "El valiente Pedro Lobón",
      "titulo_limpio": "El valiente Pedro Lobón",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
