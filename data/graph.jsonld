        "schema:CreativeWork"
      ],
      "identifier": "CMC003596",
      "name": "La fregona del Brasil",
      "titulo": "La fregona del Brasil",
      "titulo_limpio": "La fregona del Brasil",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1117&mode=indice&letter=f",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa fregona del Brasil no aparece atribuida a nadie en la noticia de representación de la que hemos dado cuenta, no figura en ninguno de los catálogos clásicos que hemos manejado ni nos consta la existencia de testimonio de esta obra. Hay que tener en cuenta que Tomás Fernández también representó en las mismas fechas que el título que nos ocupa otra obra titulada La conquista del Brasil, que aparentemente es distinta de la comedia que nos ocupa, aunque no podamos descartar que estén relacionadas: véase el registro correspondiente. Lope de Vega escribió por estos mismos años una comedia sobre la conquista de Brasil conocida como El Brasil restituido o El Brasil, aunque parece que se trata de una obra distinta a la que nos ocupa. Con el título de La fregona existen también tres entremeses que no deben confundirse con esta comedia, uno citado por La Barrera, otro, obra de Matos Fragoso y un tercero de Cáncer[[ (UT, 86, 217, 433)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000110"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000110"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
