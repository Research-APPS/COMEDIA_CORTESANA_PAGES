      ],
      "identifier": "CMC004381",
      "name": "Sólo en Dios la confianza",
      "titulo": "Sólo en Dios la confianza",
      "titulo_limpio": "Sólo en Dios la confianza",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=634&mode=indice&letter=s",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSólo en Dios la confianza no plantea problemas de atribución de la autoría a Pedro Rosete, como recogen los catálogos clásicos que hemos manejado, así como el más reciente de Urzáiz[[ (BL, 584; Art, 360r; Sal, 651; MeR, XLVIII; GaH, 177; MC, 108; Faj, 49r; UT, II, 579)]]. A nombre del citado dramaturgo fue publicada en la Parte 16 de la colección de Comedias Escogidas (Madrid, Melchor Sánchez, 1662)[[ (CM15, 452)]]. Además, en la BNE, se conservan dos copias manuscritas de la misma, una con signatura ms. 14.904, fechada en 1689, y otra del siglo XVII, con signatura ms. 16.411, que también se atribuyen a Pedro Rosete Niño[[ (PM, 519, nº 3432)]]. En el Archivo de la Cofradía de la Novena se conserva la música[[ (F, IX, 221)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
