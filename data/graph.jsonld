      "identifier": "CMC004419",
      "name": "Triunfo de la limosna",
      "titulo": "Triunfo de la limosna",
      "titulo_limpio": "Triunfo de la limosna",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
