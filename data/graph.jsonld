      "identifier": "CMC004027",
      "name": "Los celos de Rodamonte",
      "titulo": "Los celos de Rodamonte",
      "titulo_limpio": "Los celos de Rodamonte",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
