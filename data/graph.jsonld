      "identifier": "CMC003450",
      "name": "La Santa Juana (primera parte)",
      "titulo": "La Santa Juana (primera parte)",
      "titulo_limpio": "La Santa Juana (primera parte)",
      "alternateName": "",
      "tipo_obra": "comedia",
