      "identifier": "CMC003905",
      "name": "Las lágrimas de San Pedro",
      "titulo": "Las lágrimas de San Pedro",
      "titulo_limpio": "Las lágrimas de San Pedro",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
