    {
      "@id": "https://comedia-cortesana.local/obra/CMC003423",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003423",
      "name": "La Judith española",
      "titulo": "La Judith española",
      "titulo_limpio": "La Judith española",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2561&mode=indice&letter=j",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ninguna comedia titulada La Judith española en la mayoría de los catálogos clásicos que hemos manejado; sólo La Barrera cita el título que nos ocupa sin atribución ninguna[[ (BL, 557)]]. Por su parte, Urzáiz cita la comedia La Judith española como una comedia anónima[[ (UT, I, 92)]]; lo mismo hacen Varey y Shergold, al dar cuenta de la noticia de representación que hemos registrado en el calendario[[ (F, IX, 139)]]. No nos consta la existencia de testimonios conservados de la obra que nos ocupa, aunque por su título podría centrarse en algún personaje histórico. No parece probable que guardara relación con otras obras que se centrarían en la figura bíblica de Judith, como el drama sacro titulado Judith que cita Arteaga[[ (Art, 199v)]] o la tragedia titulada Judith, cuyo manuscrito, con letra del XVIII, se encuentra en la BNE con signatura ms. 17.727[[ (PM, 274)]]. Tampoco creemos que la comedia que nos ocupa tuviera relación con la obra titulada Judit o Sitio de Bethulia, compuesta por “un ingenio” a la que se refiere Mesonero Romanos[[ (MeR, XXXVII)]]. Por otra parte, no se tiene que confundir el título que nos ocupa con la obra titulada La Judith castellana, compuesta en el siglo XVIII por Luciano Francisco Comella[[ (Art, 199v; Sal, 613)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
