      ],
      "identifier": "CMC004040",
      "name": "Los desposorios de Cristo con la naturaleza humana",
      "titulo": "Los desposorios de Cristo con la naturaleza humana",
      "titulo_limpio": "Los desposorios de Cristo con la naturaleza humana",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2315&mode=indice&letter=d",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLos desposorios de Cristo con la naturaleza humana es un auto sacramental cuya letra dio Pedro de Montiel, según se indica en la noticia de representación[[ (SA, 55)]]. No sabemos si esto significa que era el dramaturgo autor de la obra o solamente el poseedor del texto. Los desposorios de Cristo con la naturaleza humana no figura en los catálogos clásicos que manejamos ni nos consta la existencia de testimonios de la obra que nos ocupa.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
