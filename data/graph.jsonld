    {
      "@id": "https://comedia-cortesana.local/obra/CMC003491",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003491",
      "name": "La blanca de la carne",
      "titulo": "La blanca de la carne",
      "titulo_limpio": "La blanca de la carne",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1998&mode=indice&letter=b",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSegún la documentación de Sevilla de la que hemos dado cuenta, Juan Suárez de Águila sería el autor de este auto sacramental. No obstante, este título no se menciona en ninguno de los catálogos clásicos que manejamos ni nos consta la existencia de testimonios de la obra que nos ocupa. Hay que advertir que existe otro auto sacramental con un título similar, La blanca, representado por Gaspar de Porres en 1596, que no podemos asegurar que se trate del mismo que nos ocupa. Para más información, véase la entrada correspondiente en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
