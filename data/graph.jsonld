      "identifier": "CMC003117",
      "name": "El premio del bien hablar",
      "titulo": "El premio del bien hablar",
      "titulo_limpio": "El premio del bien hablar",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
