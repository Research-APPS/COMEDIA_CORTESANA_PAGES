      "identifier": "CMC003550",
      "name": "La descendencia de los reyes de Francia",
      "titulo": "La descendencia de los reyes de Francia",
      "titulo_limpio": "La descendencia de los reyes de Francia",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
