    {
      "@id": "https://comedia-cortesana.local/obra/CMC003177",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003177",
      "name": "El rey don Jaime de Aragón",
      "titulo": "El rey don Jaime de Aragón",
      "titulo_limpio": "El rey don Jaime de Aragón",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2142&mode=indice&letter=r",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nComo puede comprobarse en las noticias de representación que recogemos en el calendario, en cada uno de los documentos se atribuye la comedia a un dramaturgo diferente. Por experiencia sabemos que el inventario fechado en 1628 suele contener atribuciones erróneas, y las contenidas en el de 1620 suelen ser certeras. Sin embargo no podemos asegurar que la comedia sea obra de Andrés de Claramonte y no de Cristóbal Ortiz, pues los catálogos clásicos consultados no aportan ninguna información, en tanto que no mencionan este título o, cuando lo hacen, no incluyen el autor. Es el caso de La Barrera y Arteaga, que citan los siguientes títulos: Rey de Aragón y Conde de Barcelona: don Jaime el Conquistador[[ (BL, 558)]] y Don Jaime el Conquistador, relacionada según Arteaga con Rey de Aragón y Conde Barcelona[[ (Art, 112v)]]. No podemos asegurar que se trate del título que nos ocupa. Por lo que respecta a la tradición textual de esta obra, no hemos encontrado testimonio alguno que se corresponda con este título.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
