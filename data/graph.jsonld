      "identifier": "CMC003036",
      "name": "El mayor encanto, amor",
      "titulo": "El mayor encanto, amor",
      "titulo_limpio": "El mayor encanto, amor",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
