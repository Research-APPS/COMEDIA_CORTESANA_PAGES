        "schema:CreativeWork"
      ],
      "identifier": "CMC004096",
      "name": "Los trabajos de Cristo",
      "titulo": "Los trabajos de Cristo",
      "titulo_limpio": "Los trabajos de Cristo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2660&mode=indice&letter=t",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia Los trabajos de Cristo no aparece mencionada en ninguno de los catálogos que manejamos, con la excepción del catálogo de Urzáiz, que la recoge como anónima[[ (UT, I, 127)]]. No nos consta la existencia de testimonios de esta obra.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
