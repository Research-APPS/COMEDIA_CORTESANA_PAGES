    {
      "@id": "https://comedia-cortesana.local/obra/CMC004133",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004133",
      "name": "Merlín",
      "titulo": "Merlín",
      "titulo_limpio": "Merlín",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3024&mode=indice&letter=m",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ninguna comedia titulada tan solo Merlín en los catálogos que manejamos. La comedia representada en 1629 no pudo ser Los encantos de Merlín o El embuste acreditado y disparate creído atribuida a Luis Vélez de Guevara, que es una comedia de enredo, cuyo protagonismo recae en un personaje llamado Merlín, que es quien provoca el enredo, pues los gastos de la representación en palacio de 1629, con puesta en escena de Cosme Lotti, apuntan a que la obra representada fue una comedia de tramoya. Según Peale, en la cuentas se menciona el material para la confección de un dragón o serpiente, algo que la comedia atribuida a Vélez, no exige. El disparate creído se atribuye también en algunos testimonios a Juan de Zabaleta: véase sobre esta cuestión Profeti[[(1980)]]. Hay que advertir que existe una obra perdida de Rey de Artieda titulada Los encantos de Merlín, que es anterior a la que abordamos en este registro.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
