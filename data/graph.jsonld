    {
      "@id": "https://comedia-cortesana.local/obra/CMC003492",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003492",
      "name": "La boca y no el corazón",
      "titulo": "La boca y no el corazón",
      "titulo_limpio": "La boca y no el corazón",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=536&mode=indice&letter=b",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSe conserva una copia manuscrita de La boca y no el corazón en la Biblioteca Vaticana, fondo Barberini Latini nº 3488, con atribución en la portada a Gaspar de Ávila, localizada y descrita por Falconieri. Sin embargo, cuando María del Carmen Hernández Valcárcel resumió las obras conocidas del dramaturgo murciano, no incluyó esta pieza, probablemente por no haber visto la noticia de Falconieri. Por otra parte, Falconieri afirmó que la obra del vaticano es idéntica a la que se conserva sin atribución en el Ms. 17.379 de la BNE, bajo el título Fingir por conservar. Nuestra comparación de los primeros y últimos versos de esta con la edición de Falconieri del manuscrito vaticano avala este juicio, si bien la edición no incluye un cotejo completo. La noticia de Falconieri corrige las catalogaciones anteriores, en las que ambos títulos se habían mencionado sin indicaciones de autoría. Así, Mesonero Romanos y La Barrera habían catalogado La boca y no el corazón con Fingir por conservar como título secundario, catalogación que ha seguido Urzáiz. Arteaga, al contrario, anota Fingir por conservar como el título principal, dando La boca y no el corazón como título secundario. Otros dieron noticia de La boca y no el corazón sin mencionar un título secundario, como Medel o García la Huerta. Paz y Melia, al catalogar la versión manuscrita de Fingir por conservar de la BNE, dio como título alternativo La boca y no el corazón y afirmó, remitiendo a Durán, que se imprimió una versión bajo este último título. Sin embargo, no hemos podido localizar noticias de una versión impresa en los catálogos que manejamos de sueltas y colecciones.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
      "tiene_representacion": [
        {
          "@id": "https://comedia-cortesana.local/representacion/REP002419"
        }
      ]
