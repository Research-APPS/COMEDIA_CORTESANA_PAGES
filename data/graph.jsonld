    {
      "@id": "https://comedia-cortesana.local/obra/CMC004044",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004044",
      "name": "Los desposorios de Nuestra Señora",
      "titulo": "Los desposorios de Nuestra Señora",
      "titulo_limpio": "Los desposorios de Nuestra Señora",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1481&mode=indice&letter=d",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nRecogemos en este registros dos noticias de representación relacionadas con el mismo título para un auto sacramental, Los desposorios de Nuestra Señora, aunque no podemos asegurar que las dos noticias se refieran a la misma obra. Un auto titulado Los desposorios de Nuestra Señora aparece recogido en los catálogos de García de la Huerta, Medel del Castillo, Arteaga, Mesonero Romanos y La Barrera[[ (GaH, 205; MC, 127; Art, 416r; MeR, XXX; BL, 595)]], pero no sabemos si se trata de la obra que nos ocupa. Por otro lado, Sánchez Arjona creyó que el auto representado en la fiesta del Corpus de Sevilla de 1612 podría ser el titulado Los desposorios de la Virgen, de Juan Caxesi[[ (SA, 152-3, 158)]]. Sin embargo, no podemos confirmar ni desmentir esta identificación, pues hay otro auto sacramental de igual temática, titulado Los desposorios de San José y la Virgen María y representado en Valencia en 1616, que también podría corresponder con el de Juan Caxesi: véanse los registros correspondientes en CATCOM. Urzáiz recoge también otro auto titulado Los desposorios de la Virgen y nacimiento de Cristo y atribuido a Juan Esteban[[ (UT, I, 307)]], del que se conserva un manuscrito en la BNE bajo la signatura Ms. 17.240[[ (PM, 150)]], aunque pensamos que no tiene nada que ver con el que nos ocupa.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
