        "schema:CreativeWork"
      ],
      "identifier": "CMC002893",
      "name": "El desengaño en celos",
      "titulo": "El desengaño en celos",
      "titulo_limpio": "El desengaño en celos",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=515&mode=indice&letter=d",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl desengaño en celos es una comedia de autoría dudosa, cuyo título no se menciona en ninguno de los catálogos clásicos que manejamos. En el inventario de 1628 la comedia se atribuye a Mira de Amescua, pero este inventario presenta numerosos problemas de atribución. Valladares Reguero incluye este título entre las comedias dudosamente atribuidas a Mira[[ (VR, 168)]]. Rennert y Cotarelo apuntan a que podría tratarse de El desengaño de celos, de Jacinto Cordero[[ (R1, 337; CM1, 431)]], título y atribución sí que que figuran recogidos en varios catálogos[[ (MC, 31; GaH, 54; BL, 541; Art, 100r; MeR, XXX)]], y del que Héctor Urzáiz menciona una edición suelta sin datos bibliográficos[[ (UT, I, 256)]]. A falta de más información, no es posible determinar con seguridad la autoría de la comedia que nos ocupa.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
