      "identifier": "CMC002801",
      "name": "El ayo",
      "titulo": "El ayo",
      "titulo_limpio": "El ayo",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=605&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl entremés El ayo es una obra de Agustín Moreto, como recoge La Barrera[[ (BL, 281, 710)]]. Se publicó en el volumen titulado Autos sacramentales y al nacimiento de Cristo con sus loas y entremeses (Madrid, Antonio Francisco de Zafra, 1675). Una copia manuscrita de esta edición se conserva en la Biblioteca del Instituto del Teatro de Barcelona bajo la signatura ms. 47.049[[ (Moreto, Loas, entremeses..., pp. 600-613)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
