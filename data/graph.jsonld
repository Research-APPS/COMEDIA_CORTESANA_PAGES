        "schema:CreativeWork"
      ],
      "identifier": "CMC003248",
      "name": "El triunfo de Judith",
      "titulo": "El triunfo de Judith",
      "titulo_limpio": "El triunfo de Judith",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=588&mode=indice&letter=t",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo parece que existan dudas sobre la autoría de la comedia titulada El triunfo de Judith y muerte de Holofernes, pues tanto los catálogos clásicos como el más reciente de Urzáiz[[ (UT, II, 710; BL, 473; Art, 380r; MeR, L; GaH, 186; MC, 115; F, IX, 232)]] coinciden en su atribución a Vera Tassis. La comedia circuló suelta a nombre de Vera Tassis y Villarroel[[ (MPR, 126, nº666; BS, 230, nº1147)]]. En la BNE, se conservan dos copias manuscritas del siglo XVIII de esta comedia: una con el título El triunfo de Judit con signatura Ms. 17.110 y otra titulada La valerosa Judith y cerco de Betulia por el soberbio Holofernes con signatura Ms. 16.381[[ (PM, 555, nº3682)]]. Shergold y Varey informan de la existencia de dos copias manuscritas de la comedia conservadas en la Biblioteca Histórica Municipal de Madrid. Efectivamente, el catálogo de la Biblioteca Histórica Municipal de Madrid permite documentar la existencia de tres copias manuscritas de la comedia: Comedia del triunfo de Judit, con signatura Tea 1-149-15, F; Comedia del triunfo de Judith, con signatura Tea 1-149-15, E; y El Triumpho de Judith, con signatura Tea 1-149-15, D. En el Archivo de la Cofradía de la Novena se conserva música para esta comedia.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
