      "identifier": "CMC004778",
      "name": "La fingida Arcadia (Comedia)",
      "titulo": "La fingida Arcadia",
      "titulo_limpio": "La fingida Arcadia (Comedia)",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
