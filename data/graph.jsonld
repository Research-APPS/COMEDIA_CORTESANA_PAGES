    {
      "@id": "https://comedia-cortesana.local/obra/CMC003299",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003299",
      "name": "Estados mudan costumbres",
      "titulo": "Estados mudan costumbres",
      "titulo_limpio": "Estados mudan costumbres",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "comedia",
      "estado_ficha": "cruda",
      "fuente_principal": "AMBAS",
      "pagina_pdf": 112,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1201&mode=indice&letter=e",
      "notas": "",
      "notas_bibliograficas": "Comedia de Matos Fragoso, impresa en Escogidas V (Madrid, 1654), 80-127.",
      "observaciones": "Atribución (CATCOM):\nEstados mudan costumbres es una comedia de Juan de Matos Fragoso, tal y como recoge la mayoría de catálogos clásicos que manejamos[[ (UT, II, 428; BL, 241, 711; Art, 141r, 501v; Sal, 401, 417, 600; MeR, XXXIII; GaH, 70; MC, 41; Faj, 21v)]] y también en algún catálogo más reciente[[ (F, IX, 113-14)]] Arteaga da como título alternativo de Estados mudan costumbres el de Marido hace mujer[[ (Art, 141r, 501v)]]. Estados mudan costumbres se publicó a nombre de Juan de Matos Fragoso en la Parte 5 de la colección de Comedias Escogidas (Madrid, Pablo de Val, 1653)[[ (BL, 241; Sal, 401, 600; CM15, 258-59)]] y posteriormente en el volumen Comedias de los mejores y más insignes ingenios de España (Colonia Agripina, Manuel Tejera, 1697)[[ (BL, 241, 711; Sal, 417)]]. Por otro lado, Mesonero Romano atribuye la obra Estados mudan costumbres a Antonio Hurtado de Mendoza[[ (MeR, XXXIII)]], pero se trata de una confusión con la obra Marido hace mujer o El trato muda costumbres, que sí que es de dicho dramaturgo[[ (Art, 225v, BL, 250, 456; Sal, 454, 618, 655; MeR, XXXVIII, XLIX; GaH, 107, 183; MC, 66, 114; Moll, 98; MPR, 124; VE, 93; Pr, 78, 89, 95; CM15, 207, 212, 240)]]. Tampoco debe confundirse Estados mudan costumbres con la obra de Villaizán conocida con los títulos de Marido hace mujer o Transformaciones del amor[[ (Art, 225v; MeR, XXXVIII; GaH, 183; MC, 114; R2, 54; PM, 542; BS, 275; Pr, 128)]]. Por último, La Barrera y Paz y Melia mencionan un sainete titulado Estados mudan costumbres, que nada tiene que ver con la comedia que nos ocupa[[ (BL, 660; PM, 322)]].",
      "edicion_principe": "Escogidas V (Madrid",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000110"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000110"
      },
