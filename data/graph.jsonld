    {
      "@id": "https://comedia-cortesana.local/obra/CMC003901",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003901",
      "name": "Las hijas del Cid",
      "titulo": "Las hijas del Cid",
      "titulo_limpio": "Las hijas del Cid",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1193&mode=indice&letter=h",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSánchez Arjona, al dar cuenta de la noticia de representación de 1637 del entremés y baile de Las hijas del Cid, consideró esta pieza breve anónima. Efectivamente, este título no figura en los catálogos clásicos que hemos manejado ni nos consta la existencia de testimonios de esta pieza. Tan sólo lo recoge el catálogo de Urzáiz, a partir de la noticia proporcionada por Sánchez Arjona. Tenemos en CATCOM noticias de representación de obras relacionadas con la figura del Cid, pero al no tratarse de piezas breves, como la que nos ocupa, no se pueden identificar con ésta.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
      "tiene_representacion": [
        {
          "@id": "https://comedia-cortesana.local/representacion/REP003098"
        }
      ]
    },
