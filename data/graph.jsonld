      "name": "Triunfo de la paz y el tiempo, El",
      "titulo": "El Triunfo de la paz y el tiempo",
      "titulo_limpio": "Triunfo de la paz y el tiempo, El",
      "alternateName": "",
      "tipo_obra": "zarzuela",
      "genre": "comedia",
      "estado_ficha": "cruda",
