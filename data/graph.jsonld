      }
    },
    {
      "@id": "https://comedia-cortesana.local/obra/CMC004812",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004812",
      "name": "San Diego (1611)",
      "titulo": "San Diego",
      "titulo_limpio": "San Diego (1611)",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=768&mode=indice&letter=s",
      "notas": "",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa noticia de representación de una comedia titulada San Diego no ofrece ninguna indicación acerca de su autor y no figura en ninguno de los catálogos manejados. Tampoco nos consta la existencia de testimonios. La obra que nos ocupa no debe confundirse con las comedias sobre San Diego de Alcalá compuestas años más tarde por Lope de Vega y por Juan Francisco Manuel. Hay que advertir que existe una comedia anónima titulada Vida y muerte de Fray Diego que también aborda la vida del santo. Esta comedia, que se conserva en un manuscrito en la BNE, signatura Ms. 14767, ff. 78r-91v[[ (PM, 85-86)]] forma parte de la colección teatral de Diego Sarmiento de Acuña, conde de Gondomar, colección que fue descubierta y catalogada por Stefano Arata. Según el investigador italiano, la fecha de la reunión de la colección es 1595-1597[[ (Ar1, 14)]]. Por lo tanto, podría ser la obra representada, pero no es posible confirmarlo.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
