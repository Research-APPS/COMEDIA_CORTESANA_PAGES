      "identifier": "CMC002878",
      "name": "El corregidor de Illescas",
      "titulo": "El corregidor de Illescas",
      "titulo_limpio": "El corregidor de Illescas",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
