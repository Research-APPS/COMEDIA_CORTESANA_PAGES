      "identifier": "CMC003586",
      "name": "La fiesta del Ángel",
      "titulo": "La fiesta del Ángel",
      "titulo_limpio": "La fiesta del Ángel",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
