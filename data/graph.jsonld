    {
      "@id": "https://comedia-cortesana.local/obra/CMC003935",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003935",
      "name": "Las tres mosqueteras",
      "titulo": "Las tres mosqueteras",
      "titulo_limpio": "Las tres mosqueteras",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=464&mode=indice&letter=t",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEn la escritura de contrato otorgada en Málaga el 20 de julio de 1627 por Manuel Simón, se cita, según Llorden, Las tres mosqueteras, “nuevas, la una de Luis Vélez, la otra de Gaspar de Ávila y la tercera de Lope”, como ya hemos indicado en el calendario de representaciones. La transcripción del documento que hace Llorden resulta confusa y es posible que contenga errores de transcripción. Parece poco probable que se trate de tres comedias nuevas, una de cada autor, coincidentes en el título, por lo que es más plausible pensar que se hace referencia a una obra titulada Las tres mosqueteras, supuestamente nueva, según se declara, y en la que cada jornada habría sido compuesta por un dramaturgo. Si esta obra realmente fue escrita en colaboración lo desconocemos, pues no se conserva testimonio de ella. No figura en ninguna de las fuentes bibliográficas que manejamos.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
