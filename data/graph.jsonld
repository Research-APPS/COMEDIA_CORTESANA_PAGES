      "identifier": "CMC003725",
      "name": "La poncella de Francia",
      "titulo": "La poncella de Francia",
      "titulo_limpio": "La poncella de Francia",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
