      "identifier": "CMC003164",
      "name": "El reto de Zamora",
      "titulo": "El reto de Zamora",
      "titulo_limpio": "El reto de Zamora",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=187&mode=indice&letter=r",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia titulada El reto de Zamora, citada por San Román como anónima [[(SR, LXXXII)]], a juicio de Urzáiz debe ser la misma que la Comedia de la muerte del rey don Sancho y reto de Zamora por don Diego Ordóñez, de Juan de la Cueva[[ (UT, I, 281)]]. Sin embargo, la distancia cronológica entre la fecha de estreno de la comedia de Cueva en 1579 y la noticia de 1615 nos lleva a no poder considerar como segura la identificación propuesta por Urzáiz. El título de El reto de Zamora no figura en ninguno de los catálogos clásicos que hemos manejado y no nos consta la existencia de testimonios de esta obra.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
