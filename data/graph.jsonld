    {
      "@id": "https://comedia-cortesana.local/obra/CMC004393",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004393",
      "name": "Tetis y Peleo",
      "titulo": "Tetis y Peleo",
      "titulo_limpio": "Tetis y Peleo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2597&mode=indice&letter=t",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nExisten dos comedias diferentes con el título Tetis y Peleo: una de José de Bolea y otra de Agustín de Salazar y Torres; así lo recogen los catálogos consultados excepto García de la Huerta y Medel que sólo traen la atribuida a Salazar[[ (UT, I, 170; II, 592; BL, 42, 361, 697; Art, 369r; F, IX, 225; MeR, XLIX; GaH, 180; Faj, 50r; MC, 112; Sal, 408, 500)]]. La comedia de José de Bolea se imprimió en la Parte 29 de Comedias escogidas (Madrid, José Fernández de Buendía, 1668) atribuida al autor y con la indicación “fiesta que se hizo a las bodas de la Serenissima Señora doña María Teresa de Austria, Reyna de Francia”[[ (CM15, 628)]], en alusión a las bodas entre Luis XIV de Francia y María Teresa de Austria que tuvieron lugar en 1660. De esta obra se conserva un manuscrito del XVII con atribución a José de Bolea en la Biblioteca Histórica Municipal de Madrid, signatura Tea 1-67-1. Por su parte, la comedia de Agustín de Salazar Tetis y Peleo se imprimió en la Parte 2 de su Citara de Apolo (Madrid, Francisco Sanz, 1681). Se conserva una copia manuscrita atribuida a Agustín de Salazar en la Bibliothèque de l’Arsenal de París, signatura Ms. 8326. Asimismo, en la BNE, se conserva el encabezamiento de una copia de esta comedia realizada en 1688, Ms. 16.728. Según la hipótesis de Thomas Austin O’Connor[[ (2006: 61)]], la comedia de Salazar se estrenaría el 22 de diciembre de en 1671 con motivo del cumpleaños de Mariana de Austria, aunque no hay noticia documental que nos permita afirmarlo con certeza. En relación con las noticias que figuran en el calendario, podemos decir que, por las fechas, podría tratarse de cualquiera de estas dos comedias, aunque nos inclinaríamos a pensar que se trata de la obra de Salazar y Torres por ser más cercana su composición a las fechas de representación que hemos constatado.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
