        "schema:CreativeWork"
      ],
      "identifier": "CMC004171",
      "name": "Navalcarmelo",
      "titulo": "Navalcarmelo",
      "titulo_limpio": "Navalcarmelo",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=107&mode=indice&letter=n",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo conservamos el texto de un auto con este título. Sin embargo, Sánchez Arjona supuso, sin pruebas, que el auto de Navalcarmelo podría ser el mismo que el contenido en el Códice de Autos Viejos con el título Naval, Abigail y David [[(SA, 10-11)]]. Este auto el códice es citado simplemente por el título de Naval y Abigail en catálogos como el Paz y Melia y Alenda y Mira[[(PM, 375; AM1, 765)]]. Por otro lado, hay que señalar que tenemos noticia de otro auto sacramental de título parecido, David y Navalcarmelo, que se representó en 1593, aunque no parece que haya una relación directa entre ambas obras. Véase el registro correspondiente de CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
