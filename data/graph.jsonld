      ],
      "identifier": "CMC004162",
      "name": "Más vale fingir que amar",
      "titulo": "Más vale fingir que amar",
      "titulo_limpio": "Más vale fingir que amar",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2125&mode=indice&letter=m",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nMás vale fingir que amar es una comedia de Antonio Mira de Amescua que se conoce sobre todo con el título de Examinarse de rey, como ya señaló Rennert[[ (R2, 46)]]. Algunos catálogos clásicos la citan como Examinarse de rey, o más vale fingir que amar[[ (BL, UT, PM, Fa1, CM14, VR)]], mientras que otros la mencionan por el título de Más vale fingir que amar o incluso como Examinarse a ser rey[[ (Faj, MC, GaH, MeR, Art)]]. Todos atribuyen la obra a Mira de Amescua (Faj, 34v; MC, 67; GaH, 110; MeR, XXXIX; Art, 223v; BL, 258, 260, 548; UT, II, 446, 448). Se conservan dos copias manuscritas del siglo XVII: una, con el título Examinarse de rey y atribución a Mira, se conserva en la BNE bajo la signatura Ms. 14953, mientras que la segunda, con el título de Más vale fingir que amar, se conserva en la Biblioteca Apostólica Vaticana bajo la signatura Barberini Latini 3483[[ (Fa1, 21)]]. Se conserva asimismo un fragmento manuscrito de la comedia en la Hispanic Society of America bajo la signatura B2336. Se conservan asimismo tres ediciones sueltas, sin datos bibliográficos[[ (VR, 73-74]]).",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
