      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2184&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEn la BNE (ms. 16834) se conserva un manuscrito de la comedia titulada El conde de Fuentes, atribuida a Luis de Belmonte y Bermúdez. Paz y Melia se preguntaba si podía tratarse de El conde de Fuentes en Lisboa[[(PM, 115)]]. Aunque esta atribución fue cuestionada por Cotarelo, tanto Rennert como Urzáiz identifican ambos títulos[[(UT, I, 161)]][[(R1, 336; CM1, 437)]]. No obstante, en ningún repertorio de los que manejamos aparece mencionada El conde de Fuentes, mientras que El conde de Fuentes en Lisboa figura a nombre de Belmonte en muchos catálogos[[(BL, 537; Art, 76v; MeR, XXIX; GaH, 43; MC, 24; Faj, 13r)]]. De hecho, en ningún repertorio antiguo de los que manejamos aparece mencionado el título El conde de Fuentes, mientras que El conde de Fuentes en Lisboa se incluye a nombre de Belmonte en la mayoría de los catálogos[[(BL, 537; Art, 76v; MeR, XXIX; GaH, 43; MC, 24; Faj, 13r)]]. Por todo lo dicho y porque en los últimos versos de El conde de Fuentes en Lisboa se nombra la obra como El conde de Fuentes, pensamos que la representación de la que damos cuenta en el calendario se corresponde con la obra de Luis de Belmonte Bermúdez.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
