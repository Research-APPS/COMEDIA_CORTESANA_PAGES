      "identifier": "CMC004056",
      "name": "Los dos prodigios de Roma",
      "titulo": "Los dos prodigios de Roma",
      "titulo_limpio": "Los dos prodigios de Roma",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
