    {
      "@id": "https://comedia-cortesana.local/obra/CMC003902",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003902",
      "name": "Las honras de Lope de Vega",
      "titulo": "Las honras de Lope de Vega",
      "titulo_limpio": "Las honras de Lope de Vega",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=582&mode=indice&letter=h",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLos catálogos consultados no recogen el título Las honras de Lope de Vega. Sánchez Arjona[[ (SA, 308-313)]] sugiere que podría tratarse de la comedia Honras a Lope de Vega en el Parnaso, publicada como anónima en Fama póstuma (1636) de Juan Pérez de Montalbán, pero que pertenece a Gabriel de Moncada[[ (Álvarez y Baena, Hijos de Madrid..., III, p. 362)]], como recogen La Barrera Salvá o más recientemente Urzáiz[[ (UT, II, 455; BL, 263; Sal, 549, 610)]]. Con el título Honras del Parnaso a Lope de Vega Carpio, en el Carpio aparece atribuida a Montalbán en los catálogos de Arteaga y Mesonero Romanos[[ (Art, 186; MeR, XXXVI)]], quizás inducidos a ello por el hecho de que, como señalado arriba, Montalbán editó la Fama póstuma. Medel y Fajardo recogen el título, pero no lo adscriben a ningún autor[[ (MC, 54; Faj, 28)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
      "tiene_representacion": [
        {
          "@id": "https://comedia-cortesana.local/representacion/REP003099"
        }
      ]
    },
