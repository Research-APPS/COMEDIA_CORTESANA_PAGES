        "schema:CreativeWork"
      ],
      "identifier": "CMC003193",
      "name": "El saco de la gran casa de Meca",
      "titulo": "El saco de la gran casa de Meca",
      "titulo_limpio": "El saco de la gran casa de Meca",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3191&mode=indice&letter=s",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl saco de la gran casa de Meca es una comedia de Andrés González de Barcia Carballido y Zúñiga, quien también firmó sus obras con los pesudónimos de don García Aznar Vélez, don Jacomé de Cárdomas o don Ibón[[ (BL, 579; UT, 149; MANOS)]]. Se conservan dos manuscritos autógrafos de esta obra: uno en la BNE, con la signatura Ms. 14.946, que sólo contiene los actos primeros y segundo, y otro en la Biblioteca de la Hispanic Society of America, Nueva York, con la signatura HSA B1416, con fecha de 1695 y que tiene duplicada la segunda jornada[[ (MANOS; PM, 488)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
