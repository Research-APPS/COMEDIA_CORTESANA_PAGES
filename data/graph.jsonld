    {
      "@id": "https://comedia-cortesana.local/obra/CMC002783",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002783",
      "name": "El alcalde de Coria",
      "titulo": "El alcalde de Coria",
      "titulo_limpio": "El alcalde de Coria",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1714&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ninguna comedia titulada El alcalde de Coria en los catálogos clásicos que manejamos ni en el más reciente de Héctor Urzáiz. Tampoco nos consta la existencia de testimonios de la obra que nos ocupa. Como hemos dicho en el apartado de cronología, Shergold y Varey apuntan que podría haber un error en el título y llamarse en realidad El alcázar de Soria, comedia esta de la que tampoco hemos hallado testimonio alguno ni figura en ninguno de los catálogos consultados.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
