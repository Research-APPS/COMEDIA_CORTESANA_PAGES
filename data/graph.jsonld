      "identifier": "CMC003196",
      "name": "El sacro Parnaso",
      "titulo": "El sacro Parnaso",
      "titulo_limpio": "El sacro Parnaso",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
