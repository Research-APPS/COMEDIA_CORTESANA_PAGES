      "identifier": "CMC003048",
      "name": "El mejor huésped de España",
      "titulo": "El mejor huésped de España",
      "titulo_limpio": "El mejor huésped de España",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
