      "identifier": "CMC003047",
      "name": "El mejor consejo",
      "titulo": "El mejor consejo",
      "titulo_limpio": "El mejor consejo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
