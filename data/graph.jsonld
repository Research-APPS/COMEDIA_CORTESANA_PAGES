      ],
      "identifier": "CMC002959",
      "name": "El gran príncipe de Fez, don Baltasar de Loyola",
      "titulo": "El gran príncipe de Fez, don Baltasar de Loyola",
      "titulo_limpio": "El gran príncipe de Fez, don Baltasar de Loyola",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
