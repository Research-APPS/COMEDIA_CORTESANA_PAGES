        "schema:CreativeWork"
      ],
      "identifier": "CMC003831",
      "name": "La vida y muerte de San Isidro",
      "titulo": "La vida y muerte de San Isidro",
      "titulo_limpio": "La vida y muerte de San Isidro",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3138&mode=indice&letter=v",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSegún la noticia que recogemos en el calendario, ofrecida por Lohman[[ (Loh, 240)]], se trata de una comedia escrita en colaboración entre Rosete, Cáncer y \"otro ingenio\" y Urzáiz señala que se trata de la comedia San Isidro Labrador[[ (UT, 216, 578)]]. En los catálogos clásicos consultados, no se recoge ninguna comedia con este título, aunque sí en el más reciente de Urzáiz en donde se la menciona como San Isidro labrador[[ (UT, 216, 578)]]. Por este título encontramos una referencia en un Vejamen de don Jerónimo de Cáncer y Velasco, publicado en sus Obras varias (Madrid, Diego Díaz de la Carrera, 1651): “¿No es éste el que escribió la comedia de San Isidro labrador con un tal Cáncer y otro no sé quién, que tan mala comedia no se ha escrito en los infiernos? —Este mesmo es, y Cáncer soy yo; pero esta redondilla os dirá nuestra disculpa: Escribimos tres amigos / una comedia a un autor, / fue de un santo labrador, / y echamos por esos trigos.” Según González Maya, quien publicó estudió y editó este vejamen: “Es posible que no se llegara a imprimir”[[ (2006, 92)]]. Esta comedia no debe confundirse con Vida, muerte y colocación de san Isidro, escrita en colaboración por seis ingenios: Matos, Gil Enríquez, Lanini, Diamante y Francisco de Avellaneda, que presenta los títulos alternativos Colocación de san Isidro o Muerte y colocación de san Isidro. La Barrera la identifica erróneamente con la que nos ocupa[[ (BL, 536)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
