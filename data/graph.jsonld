      "identifier": "CMC004326",
      "name": "San Juan y Corpus Cristi",
      "titulo": "San Juan y Corpus Cristi",
      "titulo_limpio": "San Juan y Corpus Cristi",
      "alternateName": "",
      "tipo_obra": "auto",
