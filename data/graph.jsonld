      ],
      "identifier": "CMC003954",
      "name": "Lo cierto por lo dudoso",
      "titulo": "Lo cierto por lo dudoso",
      "titulo_limpio": "Lo cierto por lo dudoso",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2113&mode=indice&letter=l",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLo cierto por lo dudoso es una comedia de Lope de Vega, según consta en los catálogos clásicos que manejamos[[ (Art, 210r; BL, 559; Ch, 547; MeR, XXXVII; Sal, 370; UT, II, 669)]], que se publicó en la Parte XX de las comedias del dramaturgo publicada por la Viuda de A. Martín y A. Pérez en Madrid en 1625[[ (Pr, 200; Sal, 545)]]. La comedia es incluida por Morley y Bruerton entre las piezas auténticas de Lope y la fechan entre 1612-1624 (probablemente entre 1620 y 1624)[[ (MoB, 301-302)]]. En el fondo Mesonero Romanos de la Biblioteca Histórica de Madrid se conserva un manuscrito de la obra del XVIII[[ (U. Cerezo Rubio y R. González Cañal, Catálogo de Teatro. Biblioteca Histórica de Madrid. Fondo Mesonero Romanos, Madrid, Ayuntamiento de Madrid, 2009, pp. 55-56)]]. Ramírez de Arellano reescribió la comedia de Lope con el título Lo cierto por lo dudoso o La mujer firme, pieza transmitida por varias sueltas[[ (BS, 663; CG, 207; Moll, 89; MPR, 26)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
