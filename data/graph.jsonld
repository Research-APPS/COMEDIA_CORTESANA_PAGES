    {
      "@id": "https://comedia-cortesana.local/obra/CMC003071",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003071",
      "name": "El nacimiento de Pelayo",
      "titulo": "El nacimiento de Pelayo",
      "titulo_limpio": "El nacimiento de Pelayo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1336&mode=indice&letter=n",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl nacimiento de Pelayo no aparece mencionada en los catálogos clásicos que manejamos ni consta atribución alguna de la autoría. Urzáiz, que menciona la noticia de la que hemos dado cuenta arriba, cataloga la comedia entre las anónimas y apunta la posibilidad de que pudiera ser la misma que El infante don Pelayo de Diamante[[ (UT, I, 106, 287)]]. Es difícil saberlo ya que no se conserva ningún testimonio de El nacimiento de Pelayo. Sobre la figura histórica de Pelayo existen otras obras, pero es difícil saber si alguna de ellas podría identificarse con la obra que nos ocupa. Tanto Spencer y Schevill ofrecen una breve recopilación de títulos [[(SS, 142-46) ]]como Paz y Melia en su momento mencionaron algunas de ellas[[ (PM, 10, nº 72)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
