        "schema:CreativeWork"
      ],
      "identifier": "CMC004763",
      "name": "El bosque de amor (1610)",
      "titulo": "El bosque de amor",
      "titulo_limpio": "El bosque de amor (1610)",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2555&mode=indice&letter=b",
      "notas": "",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSegún Agustín de la Granja, el auto sacramental titulado El bosque de amor es obra de Lope de Vega, probablemente versión \"a lo divino\" de su comedia El bosque amoroso (Gr, 64-65, 76), que también se representó bajo el título de El bosque de amor: véase el registro correspondiente en CATCOM. Alenda y Mira lo da como anónimo[[ (AM1, 391)]]. El único testimonio conocido actualmente de este auto sacramental es una copia manuscrita conservada en la Biblioteca Municipal Menéndez Pelayo bajo la signatura Ms. 191[[ (Granja, “Estudio preliminar...”, pp. 147-150)]]. Urzáiz afirma por error que existe otra copia manuscrita en la BNE[[ (UT, II, 685; PM, 284)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
