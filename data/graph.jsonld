        "schema:CreativeWork"
      ],
      "identifier": "CMC003247",
      "name": "El trigo",
      "titulo": "El trigo",
      "titulo_limpio": "El trigo",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1411&mode=indice&letter=t",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nCon el título El trigo no hemos encontrado ningún auto en los catálogos clásicos que manejamos ni nos consta la existencia de testimonios de esta obra. Tan solo Héctor Urzáiz recoge esta pieza dramática como anónima[[ (UT, I, 128)]] a partir d ela noticia de la que hemos dado cuenta en el calendario. Hay que advertir que en la BNE, signatura ms. 4108, se conserva un manuscrito con letra del XVIIII de un coloquio alegórico titulado El trigo de Ceres[[ (PM, 546; AM1, 677)]]. Pero no parece que sea esta obra la que se representó en Sevilla en 1652.",
      "edicion_principe": "",
