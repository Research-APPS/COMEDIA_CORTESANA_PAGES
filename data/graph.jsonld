        "schema:CreativeWork"
      ],
      "identifier": "CMC004760",
      "name": "El ángel de la guarda (1609)",
      "titulo": "El ángel de la guarda",
      "titulo_limpio": "El ángel de la guarda (1609)",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
