        "schema:CreativeWork"
      ],
      "identifier": "CMC002838",
      "name": "El capitán contra sí mismo",
      "titulo": "El capitán contra sí mismo",
      "titulo_limpio": "El capitán contra sí mismo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
