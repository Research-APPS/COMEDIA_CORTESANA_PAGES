      ],
      "identifier": "CMC003936",
      "name": "Las tres mujeres en una",
      "titulo": "Las tres mujeres en una",
      "titulo_limpio": "Las tres mujeres en una",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2517&mode=indice&letter=t",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia Las tres mujeres en una es una obra de Alonso de Remón (o Ramón), fechada entre 1609 y 1609[[ (BL, 310, 587; MeR, L; MC, 114; GaH, 185; UT, II, 548; Faj, 51v, cita la comedia sin atribuirla a Remón)]]. Se conserva un manuscrito de la comedia en la BNE con letra del s. XVII y signatura Mss. 14.896[[ (PM, 545)]]. La obra se incluyó, a nombre de Remón, en la Parte 32 de Diferentes Autores (Zaragoza, 1640)[[ (Pr, 103-106)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
