      "identifier": "CMC002806",
      "name": "El bastardo de Ceuta",
      "titulo": "El bastardo de Ceuta",
      "titulo_limpio": "El bastardo de Ceuta",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
