    {
      "@id": "https://comedia-cortesana.local/obra/CMC002617",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002617",
      "name": "Duelos de amor y lealtad",
      "titulo": "Duelos de amor y lealtad",
      "titulo_limpio": "Duelos de amor y lealtad",
      "alternateName": "Duelos de amor",
      "tipo_obra": "comedia",
      "genre": "comedia",
      "estado_ficha": "cruda",
      "fuente_principal": "AMBAS",
      "pagina_pdf": 103,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=909&mode=indice&letter=d",
      "notas": "",
      "notas_bibliograficas": "Comedia de Calderón, impresa en la Novena parte de sus comedias (Madrid, 1691), 327-382: «Fiesta que se representó a sus Magestades en el Salón Real de Palacio.» Hesse, PQ. XXVII (1948), 46, cree que la editó Vera Tassis a base del manuscrito que menciona en la lista de la Verdadera quinta parte. Hay copia manuscrita en la B.L. Add. 33.472(1) (Gayangos, IV, 300).",
      "observaciones": "Atribución (CATCOM):\nLa atribución de Duelos de amor y lealtad a Pedro Calderón de la Barca no presenta problemas y está registrada en los catálogos consultados[[ (UT, 80, 185; BL, 544; Sal, 593; Art, 118v; GaH, 61; MeR, XXXI; GaH, 61; MC, 35; F, IX, 104)]]. La edición prínceps de la obra forma parte de la Parte 9 de las comedias de Calderón (Madrid, Francisco Sanz, 1691). Se conserva una copia manuscrita en la British Library como parte de la colección Add. 33.472[[ (Gay, 300)]]. La obra, por otro lado, se publicó en varias sueltas en el siglo XVIII[[ (Moll, 52; BS, 107-108; CG, 44)]]. Para una descripción detallada de los testimonios remitimos a la tesis doctoral de Laura Carbajo Lago[[ (2021)]]. Respecto a las representaciones que se registran en el calendario, coincidimos con Shergold y Varey quienes consideran que todas tratan de la misma comedia, incluyendo la pieza representada en el corral de la Cruz en 1696 con el título Duelos de amor[[ (F, IX, 104)]]. Es importante distinguir la obra de Calderón de una comedia burlesca anónima que llevaría el mismo título[[ (BL, 544; UT, 80; Crespo Matellán, 38)]], del entremés, también anónimo, llamado Duelo de amor[[ (BL, 619)]] y de otras obras con título similar: ver en CATCOM, por ejemplo, Duelo de amor y amistad.",
      "edicion_principe": "la Novena parte de sus comedias (Madrid",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000179"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000179"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/fuentesix"
        },
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
      "tiene_representacion": [
        {
          "@id": "https://comedia-cortesana.local/representacion/REP000909"
