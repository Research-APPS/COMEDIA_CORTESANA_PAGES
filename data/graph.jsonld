      "identifier": "CMC003518",
      "name": "La corona de Hungría",
      "titulo": "La corona de Hungría",
      "titulo_limpio": "La corona de Hungría",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
