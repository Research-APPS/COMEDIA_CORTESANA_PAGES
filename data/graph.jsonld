        "schema:CreativeWork"
      ],
      "identifier": "CMC004064",
      "name": "Los estudiantes",
      "titulo": "Los estudiantes",
      "titulo_limpio": "Los estudiantes",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=890&mode=indice&letter=e",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLos estudiantes es un entremés compuesto por Alonso de Olmedo, como induce a pensar una relación de gastos, fechada el 24 de enero de 1680 y relacionada con la representación de La púrpura de la rosa, y en cuyo apartado de \"Ingenios\" se incluye un pago a Alonso de Olmedo \"por el entremés de Los estudiantes\"[[ (F, I, 99, 239)]]. Urzáiz, por su parte, cataloga este entremés tanto como atribuido a Alonso de Olmedo como anónimo[[ (UT, II, 489; UT, I, 84)]]. No nos consta la existencia de testimonios de este entremés. Cardona, Cruickshank y Cunningham[[ (1990, p. 67)]], en su edición de La púrpura de la rosa, junto a la cual se representó el entremés Los estudiantes en palacio en 1680, apuntan simplemente respecto al entremés que de las obras que nos han llegado pertenecientes a Alonso de Olmedo, \"ninguna corresponde a la mencionada en las cuentas\" de palacio. En su tesis doctoral sobre el teatro breve de Alonso de Olmedo, Francisco José Olmedo Bernal tampoco menciona Los estudiantes.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
