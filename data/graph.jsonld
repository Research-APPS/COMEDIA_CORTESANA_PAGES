    {
      "@id": "https://comedia-cortesana.local/obra/CMC002984",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002984",
      "name": "El horno",
      "titulo": "El horno",
      "titulo_limpio": "El horno",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2423&mode=indice&letter=h",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl horno, o El horno de Constantinopla es un auto de Andrés de Claramonte[[(UT, 258; BL, 556; PM, 256; AM, 107]]. En la BNE, signatura ms. 17391, se conserva el manuscrito autógrafo de Andrés de Claramonte[[(PM, 256-257)]]. No debe confundirse con el auto El horno de Babilonia de Calderón, confusión que encontramos en algunos de los catálogos clásicos que utilizamos[[(Art, 420r; MeR, XXXVI; GaH, 208; MC, 128)]]. Para más detalles sobre la obra de Calderón, véase registro correspondiente en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000088"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000088"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
      "tiene_representacion": [
        {
          "@id": "https://comedia-cortesana.local/representacion/REP001446"
        },
        {
          "@id": "https://comedia-cortesana.local/representacion/REP001447"
        }
      ]
    },
