    {
      "@id": "https://comedia-cortesana.local/obra/CMC002777",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002777",
      "name": "El agravio agradecido",
      "titulo": "El agravio agradecido",
      "titulo_limpio": "El agravio agradecido",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1680&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl agravio agradecido es una comedia de Matías de los Reyes, tal y como figura en todos los catálogos clásicos que hemos manejado[[ (BL, 325-27, 382, 524; Art, 7v; Sal, 491, 565; MeR, XXIV; GaH, 15; MC, 5; Faj, 3r)]] y en el catálogo más reciente de Urzáiz[[ (UT, II, 549)]]. La obra forma parte de un grupo de seis comedias publicadas por el autor en Jaén, en la imprenta de Pedro de la Cuesta, en 1629. Originalmente debieron ser pensadas como sueltas, pues cada una tiene su propia portada y foliación. El mismo dramaturgo, en 1640, en el prólogo de su Para algunos (Madrid, viuda de Juan Sánchez) hace alusión a la publicación de sus seis comedias en 1629. De esta recopilación de las seis comedias existen ejemplares completos en la Biblioteca Nacional de España, así los que se corresponden a las signaturas R/10665(5) y R/23962. En su mencionado libro Para algunos también incluyó la comedia que nos ocupa[[ (BL, 326; Art, 7v; Faj, 3r)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
