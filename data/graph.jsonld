        "schema:CreativeWork"
      ],
      "identifier": "CMC002905",
      "name": "El duque de Alba",
      "titulo": "El duque de Alba",
      "titulo_limpio": "El duque de Alba",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3035&mode=indice&letter=d",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEsta representación podría referirse a la obra de Lope, hoy perdida, titulada El duque de Alba en Paris, mencionada en la primera lista de El peregrino en su patria (1604) (véase el registro correspondiente en CATCOM), o de la obra Las Batuecas del duque de Alba, también de Lope, mencionada en la segunda lista de El peregrino en su patria (1618). Las Batuecas del duque de Alba fue impresa en la Parte 23 de las comedias de Lope de Vega (Madrid, María de Quiñones, 1638)[[ (ARTELOPE)]]. De esta comedia se conserva, en la BNE, una copia manuscrita del siglo XIX con signatura Ms. 16.009[[ (PM, 58, nº389)]]. En cualquier caso, no tenemos certeza sobre la atribución a Lope de la obra representada en 1628. Hay que advertir que en los catálogos consultados encontramos otra comedia que incluye en el título la mención al duque de Alba; se trata de la obra de Alonso de Remón titulada El sitio de Mons por el duque de Alba. Pero nos parece poco probable que la obra representada en 1628 fuese la de Remón, un autor cuya obra estuvo vigente entre fines del XVI y comienzos del XVII.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
