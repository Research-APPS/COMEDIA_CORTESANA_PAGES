        "schema:CreativeWork"
      ],
      "identifier": "CMC002585",
      "name": "Detener la aurora al sol",
      "titulo": "Detener la aurora al sol",
      "titulo_limpio": "Detener la aurora al sol",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "AMBAS",
      "pagina_pdf": 96,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=228&mode=indice&letter=d",
      "notas": "",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nTanto Varey y Shergold como Subirats, al recoger la noticia de representación que incluimos en el calendario, no apuntan la posible autoría de la obra. Varey y Shergold se refieren a ella como “comedia desconocida”[[ (F, IX, 97)]], al igual que Urzáiz Tortajada en su reciente catálogo[[ (UT, I, 78)]]. No nos consta tampoco la existencia de testimonios de esta obra. Hay que señalar que en su día Arteaga relacionó la obra que nos ocupa con El sol parado de Lope de Vega, que también se conoce por los títulos secundarios de Ascendencia de los Maestres de Santiago o La batalla de detén tu día, según el mismo bibliografo[[ (Art, 102, 33, 43, 360)]]. Pero no hay nada que corrobore hoy esta identificación. Por otro lado, apuntamos existe una obra de Enríquez Gómez, que también lleva, como la de Lope, el título de El sol parado[[ (BL, 141)]], pero por las mismas razones no podemos identificarla con la que nos ocupa.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
