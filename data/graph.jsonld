    {
      "@id": "https://comedia-cortesana.local/obra/CMC004801",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004801",
      "name": "Progne y Filomena (1622)",
      "titulo": "Progne y Filomena",
      "titulo_limpio": "Progne y Filomena (1622)",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=578&mode=indice&letter=p",
      "notas": "",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nProgne y Filomena es una obra de Francisco de Rojas Zorrilla que fue impresa en la Primera parte de comedias (Madrid, María de Quiñones, 1640). Existe una obra del mismo título de Guillén de Castro, pero nos parece más probable que todas las representaciones que aquí se recogen sean de la de Rojas. Ambas están catalogadas en la mayor parte de los repertorios[[ (Art, 306v; BL, 575, 708; MC, 92; GaH, 150; MeR, XLIV; y véanse además R2, 50; PP, I, 294-295; SA, 308-313; UT, II, 571; Sub, 468)]]. Una comedia burlesca del mismo título se representó en palacio en 1687. Se desconoce su autor y, al parecer, no se ha conservado: véase registro en CATCOM. Existe una refundición del siglo XVIII de la tragedia de Rojas a mano de Tomás Sebastián y Latre[[ (Sal, 506, 640; Art, 306v; PM, 453)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
