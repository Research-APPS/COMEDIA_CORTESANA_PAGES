        "schema:CreativeWork"
      ],
      "identifier": "CMC004330",
      "name": "San Martín",
      "titulo": "San Martín",
      "titulo_limpio": "San Martín",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=179&mode=indice&letter=s",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEn la edición de 1618 de El peregrino en su patria Lope de Vega incluyó una comedia titulada San Martín, de la que no se conserva el texto. Algunos catálogos clásicos recogen una obra con ese título y la atribuyen al Fénix[[ (BL, 580; Art, 338v; MeR, XLVII)]]. Por su parte, San Román, al dar noticia del documento de 1615, mencionado en el calendario, la atribuyó a Lope de Vega[[ (SR, LXXIII, 200-202)]]. Probablemente, como supuso San Román, la comedia que representó Pedro de Valdés fuese la de Lope. No obstante, hay que advertir que existe una comedia anónima titulada El glorioso san Martín de la que se conserva un manuscrito en la BNE (signatura Ms. 14767, ff. 78r-91v). Esta comedia perteneció a la colección teatral del Diego Sarmiento de Acuña, conde de Gondomar, colección que fue descubierta y catalogada por Stefano Arata. Según el investigador italiano, la fecha de la reunión de la colección es 1595-1597 (Ar1, 14).",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
