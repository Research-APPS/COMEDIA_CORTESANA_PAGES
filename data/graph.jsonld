    {
      "@id": "https://comedia-cortesana.local/obra/CMC003717",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003717",
      "name": "La pastoral de la siega",
      "titulo": "La pastoral de la siega",
      "titulo_limpio": "La pastoral de la siega",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=387&mode=indice&letter=p",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa pastoral de la siega es una comedia hoy desaparecida de Lope de Vega, que la menciona en la primera lista de El Peregrino en su patria (1604)[[ (BL, 433, 571; Daniel Fernández Rodríguez, “Nuevos datos acerca de los repertorios teatrales en el primer catálogo de El peregrino en su patria”, Studia Aurea, 8, 2014, pp. 277-314)]]. Con este título y atribución figura en los catálogos consultados[[ (BL, 433, 571; Ch, 552; Art, 282)]], si bien en la mayoría de los repertorios no hay constancia de la comedia.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
