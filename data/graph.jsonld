    {
      "@id": "https://comedia-cortesana.local/obra/CMC002786",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002786",
      "name": "El amigo por fuerza",
      "titulo": "El amigo por fuerza",
      "titulo_limpio": "El amigo por fuerza",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=443&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo hay duda en la atribución de esta comedia a Lope de Vega y así se indica pen todos los catálogos clásicos y el más reciente de Urzáiz[[ (UT, II, 652; BL, 440; Art, 17v; Sal, 538-39; MeR, XXIV; GaH, 19; Faj, 5r; MC, 8)]]. La comedia aparece citada en los dos listados de El peregrino en su patria (1604 y 1618)[[ (ARTELOPE; Ch, 545)]]. Morley y Bruerton la incluyen entre las obras de autoría fiable y datan su escritura entre 1599 y 1603[[ (MoB, 50, 81)]]. La obra fue impresa en la Parte 4 de las comedias de Lope de Vega (Madrid, Miguel Serrano de Vargas, 1614). Gaspar de Porres intervino en su publicación y bajo su nombre figura el prólogo, donde afirma que poseyó los originales de las doce comedias impresas, entre ellos, el de la comedia El amigo por fuerza[[ (TESO)]]. La comedia también circuló suelta atribuida a Lope. En la BNE, se conserva un apógrafo con signatura Ms. 22.423, ff. 393r-424r, en el tomo III de la llamada Colección Gálvez. Según este manuscrito, Lope firmó el autógrafo en Madrid, a 14 de octubre de 1599[[ (Iriso Ariz, Estudio de la colección Gálvez..., 1997, p. 107)]]. En la Biblioteca Histórica Municipal de Madrid, se conserva una copia manuscrita del XVIII con signatura Tea 1-88-10 atribuida, por una mano distinta a la del copista de la obra, a Lope. Para los detalles bibliográficos, consúltese la edición de G. Pontón y J. E. Laplana[[ (2002)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
