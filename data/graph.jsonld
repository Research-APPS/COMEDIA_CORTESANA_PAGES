        "schema:CreativeWork"
      ],
      "identifier": "CMC002476",
      "name": "Carmelo",
      "titulo": "Carmelo",
      "titulo_limpio": "Carmelo",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "FUENTESIX",
      "pagina_pdf": 74,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "",
      "notas": "",
      "notas_bibliograficas": "La primer flor del Carmelo, auto sacramental de Calderón, impreso en la Parte segunda de sus autos (Madrid, 1717), 145-170. Hay copias manuscritas en la B.N.M.: 16.279(2) y 15.117(7) (Paz, I, 447; Rull y Torres, BFE, X, núms. 34-35 [1970], 58 y 44); en la B.M.M., 1.255(7), antes 19-4 (Valbuena Prat, RBAMM, IV [1927], 484-486; Rull y Torres, Segismundo, VIII, núms. 15-16 [1972], 113); en la B.N., París, Ms. Esp. 427(11) (Morel-Fatio).",
      "observaciones": "",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
