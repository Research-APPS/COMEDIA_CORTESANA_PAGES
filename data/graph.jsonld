    {
      "@id": "https://comedia-cortesana.local/obra/CMC003599",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003599",
      "name": "La fuerza de la sangre",
      "titulo": "La fuerza de la sangre",
      "titulo_limpio": "La fuerza de la sangre",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=174&mode=indice&letter=f",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSan Román, al dar cuenta del documento de representación de 1615 que hemos manejado, atribuyó La fuerza de la sangre a Guillén de Castro[[ (SR, LXXX, 200-02)]], creemos que acertadamente. Esta obra se incluyó en la Parte 2 de este dramaturgo, publicada en Valencia por Miguel Sorolla en 1625[[ (BL, 82-83)]], y en la BNE se conserva, con la signatura Ms. 17.147, una copia manuscrita, fechada por Paz y Melia a finales del siglo XVII[[ (PM, 220)]]. Por otro lado, no hay que confundir esta comedia con la obra homónima escrita en colaboración por Matos Fragoso, Sebastián Rodríguez de Villaviciosa y Juan de Zabaleta, también conocida por los títulos El amante mudo o Amor hace hablar a los mudos, y que alguna vez se ha atribuido erróneamente a Calderón[[ (UT, I, 80, 427, 727)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000088"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000088"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
      "tiene_representacion": [
        {
          "@id": "https://comedia-cortesana.local/representacion/REP002625"
        }
      ]
    },
