    {
      "@id": "https://comedia-cortesana.local/obra/CMC004273",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004273",
      "name": "Quien calla, otorga",
      "titulo": "Quien calla, otorga",
      "titulo_limpio": "Quien calla, otorga",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=748&mode=indice&letter=q",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia Quien calla, otorga es obra de Tirso de Molina, aunque se ha atribuido también erróneamente a otros dramaturgos. Se publicó en la Parte 1, de las obras de Tirso (Sevilla, Francisco de Lyra, 1627), en donde se indica que la estrenó [Alonso de] Olmedo. Cotarelo situó la fecha del estreno entre 1621 y 1623, pero no tenemos ninguna noticia de representación que lo documente [[(CM4, 213]]). También se publicó en una edición suelta, sin datos bibliográficos, con el segundo título de Segunda parte del castigo del penséque[[ (Hes, 798, 810)]]. Salvá conoció otra suelta, publicada por Teresa de Guzmán, que sólo llevaba como título este alternativo[[ (Sal, 641)]]. Fajardo afirma que se publicó suelta en Valencia y en Sevilla[[ (Faj, 44r)]], aunque no tenemos constancia de la existencia de estos testimonios. En cuanto a las atribuciones erróneas, Medel del Castillo, García de la Huerta y Arteaga incluyen tres entradas con este título, que atribuyen a Tirso, a Bartolomé de Enciso y a Calderón[[ (MC, 94; GaH, 153; Art, 312v)]]. Sin embargo, ya Vera Tassis rechazó la atribución a Calderón[[ (Sal, 641)]] y no tenemos noticia de la existencia de una comedia auténtica de Enciso titulada como la que nos ocupa[[ (UT, I, 378)]]. Mesonero Romanos distingue entre dos comedias tituladas Quien calla, otorga: una que atribuye a Enciso y otra a Tirso[[ (MeR, LXIV)]]. La Barrera, por su parte, distingue entre la comedia atribuida a Tirso y otra atribuida a Diego Jiménez de Enciso, atribuciones que también recogen Cotarelo y Urzáiz[[ (BL, 576; CM11, 547; UT, II, 630)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
