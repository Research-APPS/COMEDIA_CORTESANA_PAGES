      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2985&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nCon este título existe una comedia atribuida a Cristóbal de Monroy, de la que se conservan varias sueltas, como indican los catálogos que manejamos[[(Art, 64v; BL, 264, 534; MeR, XXVIII; UT, II, 451; Loh, 242)]]. La comedia de Monroy es refundición y continuación del coloquio/auto titulado El nacimiento de nuestro Señor, obra en dos jornadas de Mira de Amescua. Monroy amplía el texto de las jornadas 1ª y 2ª y agrega la 3ª[[(VR, 111-116)]]. Valladares Reguero[[(VR, 111- 116)]], además de ofrecer un listado de los ejemplares de la comedia de Monroy, lleva a cabo un análisis de la interrelación entre ambas versiones.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
