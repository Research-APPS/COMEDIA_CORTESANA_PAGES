      "identifier": "CMC002584",
      "name": "Destinos vencen finezas",
      "titulo": "Destinos vencen finezas",
      "titulo_limpio": "Destinos vencen finezas",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": true,
