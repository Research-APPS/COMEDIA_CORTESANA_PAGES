        "schema:CreativeWork"
      ],
      "identifier": "CMC004012",
      "name": "Los amantes enemigos",
      "titulo": "Los amantes enemigos",
      "titulo_limpio": "Los amantes enemigos",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=835&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ninguna comedia titulada Los amantes enemigos en los catálogos clásicos que manejamos ni nos consta la existencia de testimonios con este título. Urzáiz la incluye entre las obras anónimas y remite a Martínez Aguilar[[ (UT, I, 60)]], quien cree que puede tratarse de una representación de Los amantes, de Rey Artieda o de Los amantes sin amor, de Lope de Vega[[ (”En torno a la datación de El primer conde de Flandes, de Mira de Amescua”, I, 357-91.)]]. Por el argumento, parece imposible la identificación de este título con la obra de Rey Artieda, sin embargo, sería posible identificarla con la de Lope. En caso de que se trate de una representación de la comedia de Lope Los amantes sin amor, ésta no plantea problemas de atribución a este dramaturgo. Aparece citada en las dos listas de El peregrino en su patria (1604, 1618) y Morley y Bruerton fechan su composición hacia 1601-1603[[ (ARTELOPE; MoB, 52, 104, 593)]]. Se publicó en la Parte 14 de las comedias de Lope de Vega (Madrid, Viuda de Fernando Correa Montenegro, 1621)[[(UT, II, 652; Art, 15r; BL, 428, 526; MeR, XXIV; MC, 8; GaH, 17; Faj, 5v; Sal, 543, 567; Ch, 539; Pr, 193)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
