      ],
      "identifier": "CMC003534",
      "name": "La culpa del primer hombre",
      "titulo": "La culpa del primer hombre",
      "titulo_limpio": "La culpa del primer hombre",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=502&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa culpa del primer hombre es una comedia que figura como anónima en algunos catálogos clásicos[[ (BL, 539; Art, 89; MeR, XXIX; GaH, 49; MC, 27; UT 75, 658)]], de la que no nos consta la existencia de testimonios impresos ni manuscritos. Según Shergold y Varey, el título de la obra recuerda a La creación del mundo y primer culpa del hombre, comedia atribuida a Lope de Vega, pero dichos investigadores no creen verosímil que la noticia de representación de 1688 sea de la comedia el Fénix por ser la fecha tan tardía, y apuntan a que quizá la obra que nos ocupa sea una refundición de la de Lope[[ (F, IX, 90)]]. Hay que advertir que en la BNE se conservan un manuscrito con una loa titulada Loa a la culpa del primer hombre[[ (PM, 301)]], que no sabemos si fue compuesta para la comedia que nos ocupa, para la atribuida con duda a Lope o para otra obra.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
