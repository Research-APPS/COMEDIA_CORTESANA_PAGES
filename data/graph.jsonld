    {
      "@id": "https://comedia-cortesana.local/obra/CMC003529",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003529",
      "name": "La crueldad piadosa",
      "titulo": "La crueldad piadosa",
      "titulo_limpio": "La crueldad piadosa",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=830&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ninguna comedia titulada La crueldad piadosa en los catálogos clásicos que manejamos ni nos consta la existencia de testimonios de la obra que nos ocupa. Tan solo Héctor Urzáiz recoge la obra como anónima[[ (UT, I, 74)]]. Martínez Aguilar cree que podría tratarse de La cruel Casandra, de Virués[[ (”En torno a la datación de El primer conde de Flandes, de Mira de Amescua”, en Mira de Amescua en candelero. Actas del Congreso Internacional sobre Mira de Amescua y el teatro español del siglo XVII, (Granada, 27-30 de octubre de 1994), ed. A. de la Granja y J.A. Martínez Berbel, Granada, Universidad de Granada, 1996, I, 357-91)]]. Sin embargo, no hay nada en el contenido de la obra del dramaturgo valenciano, en la que no interviene personaje alguno que pueda caracterizarse por un sentimiento piadoso, que permita identificar ambas obras.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
