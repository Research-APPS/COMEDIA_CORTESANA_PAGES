    {
      "@id": "https://comedia-cortesana.local/obra/CMC002945",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002945",
      "name": "El galán fantasma",
      "titulo": "El galán fantasma",
      "titulo_limpio": "El galán fantasma",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=686&mode=indice&letter=g",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl galán fantasma es obra de Pedro Calderón de la Barca y así se registra en todos los catálogos consultados[[ (UT, 187; BL, 551; Sal, 605; MeR, XXXIV; Art, 159v; GaH, 78; MC, 47; Faj, 24v; F, IX, 121)]]. Se publica por primera vez en la Parte 2 de las Comedias de Calderón (Madrid, María Quiñones, 1637) y se estampa nuevamente en otras tres ediciones durante el siglo XVII. Su tradición impresa se amplía a una serie de sueltas[[ (Moll, 69; BS, 135-136; CG, 68-69)]], las cuales, según Noelia Iglesias, pertenecen al siglo siguiente[[ (2015, 59)]]. En la Biblioteca Nacional de España se conservan tres manuscritos del siglo XVII: MSS/16649, MSS/15672 y MSS/17306[[ (PM, 223-224)]]. Para un estudio detallado de los testimonios de El galán fantasma remitimos a la edición moderna de Noelia Iglesias[[ (2015)]]. Cabe notar que en la misma BNE se halla el manuscrito de una pieza en un acto titulada El galán fantasma o La dama duende[[ (PM, 138)]]. Esta breve composición no está firmada, pero sería digna de estudio pues, como explica Iglesias, La dama duende es la obra calderoniana que más influencia tuvo sobre El galán fantasma[[ (2015, 24)]]. No se debe confundir estas piezas con un entremés atribuido a Quevedo que, a su vez, lleva por título El galán fantasma (SiP, 48).",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
