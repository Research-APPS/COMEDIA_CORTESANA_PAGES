      ],
      "identifier": "CMC004817",
      "name": "Santa Juana de la Cruz (1612)",
      "titulo": "Santa Juana de la Cruz",
      "titulo_limpio": "Santa Juana de la Cruz (1612)",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
