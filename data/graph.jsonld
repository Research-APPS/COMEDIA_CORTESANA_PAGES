      "identifier": "CMC004226",
      "name": "Ofender con las finezas",
      "titulo": "Ofender con las finezas",
      "titulo_limpio": "Ofender con las finezas",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
