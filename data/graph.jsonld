      "identifier": "CMC002983",
      "name": "El honrador de su padre",
      "titulo": "El honrador de su padre",
      "titulo_limpio": "El honrador de su padre",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
