      "identifier": "CMC003531",
      "name": "La cueva de Salamanca",
      "titulo": "La cueva de Salamanca",
      "titulo_limpio": "La cueva de Salamanca",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
