      "identifier": "CMC002573",
      "name": "Del monte sale quien el monte quema",
      "titulo": "Del monte sale quien el monte quema",
      "titulo_limpio": "Del monte sale quien el monte quema",
      "alternateName": "",
      "tipo_obra": "comedia",
