      "identifier": "CMC003645",
      "name": "La inocente castellana",
      "titulo": "La inocente castellana",
      "titulo_limpio": "La inocente castellana",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1450&mode=indice&letter=i",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa inocente castellana es comedia anónima. No figura en ninguno de los catálogos clásicos que hemos utilizado ni nos consta la existencia de testimonios de esta obra. Esquerdo relaciona la comedia que nos ocupa con el título La inocente castigada, que atribuye a Lope[[ (E2, 229)]], aunque en realidad este título no existe y la comedia atribuida al Fénix se titula La intención castigada, que es distinta de la que nos ocupa.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
