      ],
      "identifier": "CMC004224",
      "name": "Obsequios enciende el mármol",
      "titulo": "Obsequios enciende el mármol",
      "titulo_limpio": "Obsequios enciende el mármol",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "AMBAS",
      "pagina_pdf": 177,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1381&mode=indice&letter=o",
      "notas": "",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nObsequios enciende el mármol es una comedia de Manuel Vidal y Salvador, como recogen Arteaga y La Barrera: aquél la denomina “fiesta real india”[[ (Art, 273r; BL, 477; F, IX, 176)]]. No nos consta la existencia de testimonios de esta obra",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000218"
