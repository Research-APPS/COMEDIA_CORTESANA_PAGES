        "schema:CreativeWork"
      ],
      "identifier": "CMC004062",
      "name": "Los españoles en Flandes",
      "titulo": "Los españoles en Flandes",
      "titulo_limpio": "Los españoles en Flandes",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2789&mode=indice&letter=e",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa vuelta de los españoles a Flandes se puede identificar con la obra de Lope de Vega mejor conocida como Los españoles en Flandes, como ya señalaron Morley y Bruerton, pues con el título de La vuelta de los españoles en Flandes figura en la segunda lista de comedias del Fénix incluida en la edición de 1618 de El peregrino en su patria[[ (MoB, 322, 593; UT, II, 662, 684; ARTELOPE; BL, 443; Art, 139r; Sal, 543; MeR, XXXIII; GaH, 88; Faj, 21v; MC, 41; Ch, 548)]]. La comedia fue impresa por vez primera en la Parte 13 de las comedias de Lope de Vega (Madrid, viuda de Alonso Martín, 1620), como se ha señalado en la noticia que consta en el calendario.",
      "edicion_principe": "",
