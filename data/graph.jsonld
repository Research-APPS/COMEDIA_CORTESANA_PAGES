      "identifier": "CMC003598",
      "name": "La fuerza de la ley",
      "titulo": "La fuerza de la ley",
      "titulo_limpio": "La fuerza de la ley",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
