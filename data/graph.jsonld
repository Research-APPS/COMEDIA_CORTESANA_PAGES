      "identifier": "CMC002857",
      "name": "El cerco de Zamora",
      "titulo": "El cerco de Zamora",
      "titulo_limpio": "El cerco de Zamora",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
