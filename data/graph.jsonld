        "schema:CreativeWork"
      ],
      "identifier": "CMC003630",
      "name": "La honra vive en los muertos",
      "titulo": "La honra vive en los muertos",
      "titulo_limpio": "La honra vive en los muertos",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=629&mode=indice&letter=h",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa honra vive en los muertos es una comedia de Juan de Zabaleta, como se indica en la noticia de representación de 1644. Es probable que tuviera como títulos alternativos los de Honrados viven los muertos, que figura como anónimo en los catálogos de García de la Huerta y Arteaga[[ (GaH, 91; Art, 185v)]] y que aparentemente figuraba en una edición suelta, hoy perdida[[ (BL, 502, 505)]], y Aún vive la honra en los muertos, que ofrece La Barrera[[ (BL, 502)]] sin indicar la procedencia de esta variante. El único testimonio que se conserva de La honra vive en los muertos es el manuscrito autógrafo, que se conserva en la BNE bajo la signatura Res. 62[[ (Elejabeitia, ”Introducción...”, pp. 37-41)]].",
      "edicion_principe": "",
