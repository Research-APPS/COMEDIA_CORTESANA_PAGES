    {
      "@id": "https://comedia-cortesana.local/obra/CMC004176",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004176",
      "name": "No desagravie a las mujeres",
      "titulo": "No desagravie a las mujeres",
      "titulo_limpio": "No desagravie a las mujeres",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=884&mode=indice&letter=n",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia titulada No desagravie a las mujeres no figura en los catálogos clásicos que hemos manejado ni nos consta la existencia de testimonios de esta obra. Rennert, al recoger la noticia de 1637 de Cruzada Villaamil, señaló la posibilidad de que existiera alguna relación entre La obligación a las mujeres de Luis Vélez de Guevara y No desgraciéis las mujeres[[ (R2, 48)]], aunque este último título que da Rennert no es el que figura en la documentación teatral en la que se basa el investigador, donde el título que aparece es No desagravie a las mujeres. No vemos ninguna razón para suponer que se trata de la misma obra: para La obligación a las mujeres, más conocida con el título de Cumplir dos obligaciones, véase el registro correspondiente en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
