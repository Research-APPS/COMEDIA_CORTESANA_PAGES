      "identifier": "CMC004251",
      "name": "Persiles y Segismunda",
      "titulo": "Persiles y Segismunda",
      "titulo_limpio": "Persiles y Segismunda",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
