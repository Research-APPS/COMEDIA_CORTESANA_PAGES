      "identifier": "CMC002609",
      "name": "Doña Jimena Gómez",
      "titulo": "Doña Jimena Gómez",
      "titulo_limpio": "Doña Jimena Gómez",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2394&mode=indice&letter=d",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nComo se ha indicado en el calendario, en la BNE, con la signatura ms. 15.660, se conserva un manuscrito de Doña Jimena Gómez, mojiganga que, según se indica en la primera hoja, se hizo en Valladolid \"junto al auto La cura y enfermedad, año de 1692, de Simón de Sanmatheo\"[[ (PM, 166)]]. Esta pieza no se menciona en ninguno de los catálogos clásicos que manejamos. Simón de Sanmateo era miembro del a compañía de Manuel Ángel, y el hecho de que su nombre figure en el manuscrito podría ser indicio de que fuera el autor de la mojiganga, pero también podría simplemente ser el copista.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
