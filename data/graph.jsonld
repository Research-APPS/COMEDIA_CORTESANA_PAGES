      "identifier": "CMC002830",
      "name": "El caballero de la ardiente espada",
      "titulo": "El caballero de la ardiente espada",
      "titulo_limpio": "El caballero de la ardiente espada",
      "alternateName": "",
      "tipo_obra": "auto",
