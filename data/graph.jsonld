      "identifier": "CMC003955",
      "name": "Lo dicho, dicho",
      "titulo": "Lo dicho, dicho",
      "titulo_limpio": "Lo dicho, dicho",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
