      ],
      "identifier": "CMC003494",
      "name": "La burgalesa de Lerma",
      "titulo": "La burgalesa de Lerma",
      "titulo_limpio": "La burgalesa de Lerma",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=165&mode=indice&letter=b",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSan Román identificó la comedia citada en el documento de 1615 con La burgalesa de Lerma, de Lope de Vega[[ (SR, LXXIII)]]. La autenticidad de esta comedia de Lope queda corroborada por Morley y Bruerton. Fue publicada en 1618 en la Parte 10 de comedias del Fénix[[ (MoB, 90, 596)]]. Se conserva en la BNE, con la signatura Ms. 15.441, una copia manuscrita fechada en Madrid el 30 de noviembre de 1613 cuyo frontispicio del Acto III es autógrafo y donde figura el título como La burgalesa. Se conserva otra copia manuscrita en la Biblioteca Palatina de Parma con la signatura CC.*V.28032/XXVII[[ (Pre, 123-25; ARTELOPE)]][[ (Cacho, 153 )]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
      "tiene_representacion": [
        {
          "@id": "https://comedia-cortesana.local/representacion/REP002421"
        }
      ]
