      "identifier": "CMC003070",
      "name": "El mérito es la corona",
      "titulo": "El mérito es la corona",
      "titulo_limpio": "El mérito es la corona",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
