      "identifier": "CMC002593",
      "name": "Don Bueso",
      "titulo": "Don Bueso",
      "titulo_limpio": "Don Bueso",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
