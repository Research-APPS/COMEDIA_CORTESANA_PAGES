      "identifier": "CMC003453",
      "name": "La Tercera Orden de San Francisco",
      "titulo": "La Tercera Orden de San Francisco",
      "titulo_limpio": "La Tercera Orden de San Francisco",
      "alternateName": "",
      "tipo_obra": "comedia",
