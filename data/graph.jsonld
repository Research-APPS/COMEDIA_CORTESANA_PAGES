    {
      "@id": "https://comedia-cortesana.local/obra/CMC003689",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003689",
      "name": "La muerte de Valdovinos",
      "titulo": "La muerte de Valdovinos",
      "titulo_limpio": "La muerte de Valdovinos",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3063&mode=indice&letter=m",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa muerte de Valdovinos es una comedia de Jerónimo de Cáncer. Con este título y atribución figura en todos los repertorios clásicos consultados, así como en el catálogo de Héctor Urzáiz[[ (BL, 566; Art, 251v; Sal, 626; GaH, 121; MC, 74; MeR, XL, Faj, 36v)]]. Cáncer la publicó como parte de sus Obras varias (Madrid, Diego Díaz de la Carrera, 1651)[[ (BL, 62, 566; UT, I, 216)]]. Según Fajardo, se publicó también en forma de suelta en Madrid y en Valencia[[ (Faj, 36v)]], ediciones que no han llegado hasta nosotros. Existe una “comedia en chanza” anónima del mismo título con la que no debe confundirse la comedia que nos ocupa.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
