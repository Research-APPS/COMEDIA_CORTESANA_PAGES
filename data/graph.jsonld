      ],
      "identifier": "CMC003740",
      "name": "La puerta de la Macarena",
      "titulo": "La puerta de la Macarena",
      "titulo_limpio": "La puerta de la Macarena",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1467&mode=indice&letter=p",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa puerta de la Macarena es un auto cuya atribución a Ana Caro de Mallén figura en la documentación que mencionamos en el calendario. No se incluye este título a nombre de esta autora en los catálogos clásicos que manejamos, ni nos consta la existencia de testimonios de esta obra. Tampoco Alenda y Mira hace referencia alguna a esta pieza religiosa. Hay que advertir que existe una obra de Juan Pérez de Montalbán titulada La puerta Macarena, primera y segunda parte, que es distinta de la que nos ocupa, pues se trata de una comedia. Para más detalles, véase entrada correspondiente en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
