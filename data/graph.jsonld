    {
      "@id": "https://comedia-cortesana.local/obra/CMC004140",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004140",
      "name": "Montes afirman desdén",
      "titulo": "Montes afirman desdén",
      "titulo_limpio": "Montes afirman desdén",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": true,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1325&mode=indice&letter=m",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa obra que aparece mencionada en la noticia de representación de 1697 con el título de Montes afirman desdén ha de identificarse con la zarzuela compuesta por José de Cañizares, titulada Montes afirma el desdén. La obra se conserva manuscrita en la BNE, con signatura 17.348 y, según la descripción de Paz y Melia, es de letra del siglo XVIII. Los catálogos clásicos que hemos manejado coinciden en la atribución de Montes afirma el desdén a José de Cañizares, que La Barrera, por error, cita con el título Montes allana el desdén.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
