      ],
      "identifier": "CMC003945",
      "name": "Lavar sin sangre una ofensa",
      "titulo": "Lavar sin sangre una ofensa",
      "titulo_limpio": "Lavar sin sangre una ofensa",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2346&mode=indice&letter=l",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLavar sin sangre una ofensa es una comedia de Román Montero de Espinosa, tal y como figura en los catálogos que hemos manejado[[ (UT, II, 461; BL, 270, 558; Art, 205v, 505v; Sal, 406, 614; MeR, XXXVII; GaH, 99; MC, 61; Faj, 31r; PM, 133; SiP, 41)]]. La comedia se publicó en la Parte 22 de la colección de Comedias escogidas (Madrid, Andrés García de la Iglesia, 1665)[[ (BL, 270, 558; Art, 205v, 505v; Sal, 406; Faj, 31r; CM15, 202, 213, 592, 594)]] y se publicó en el siglo XVIII en forma de suelta (Sevilla, Francisco de Leefdael, s.a.)[[ (Vega, Fernández y del Rey, “Ediciones de teatro...”, vol. 2, p. 719)]]. Tal y como se indica en la noticia de representación, la representación de Lavar sin sangre una ofensa acabó con la mojiganga Cupido y Venus, maestros de escuela: véase el registro correspondiente en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
