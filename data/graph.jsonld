      ],
      "identifier": "CMC004031",
      "name": "Los celos por la alabanza",
      "titulo": "Los celos por la alabanza",
      "titulo_limpio": "Los celos por la alabanza",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=459&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa única noticia que tenemos de una comedia titulada Los celos por la alabanza es el inventario que perteneció a Jerónimo Amella del que damos cuenta en el calendario de representaciones, donde se atribuye a Lope de Vega. Esta comedia no figura en los catálogos clásicos que manejamos ni nos consta la existencia de testimonios. Asimismo, tampoco es mencionada por Morley y Bruerton en su trabajo clásico. Dado que el inventario de Amella presenta numerosos errores de atribución, no podemos asegurar que Los celos por la alabanza sea obra del Fénix.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
