      "identifier": "CMC002541",
      "name": "Cásate y sabrás lo que es",
      "titulo": "Cásate y sabrás lo que es",
      "titulo_limpio": "Cásate y sabrás lo que es",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
