        "schema:CreativeWork"
      ],
      "identifier": "CMC003570",
      "name": "La escolástica",
      "titulo": "La escolástica",
      "titulo_limpio": "La escolástica",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1082&mode=indice&letter=e",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEn algunos repertorios que manejamos, figura una comedia titulada La escolástica atribuida a Pedro Liñán de Riaza[[ (BL, 549; UT, I, 399)]]. De esta obra no nos consta la existencia de testimonios. Por otro lado, Lope de Vega escribió una comedia titulada La escolástica celosa. En la misma escritura de compraventa donde se cita el título de La escolástica, aparecen otros títulos de comedias del Fénix, a veces de manera abreviada, por lo que podría pensarse que se trata de la obra de Lope. Liñán de Riaza escribió sus obras a finales del siglo XVI y la obra de Lope es de las mismas fechas, por lo que la datación no permite clarificar esta situación. La comedia de Lope se publicó en la Parte 1 de sus comedias (Zaragoza, Angelo Tavano, 1604) y se conserva una copia del siglo XVIII en la BNE bajo la signatura Ms. 17.178 (ARTELOPE). Concluyendo, con los datos que tenemos no es posible definir a qué obra, la de Liñán o la de Lope, hace referencia la noticia de representación que documentamos en el calendario.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
