    {
      "@id": "https://comedia-cortesana.local/obra/CMC002426",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002426",
      "name": "Amor, firmeza y corona",
      "titulo": "Amor, firmeza y corona",
      "titulo_limpio": "Amor, firmeza y corona",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1005&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nAmor firmeza y corona es una comedia de Manuel Vidal y Salvador, como señalan Arteaga y La Barrrera; éste da el título por error como Amor, fineza y corona[[ (Art 21v; BL, 477)]]. Se conserva el manuscrito autógrafo de la comedia en la Biblioteca del Institut del Teatre de Barcelona bajo la signatura 82.659. Se conserva asimismo una copia manuscrita del siglo XVIII en la Biblioteca Histórica Municipal de Madrid bajo la signatura T-6-11 (Mas y Vellón, p. 76; SiP, 74). Por otro lado, Shergold y Varey afirman que existía un manuscrito en una supuesta Biblioteca Valentina[[ (F, IX, 57)]], pero se trata de una confusión, pues en realidad la fuente es una alusión a este título en el libro de José Rodríguez titulado Biblioteca Valentina (Valencia, José Tomás Lucas, 1747).",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
