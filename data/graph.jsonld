      "identifier": "CMC003910",
      "name": "Las mesas de la Fortuna",
      "titulo": "Las mesas de la Fortuna",
      "titulo_limpio": "Las mesas de la Fortuna",
      "alternateName": "",
      "tipo_obra": "auto",
