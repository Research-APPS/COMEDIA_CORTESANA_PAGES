        "schema:CreativeWork"
      ],
      "identifier": "CMC003646",
      "name": "La intención castigada",
      "titulo": "La intención castigada",
      "titulo_limpio": "La intención castigada",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=526&mode=indice&letter=i",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa intención castigada es una comedia asociada a Lope de Vega, aunque su autoría presenta dudas. Se publicó a nombre de este dramaturgo en la Parte 22 de comedias de Lope y otros dramaturgos (Zaragoza, Pedro Verges, 1630)[[ (MCacho, 186-89, 494, 497; Pr, 29)]], mientras que en la Biblioteca Palatina de Parma se conserva, bajo la signatura CC*V28032/19/V, una copia manuscrita de La intención castigada atribuida a Lope de Vega (MCacho, 186-89, 494, 497; Pr, 29). Esta atribución se repite en todos los catálogos clásicos consultados[[ (BL, 556; Art, 193v; Sal, 546; GaH, 95; MC, 58; MeR, XXXVI; Faj, 29r)]]. También Chorley y Sánchez Arjona la creen obra del Fénix[[ (Ch, 540; SA, 308-313)]]. Sin embargo, Morley y Bruerton consideran dudosa la atribución a Lope de Vega[[ (MoB, 484)]], de ahí que también consideremos como no fiable su autoría.",
