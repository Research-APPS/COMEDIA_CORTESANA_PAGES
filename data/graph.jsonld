      "identifier": "CMC002904",
      "name": "El duelo contra su dama",
      "titulo": "El duelo contra su dama",
      "titulo_limpio": "El duelo contra su dama",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
