      "identifier": "CMC003766",
      "name": "La rueda de la fortuna",
      "titulo": "La rueda de la fortuna",
      "titulo_limpio": "La rueda de la fortuna",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
