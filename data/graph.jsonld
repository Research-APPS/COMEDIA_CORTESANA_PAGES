    {
      "@id": "https://comedia-cortesana.local/obra/CMC003483",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003483",
      "name": "La batalla naval de los galeones",
      "titulo": "La batalla naval de los galeones",
      "titulo_limpio": "La batalla naval de los galeones",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2159&mode=indice&letter=b",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa batalla naval de los galeones es una comedia de autor desconocido[[ (UT, I, 65)]]. En la noticia de representación se indica que la comedia se había escrito en Sevilla sobre una reciente victoria española en Flandes[[ (SA, 332-33)]], probablemente el combate naval en Pan de Cabaña contra una flota holandesa. Esta información hace pensar que la obra fue escrita por un sevillano, aunque no se ofrece más información. La batalla naval de los galeones no figura en los catálogos clásicos que hemos manejado ni nos consta la existencia de testimonios de esta obra. La comedia que nos ocupa no debe confundirse con otras comedias de título similar, La batalla naval de Cervantes, la comedia homónima de Lope de Vega, o La batalla naval de don Juan de Austria de Vicente Mascareñas.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
