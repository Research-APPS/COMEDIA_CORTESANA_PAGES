      ],
      "identifier": "CMC002603",
      "name": "Don Sancho el Malo",
      "titulo": "Don Sancho el Malo",
      "titulo_limpio": "Don Sancho el Malo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
