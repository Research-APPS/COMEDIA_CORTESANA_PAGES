      "identifier": "CMC003485",
      "name": "La bella malmaridada",
      "titulo": "La bella malmaridada",
      "titulo_limpio": "La bella malmaridada",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
