      "identifier": "CMC002909",
      "name": "El dómine Lucas",
      "titulo": "El dómine Lucas",
      "titulo_limpio": "El dómine Lucas",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
