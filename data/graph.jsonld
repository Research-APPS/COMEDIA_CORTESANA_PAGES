        "schema:CreativeWork"
      ],
      "identifier": "CMC003279",
      "name": "El yerro del entendido",
      "titulo": "El yerro del entendido",
      "titulo_limpio": "El yerro del entendido",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1394&mode=indice&letter=y",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl yerro del entendido es una comedia de Matos Fragoso. Según Shergold y Varey, en la BME hay cinco ejemplares de una copia manuscrita titulada No hay que fiar en amigo y el yerro del entendido, título este que no figura en los repertorios clásicos que manejamos, a diferencia del nombre por el que es más conocida la comedia. El yerro del entendido se publicó en la Primera Parte de las comedias del dramaturgo (Madrid, Julián de Paredes, 1658), así como en forma de suelta, de la que se conserva algún testimonio (Valencia, José y Tomás de Orga, 1772) atribuido a Matos. Hay que advertir que existe una obra titulada No hay que fiar en amigos que es distinta de la que nos ocupa, pues se trata de un sainete.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
