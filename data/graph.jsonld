    {
      "@id": "https://comedia-cortesana.local/obra/CMC004199",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004199",
      "name": "No puede mentir el cielo",
      "titulo": "No puede mentir el cielo",
      "titulo_limpio": "No puede mentir el cielo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1628&mode=indice&letter=n",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo puede mentir el cielo es una comedia que actualmente se considera como obra de Andrés Gil Enríquez, aunque también se ha atribuido a Rodrigo Enríquez, Diego Enríquez o Agustín Moreto.Se conservan dos testimonios manuscritos de esta obra. El más antiguo es una copia fechada en 1684 y conservada en la Biblioteca Palatina de Parma se conserva, bajo la signatura CC*IV. 28033, Vol. 68, XI. En ella se atribuye la comedia a Andrés Gil Enríquez[[ (MCh, 121; Cacho, 101-102)]]. La segunda copia manuscrita es del siglo XVIII y se conserva en la BNE bajo la signatura Ms. 15.242. En esta versión del texto de la comedia se atribuye a Agustín Moreto, aunque una anotación hecha al final de manuscrito indica que se atribuye tanto a Moreto como a Andrés Gil Enríquez (PM, 389). La Barrera atribuyó la comedia a Rodrigo Enríquez y afirmó que en algunas ediciones circulaba a nombre de Diego Enríquez[[ (BL, 134)]]. Kennedy, por su parte, considera que es obra de Moreto[[ (K2, 310)]]. Renata Londero, editora moderna de la obra, señala que no hay constancia de ninguna posible edición consultada por La Barrera y considera que la obra solamente fue escrita por Andrés Gil Enríquez[[ (Londero, “Introduzione”, pp. 36-42)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
