      "identifier": "CMC003780",
      "name": "La sentencia sin firma",
      "titulo": "La sentencia sin firma",
      "titulo_limpio": "La sentencia sin firma",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
