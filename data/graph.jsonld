      "identifier": "CMC004284",
      "name": "Reinar por obedecer",
      "titulo": "Reinar por obedecer",
      "titulo_limpio": "Reinar por obedecer",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
