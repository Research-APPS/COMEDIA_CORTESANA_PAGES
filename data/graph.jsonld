      "identifier": "CMC002910",
      "name": "El ejemplo de las casadas",
      "titulo": "El ejemplo de las casadas",
      "titulo_limpio": "El ejemplo de las casadas",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
