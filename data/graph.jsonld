      "identifier": "CMC004099",
      "name": "Los tres Ponces de León",
      "titulo": "Los tres Ponces de León",
      "titulo_limpio": "Los tres Ponces de León",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
