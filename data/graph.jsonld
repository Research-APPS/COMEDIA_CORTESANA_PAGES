        "schema:CreativeWork"
      ],
      "identifier": "CMC004065",
      "name": "Los evangelistas",
      "titulo": "Los evangelistas",
      "titulo_limpio": "Los evangelistas",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2554&mode=indice&letter=e",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNinguno de los catálogos clásicos recoge un auto con este título ni nos constan testimonios del mismo. Alenda y Mira trae un auto titulado Los evangelistas sin atribución. Agustín de la Granja, como hemos señalado en la noticia de representación, atribuye un auto titulado Los evangelistas a Lope de Vega, y tras él Urzáiz, quien piensa que debe de ser el mismo que Alenda citaba como anónimo[[ (Gr, 64-65, 76 n.35 y n.36; UT, II, 686; AM1, 514)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
