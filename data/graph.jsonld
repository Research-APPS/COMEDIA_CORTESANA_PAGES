      "identifier": "CMC003469",
      "name": "La almoneda (primera parte)",
      "titulo": "La almoneda (primera parte)",
      "titulo_limpio": "La almoneda (primera parte)",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
