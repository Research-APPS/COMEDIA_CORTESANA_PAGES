        "schema:CreativeWork"
      ],
      "identifier": "CMC004003",
      "name": "Los Tellos de Meneses",
      "titulo": "Los Tellos de Meneses",
      "titulo_limpio": "Los Tellos de Meneses",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1536&mode=indice&letter=t",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSe trata de una obra diferente de Los Tellos de Meneses (primera parte) y Valor, fortuna y lealtad de Los Tellos de Meneses (segunda parte de Los Tellos de Meneses) de Lope de Vega, pues Morley y Bruerton dan como fecha de composición para la primera parte el periodo comprendido entre 1620 y 1628 y para la segunda parte el que media entre 1625 y 1630[[ (MoB, 397-398, 564-565)]]. Aunque no se trataría de ninguna de estas dos obras, Ferrer Valls apunta que en la primera lista de El peregrino en su patria (1604), Lope incluyó una obra titulada La infanta labradora, título que se ajusta muy bien con el argumento de la leyenda del origen de los Tellos que se desarrolla en la primera parte de la bilogía: una infanta que huye de palacio y se refugia en una aldea, en las tierras de Meneses, como labradora. ¿Podría haber escrito el Fénix una versión anterior de la leyenda? Hay que recordar también que Jerónimo Velázquez fue un autor con el que Lope colaboró (Ferrer Valls, 45-48). Puede verse también en CATCOM el registro de El robo de la infanta (o El blasón de los Meneses) y los registros de las dos obras mencionadas de Lope de Vega.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
