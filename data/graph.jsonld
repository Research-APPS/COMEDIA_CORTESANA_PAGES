      "identifier": "CMC004033",
      "name": "Los cielos contra los celos",
      "titulo": "Los cielos contra los celos",
      "titulo_limpio": "Los cielos contra los celos",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
