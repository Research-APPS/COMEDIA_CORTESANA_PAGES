    {
      "@id": "https://comedia-cortesana.local/obra/CMC004368",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004368",
      "name": "Siempre hay que envidiar amando",
      "titulo": "Siempre hay que envidiar amando",
      "titulo_limpio": "Siempre hay que envidiar amando",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "comedia",
      "estado_ficha": "cruda",
      "fuente_principal": "AMBAS",
      "pagina_pdf": 219,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1385&mode=indice&letter=s",
      "notas": "",
      "notas_bibliograficas": "Comedia de Antonio de Zamora, impresa en sus Comedias nuevas (Madrid, 1722). Salió suelta y anónima (Salvá, I, 650; ejemplar en la B.M.M., según Cambronero).",
      "observaciones": "Atribución (CATCOM):\nNo hay duda sobre la atribución de Siempre hay que envidiar amando a Antonio de Zamora, pues así lo recogen todos los catálogos clásicos y el más reciente de Héctor Urzaiz[[ (UT, II, 731-32; BL, 505, 525; Art, 354r; Sal, 562, 650; MeR, XLVIII; GaH, 174; MC, 108; F, IX, 218)]]. La comedia fue impresa por vez primera en el volumen de Antonio de Zamora Comedias nuevas, junto con los sainetes que la acompañaron en su representación, tanto en el Coliseo del Sitio Real del Buen Retiro, como en el Salón de Palacio (Madrid, Diego Martínez, Abad, 1722). Asimismo, se publicó también en forma de suelta, atribuida al citado dramaturgo[[ (Moll, 151, nº106; CG, 250, nº348)]]. Según La Barrera, la obra coincide con la anónima Amando, siempre hay envidias, aunque no podemos estar seguros de esta identificación, pues no nos consta testimonios de este último título.",
      "edicion_principe": "sus Comedias nuevas (Madrid",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000136"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000136"
      },
