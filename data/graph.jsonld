        "schema:CreativeWork"
      ],
      "identifier": "CMC004032",
      "name": "Los ciegos",
      "titulo": "Los ciegos",
      "titulo_limpio": "Los ciegos",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1553&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa mojiganga Los ciegos es una obra escrita por Calderón de la Barca[[ (UT, I, 202, 204; UT, II, 760; Granja, “Una mojiganga...”)]]. Se conserva una copia manuscrita en la Biblioteca Histórica Municipal de Madrid bajo la signatura 1229-7[[ (UT, I, 204; Granja, “Una mojiganga...”)]]. Urzáiz indica que una copia manuscrita de una pieza breve titulada Los ciegos, atribuida a Calderón o a Moreto y conservada en la BNE bajo la signatura 16.291/52, sería un testimonio de la obra que nos ocupa[[ (UT, I, 204; PM, 94)]], pero se trata de una confusión con una obra homónima. De hecho, la mojiganga que nos ocupa no debe confundirse con otras piezas breves también tituladas Los ciegos, atribuidas a Agustín Moreto, Calderón, Jerónimo de Cáncer, y a Maestro Albolafio y Antonio García del Portillo[[ (UT, 217, 475, 50, 70, 337)]]. Tampoco debe confundirse con el entremés anónimo Los ciegos apaleados, ni con un entremés titulado Los ciegos del serení y el hambriento y atribuido a varios dramaturgos: Cáncer, Villaviciosa, Enríquez Gómez, Juan de Castro y Salazar y a Zarate[[ (Sal, 361, 436; UT, II, 217, 733; BL, 664)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
