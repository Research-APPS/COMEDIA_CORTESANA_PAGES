      ],
      "identifier": "CMC002565",
      "name": "De tu enemigo, el primer consejo",
      "titulo": "De tu enemigo, el primer consejo",
      "titulo_limpio": "De tu enemigo, el primer consejo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
