        "schema:CreativeWork"
      ],
      "identifier": "CMC002788",
      "name": "El amor bandolero",
      "titulo": "El amor bandolero",
      "titulo_limpio": "El amor bandolero",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=837&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia de El amor bandolero se publicó en la Parte 24 de la colección de Diferentes Autores (Zaragoza, D. Darmer-J. Ginobart, 1633) a nombre de Lope de Vega[[ (Pr, 40, 43)]] y existe una copia manuscrita, conservada en la BNE bajo la signatura Ms. 14.977, en la que también se atribuye a Lope[[ (PM, 20)]]. De ahí que investigadores como Rennert consideraran esta obra como de Lope[[ (R1, 333)]] y lo misma reflejan todos los catálogos clásicos que hemos manejado[[ (Faj, 4v; MC, 9; GaH, 19; Art, 18v; MeR, xxiv; BL, 526; Ch, 546)]]. Sin embargo, Morley y Bruerton, después de analizar la métrica de El amor bandolero, llegaron a la conclusión de que la comedia no fue escrita por el Fénix[[ (MoB, 419-20)]], por lo que su autor nos es actualmente desconocido.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
