        "schema:CreativeWork"
      ],
      "identifier": "CMC003162",
      "name": "El renegado del cielo",
      "titulo": "El renegado del cielo",
      "titulo_limpio": "El renegado del cielo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2526&mode=indice&letter=r",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nTodos los catálogos consultados atribuyen la comedia El renegado del cielo a Cristóbal de Morales, atribución que figura en el documento de 1660 mencionado en el calendario. La Barrera creía que se trataba de la obra del mismo autor titulada Renegado, rey y mártir, pero, como confirman el resto de los catálogos que manejamos, se trata de dos comedias distintas[[ (UT, II, 466; BL, 274; Art, 322v; Sal, 644; MeR, XLV; GaH, 156; Faj, 45r; MC, 96; F, IX, 200)]]. La obra circuló suelta durante los siglos XVII y XVIII[[ (BS, 247, nº1000; VE, 114, nº155)]]. El hecho de que en 1660 se mencione El renegado del cielo como “comedia nueva” arroja dudas sobre la identificación de esta comedia con la representada en 1641. Podría tratarse de una refundición del mismo autor sobre su propia comedia. O de una comedia del mismo título y autor diferente, pero no tenemos pruebas en ninguno de los dos sentidos. Hay que señalar que las sueltas conservadas al parecer no difieren entre ellas y por la tanto la posibilidad de que el mismo autor escribiese dos veces sobre el mismo tema es una mera hipótesis[[(VS2, 25; F, IV, 190, 247)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
