      "identifier": "CMC003033",
      "name": "El mayor blasón de la casa de Austria",
      "titulo": "El mayor blasón de la casa de Austria",
      "titulo_limpio": "El mayor blasón de la casa de Austria",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
