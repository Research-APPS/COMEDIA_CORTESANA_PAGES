      "identifier": "CMC003870",
      "name": "Las bodas",
      "titulo": "Las bodas",
      "titulo_limpio": "Las bodas",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3062&mode=indice&letter=b",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLos catálogos consultados no registran ninguna pieza titulada Las bodas. Se conservan muchos testimonios y noticias de diferentes obras del Siglo de Oro que tratan sobre bodas, tema particularmente recurrente en géneros breves de carácter jocoso. Quizá futuros estudios sobre los testimonios conservados de mojigangas cuyo tema central son unas bodas permitan conocer el autor de la pieza que ahora nos ocupa.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
