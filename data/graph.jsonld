    {
      "@id": "https://comedia-cortesana.local/obra/CMC003338",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003338",
      "name": "Gustos y disgustos son no más que imaginación",
      "titulo": "Gustos y disgustos son no más que imaginación",
      "titulo_limpio": "Gustos y disgustos son no más que imaginación",
      "alternateName": "Gustos y disgustos sólo es imaginación",
