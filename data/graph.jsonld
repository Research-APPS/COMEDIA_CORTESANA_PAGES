    {
      "@id": "https://comedia-cortesana.local/obra/CMC004067",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004067",
      "name": "Los hermanos parecidos",
      "titulo": "Los hermanos parecidos",
      "titulo_limpio": "Los hermanos parecidos",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2550&mode=indice&letter=h",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLos hermanos parecidos es un auto sacramental atribuido a Tirso de Molina. Se imprime en 1635 dentro de Deleitar aprovechando (Madrid, Imprenta Real), volumen publicado a su nombre[[ (Hes, 799; AM1, 102)]]. Lo recogen atribuido a Tirso algunos de los catálogos clásicos[[ (BL, 596; Sal, 667)]], aunque Urzáiz señala que es dudosa su autoría[[ (UT, II, 631)]]. Agustín de la Granja lo menciona como auto de Tirso[[ (GR6, 354)]], y lo han publicado igualmente con atribución a Tirso tanto Blanca de los Ríos[[ (Obras dramáticas completas, Tomo II, Madrid, Aguilar, 1989)]] como Arellano, Oteiza y Zugasti[[ (Obras completas. Autos sacramentales, Tomo I, Madrid-Pamplona, Instituto de Estudios Tirsianos, 1998)]]. En algunos catálogos, como el de Arteaga, el auto aparece sin atribución[[ (Art, 176v)]] y a veces aparece registrado como comedia, también sin atribución[[ (MC, 52; GaH, 87; BL, 554)]]. Por su parte, Fajardo recoge el título y especifica que forma parte de Deleitar aprovechando, pero consta como comedia y no como auto[[ (Faj, 72)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
