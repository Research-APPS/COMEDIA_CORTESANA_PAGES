      "identifier": "CMC004294",
      "name": "Rodas defendida",
      "titulo": "Rodas defendida",
      "titulo_limpio": "Rodas defendida",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
