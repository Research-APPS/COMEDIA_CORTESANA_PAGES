      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=466&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia de El alcaide de Madrid se atribuye a Antonio Mira de Amescua en el documento de 1628 mencionado en el apartado de cronología. Sin embargo, tanto Mérimée como Rennert y San Román, al publicar los documentos arriba citados, identificaron sin dudas este título con la comedia homónima de Lope de Vega[[ (M, 176; R2, 49; SR, LXIX)]], de cuya autenticidad no dudan Morley y Bruerton[[ (MB, 225).]] No se publicó en la época y sólo se conoce una copia manuscrita, de letra del siglo XVII, que se conserva en la BNE bajo la signatura Ms. 16.893[[ (ARTELOPE)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
