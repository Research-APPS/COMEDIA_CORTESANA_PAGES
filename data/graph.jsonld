      "identifier": "CMC003373",
      "name": "Juliano apóstata",
      "titulo": "Juliano apóstata",
      "titulo_limpio": "Juliano apóstata",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
