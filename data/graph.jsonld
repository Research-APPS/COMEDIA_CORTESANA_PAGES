    {
      "@id": "https://comedia-cortesana.local/obra/CMC003272",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003272",
      "name": "El verdadero amante",
      "titulo": "El verdadero amante",
      "titulo_limpio": "El verdadero amante",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=114&mode=indice&letter=v",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSalvá y La Barrera aludieron a un manuscrito de esta comedia que hoy se conserva en la Biblioteca de la Sorbona, con la signatura Ms. 2043 y con letra del siglo XVIII, en el que el título de la comedia aparece como El verdadero amante, gran pastoral Belarda[[(ARTELOPE; Sal, 660; BL, 437)]]. La comedia fue publicada en la Parte 14 de las comedias de Lope de Vega (Madrid, Juan de la Cuesta-Miguel de Syles, 1620), donde se indica que la representó Nicolás de los Ríos [[(Pr, 193-94; TESO)]]. Esto lo confirma también Thornton Wilder, quien, tras estudiar el listado de comedias publicado por Lope de Vega en la edición de 1604 de El peregrino en su patria, llegó a la conclusión de que, de las obras allí citadas, Nicolás de los Ríos habría estrenado, entre otras, El verdadero amante [[(W, 195)]]. Cabe señalar que Morley y Bruerton corroboran la atribución de esta comedia a Lope, quien, al dedicarla a su hijo, afirmaba haberla escrito cuando tenía doce años, aunque Morley y Bruerton señalan que no hay pruebas de ello y consideran que probablemente se escribió en el periodo 1588-1595[[(MoB, 58, 261-262; TESO)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
