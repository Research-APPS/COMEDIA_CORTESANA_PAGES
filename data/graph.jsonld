    {
      "@id": "https://comedia-cortesana.local/obra/CMC003006",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003006",
      "name": "El juramento del príncipe",
      "titulo": "El juramento del príncipe",
      "titulo_limpio": "El juramento del príncipe",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=961&mode=indice&letter=j",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl título El juramento del príncipe no se menciona en los catálogos que hemos manejado, con la excepción del catálogo de Urzáiz, en el que se incluye como obra anónima, a partir de la misma noticia de representación de 1643 que mencionamos en el calendario[[ (UT, I, 93)]]. No nos consta la existencia de testimonios de esta obra. Por otro lado, en la entrada del catálogo de Urzáiz correspondiente a Francisco de Borja y Aragón, príncipe de Esquilache, Urzáiz se refiere a una comedia suya de capa y espada, hoy perdida y de título desconocido, que se representó en palacio con motivo del juramento del príncipe Baltasar Carlos en 1632, y a la que alude Antonio Hurtado de Mendoza en la relación de las fiestas[[ (UT, I, 172)]]. Es difícil saber si se trata de la misma obra que fue representada en 1643, pues de la de Esquilache desconocemos el título y el contenido.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
