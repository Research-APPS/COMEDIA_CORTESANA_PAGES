      ],
      "identifier": "CMC002399",
      "name": "Amar como se ha de amar",
      "titulo": "Amar como se ha de amar",
      "titulo_limpio": "Amar como se ha de amar",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
