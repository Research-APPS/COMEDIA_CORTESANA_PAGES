      "identifier": "CMC004810",
      "name": "El robo de Elena (1619)",
      "titulo": "El robo de Elena",
      "titulo_limpio": "El robo de Elena (1619)",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
