    {
      "@id": "https://comedia-cortesana.local/obra/CMC004236",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004236",
      "name": "Pachecos y Palomeques",
      "titulo": "Pachecos y Palomeques",
      "titulo_limpio": "Pachecos y Palomeques",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2302&mode=indice&letter=p",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEn la Biblioteca Nacional de España, signatura Ms. 16609, se conserva el manuscrito autógrafo de Pachecos y Palomeques, o los bandos de Toledo, de José Antonio García de Prado. Este manuscrito presenta censura fechada el 22 de agosto de 1674[[ (PM, 411)]]. También en la Biblioteca de Parma, y sin que figure el nombre del autor, se encuentra un manuscrito del siglo XVIII (signatura CC*IV28033) con el título Pachecos y Palomeques[[ (MCacho, 87, 493)]]. Algunos repertorios clásicos recogen ambos títulos relacionándolos, aunque consideran la obra anónima[[ (Art, 278r, 41r; MeR, XLII, XXVI)]], otros catálogos la indexan como Los bandos de Toledo sin relacionarla con ningún dramaturgo[[ (GaH, 136; MC, 84)]]. La Barrera ya catalogó Pachecos y Palomeques atribuyéndola a García de Prado [[ (BL, 570)]], y más modernamente Subirats y Urzáiz[[ (Sub, 462; UT, I, 337-338)]]. Hay que advertir que en la BNE[[ (PM, 441)]] se encuentra otra obra titulada Pachecos y Palomeques que es distinta de la que nos ocupa.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
