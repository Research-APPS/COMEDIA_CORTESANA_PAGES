        "schema:CreativeWork"
      ],
      "identifier": "CMC003959",
      "name": "Lo que ha de ser",
      "titulo": "Lo que ha de ser",
      "titulo_limpio": "Lo que ha de ser",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=501&mode=indice&letter=l",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLo que ha de ser es una comedia de Lope de Vega. Morley y Bruerton la incluyen en el listado de comedias auténticas del autor [[(MoB, 68, 97, 130, 599) ]]y señalan que se terminó de escribir el 2 de septiembre de 1624, según consta en una copia manuscrita conservada en la British Library bajo la signatura Ms. Eg. 548, fechada ese mismo 1624 y con licencia de representación para Lisboa fechada el 20 de diciembre de 1625. De este manuscrito hay una copia en la Biblioteca Menéndez Pelayo de Santander, sin que Urzáiz aporte más información[[ (UT, II, 669)]]. Lo que ha de ser se imprimió primero a nombre de Lope en la Parte 22 de la colección de Diferentes Autores (Zaragoza, Pedro Verges, 1630). Posteriormente se incluyó en la Parte 25 de la colección de comedias de Lope (Zaragoza, Viuda de Pedro Verges, 1647) y se publicó también en forma de suelta, sin datos bibliográficos[[ (ARTELOPE)]].",
      "edicion_principe": "",
