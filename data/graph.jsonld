      ],
      "identifier": "CMC004320",
      "name": "San Javier Grande en el Hito",
      "titulo": "San Javier Grande en el Hito",
      "titulo_limpio": "San Javier Grande en el Hito",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": true,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2965&mode=indice&letter=s",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLos catálogos de La Barrera, García de la Huerta, Mesonero Romanos y el más reciente de Urzaiz recogen la obra San Xavier Grande en el Hito o San Javier Grande en el Hito como una zarzuela anónima escrita por un “devoto del santo”, tal y como reza el título de la suelta en la que fue publicada[[ (BL, 580; GaH, 167; MeR, 104; UT, I, 121)]]. De esta se conserva una en la Biblioteca Palatina de Parma y otra en la Real Academia de la Historia de Madrid, con signatura 9/3501. Según Elizalde[[ (”El teatro escolar...”, 1990, 133)]], el autor sería un jesuita por las referencias internas del texto a la compañía.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
