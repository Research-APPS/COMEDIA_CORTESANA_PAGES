      "identifier": "CMC003873",
      "name": "Las bodas del hidalgo",
      "titulo": "Las bodas del hidalgo",
      "titulo_limpio": "Las bodas del hidalgo",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
