    {
      "@id": "https://comedia-cortesana.local/obra/CMC002741",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002741",
      "name": "El Retiro",
      "titulo": "El Retiro",
      "titulo_limpio": "El Retiro",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1186&mode=indice&letter=r",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl entremés El Retiro no aparece mencionado en ninguno de los catálogos clásicos que manejamos[[ (UT, BL, Art, Sal, MeR, GaH, MC, Faj, Sal)]]. Sánchez-Arjona incluye este título en una lista de 1637 que había hecho Tomás Fernández de las obras que poseía y que aún no había representado en Sevilla, lista en la que no se indica la autoría de la pieza[[ (SA, 310-13)]]. Bergman, al recoger la información de Sánchez-Arjona, menciona que esta obra tal vez salió de la pluma de Quiñones de Benavente, como muchas de las demás obras del listado[[ (Be, 173-74)]], sin que pueda confirmarse o desmentirse esta hipótesis por la ausencia del texto. Por ello, consideramos este entremés como anónimo. No nos consta la existencia de testimonios de la obra que nos ocupa.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
