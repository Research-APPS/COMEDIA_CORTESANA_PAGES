        "schema:CreativeWork"
      ],
      "identifier": "CMC002451",
      "name": "Aun de noche alumbra el sol",
      "titulo": "Aun de noche alumbra el sol",
      "titulo_limpio": "Aun de noche alumbra el sol",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=223&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nAun de noche alumbra el sol aparece atribuida a Felipe Godínez en los catálogos clásicos que hemos manejado[[ (BL, 172; Art, 38; Sal, 572; MeR, xxvi; GaH, 28; MC, 14; Faj, 8)]] y en repertorios de atribuciones más recientes, como el catálogo de Urzáiz[[ (R1, 333; UT, I, 341)]]. Las ediciones sueltas también atribuyen la obra a Godínez[[ (Moll, 16; BS, 121; MPR, 14; CG, 141)]]. Es una obra “inequívocamente godinista”, según Germán Vega García-Luengos, quien demuestra que una atribución a Agustín Moreto que recoge Bartolomé Palau proviene de un claro error[[ (Problemas de un dramaturgo..., pp. 89-90)]]. Se conocen cinco ediciones sueltas, con datos bibliográficos incompletos, y una refundición manuscrita, conservada en la Biblioteca Histórica Municipal de Madrid, legajo 2-17[[ (Godínez, Aun de noche alumbra el sol..., pp. 67-68; Bolaños Donoso, La obra dramática..., pp. 138-40; Profeti, Per una bibliografia di Felipe Godínez, 38-4)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
