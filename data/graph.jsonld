      ],
      "identifier": "CMC003462",
      "name": "La Virgen de la Salceda",
      "titulo": "La Virgen de la Salceda",
      "titulo_limpio": "La Virgen de la Salceda",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
