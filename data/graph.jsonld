      "identifier": "CMC003092",
      "name": "El palacio de Alcina",
      "titulo": "El palacio de Alcina",
      "titulo_limpio": "El palacio de Alcina",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
