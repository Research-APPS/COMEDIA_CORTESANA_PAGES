      ],
      "identifier": "CMC004443",
      "name": "Venus y Adonis",
      "titulo": "Venus y Adonis",
      "titulo_limpio": "Venus y Adonis",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
