        "schema:CreativeWork"
      ],
      "identifier": "CMC004013",
      "name": "Los amigos engañados",
      "titulo": "Los amigos engañados",
      "titulo_limpio": "Los amigos engañados",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2491&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia Los amigos engañados no figura en ninguno de los catálogos que hemos manejado ni nos consta la existencia de testimonios de esta obra. Existe una comedia titulada Los amigos enojados, atribuida a Lope de Vega o a Gaspar Aguilar[[ (Bruerton, “Is Aguilar...”)]], y que posiblemente se compuso en torno a la última década del siglo XVI, pero, más allá de la similitud en el título, no contamos con ningún elemento que permita asegurar que esta otra comedia sea la misma que la que nos ocupa.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
