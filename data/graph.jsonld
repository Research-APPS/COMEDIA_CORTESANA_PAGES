    {
      "@id": "https://comedia-cortesana.local/obra/CMC004781",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004781",
      "name": "El gran cardenal de España (1620)",
      "titulo": "El gran cardenal de España",
      "titulo_limpio": "El gran cardenal de España (1620)",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
