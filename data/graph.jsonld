    {
      "@id": "https://comedia-cortesana.local/obra/CMC002491",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002491",
      "name": "Celos hasta los cielos",
      "titulo": "Celos hasta los cielos",
      "titulo_limpio": "Celos hasta los cielos",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1889&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nCelos hasta los cielos es una comedia de Luis Vélez de Guevara[[ (UT, II, 700; CM10, 276; SS, 164-68)]] que figura en algunos de los catálogos clásicos que manejamos[[ (Art, 65r, 99r; MeR, XXVIII, XXX)]] y de la que se conserva una impresa suelta sin lugar ni año del siglo XVII[[ (CM10, 276)]]. En otros repertorios aparece un segundo título, Desdichada Estefanía[[ (Art, 65r, 99r; MeR, XXVIII, XXX)]], que consta también en una edición suelta posterior (Salamanca, Imprenta de la Santa Cruz, s.a). Asimismo, en algunos catálogos la comedia consta con el título compuesto Los celos hasta los cielos, y desdichada Estefanía[[ (BL, 534; Sal, 663)]]. A excepción de Medel del Castillo, que atribuye la composición a Juan Vélez por error[[ (MC, 123)]], todos los catálogos conceden la paternidad de la obra a Luis Vélez de Guevara. Héctor Urzáiz apunta que, en alguna ocasión, Celos hasta los cielos se ha atribuido erróneamente a Cerveró[[ (UT, II, 700)]]. Por último hay que advertir que Lope de Vega escribió una comedia titulada La desdichada Estefanía. Morley y Bruerton fecharon la obra del Fénix en 1604[[ (MoB, 593)]], por lo tanto, es anterior a la fecha de representación que documentamos en el calendario. Para más detalles sobre la obra de Lope, véase registro correspondiente en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
      "tiene_representacion": [
        {
          "@id": "https://comedia-cortesana.local/representacion/REP000679"
        }
      ]
    },
    {
      "@id": "https://comedia-cortesana.local/representacion/REP000679",
