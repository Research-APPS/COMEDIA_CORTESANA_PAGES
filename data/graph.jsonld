        "schema:CreativeWork"
      ],
      "identifier": "CMC002456",
      "name": "Baile del soldado de la guarda",
      "titulo": "Baile del soldado de la guarda",
      "titulo_limpio": "Baile del soldado de la guarda",
      "alternateName": "",
      "tipo_obra": "otro",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=231&mode=indice&letter=b",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nCon el título de El soldado de la guardia aparece atribuido a Salvador de la Cueva en La Barrera[[ (BL, 517)]], único catálogo clásico en el que figura. María Luisa Tobar, al dar cuenta de las piezas que componían la fiesta completa que se celebró en palacio en 1685, hace la misma atribución. Se imprimió con la comedia de Polop La profetisa Casandra y leño de Meleagro (Madrid, Lorenzo García, 1685), junto al resto de piezas que formaban la fiesta completa: Loa al nombre de nuestra señora doña María Luisa de Borbón y a los años del señor Duque de Orliens su padre, un entremés titulado La mal acondicionada y un fin de fiesta con el título Los remedios de los matachines[[ (UT, II, 521-22; UT, I, 282)]]. Para más detalle sobre las piezas que acompañan este baile, véanse registros correspondientes en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
