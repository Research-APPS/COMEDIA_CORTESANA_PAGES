    {
      "@id": "https://comedia-cortesana.local/obra/CMC002502",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002502",
      "name": "Coloquio del anticristo",
      "titulo": "Coloquio del anticristo",
      "titulo_limpio": "Coloquio del anticristo",
      "alternateName": "",
      "tipo_obra": "otro",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2997&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo contamos con datos suficientes para realizar la atribución de esta obra, la cual, por ende, permanece anónima. Probablemente fue escrita por un jesuita del Colegio Máximo de San Pablo de Lima. El tema del anticristo fue trabajado por distintos dramaturgos de la época. Se conoce la representación en 1585, en el Corpus de Sevilla, de un auto anónimo titulado La venida del anticristo, que no parece guardar relación con la noticia que ahora nos concierne. Por otra parte, no se debe confundir la pieza limeña con la comedia El anticristo, atribuida a Juan Ruiz de Alarcón, ni con La venida de anticristo, atribuida a Antonio Mira de Amescua. Para más detalles se puede consultar las entradas correspondientes en CATCOM. Cabe destacar que en distintos catálogos clásicos se hace referencia a dos comedias tituladas El anticristo, una atribuida a Alarcón y otra a Lope de Vega[[ (Art, 27r; MeR, XXV; GaH, 24; MC, 11; Faj, 6v)]]; sin embargo, como se pude ver en las entradas señaladas, ya se ha comprobado que la atribución a Lope es errónea.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
