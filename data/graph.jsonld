    {
      "@id": "https://comedia-cortesana.local/obra/CMC003523",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003523",
      "name": "La coronación de romanos",
      "titulo": "La coronación de romanos",
      "titulo_limpio": "La coronación de romanos",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1776&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia La coronación de romanos, que también figura en la documentación de la época como La coronación del rey de romanos, es atribuida a Álvaro Cubillo de Aragón por Urzáiz[[ (UT, I, 275)]], quien cita un trabajo de Narciso Díaz de Escovar[[ (Díaz de Escovar, “Algunos datos...”, p. 25)]]. Sin embargo, nos parece que la atribución a Cubillo de Aragón es dudosa, ya que en el trabajo de Díaz de Escovar su nombre no se asocia directamente con La coronación de romanos, sino con una comedia que figura a continuación en el listado de comedias de Alonso de Olmedo mencionado en la noticia del calendario. No nos consta la existencia de testimonios de esta obra.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
