    {
      "@id": "https://comedia-cortesana.local/obra/CMC004234",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004234",
      "name": "Pablo el Simple",
      "titulo": "Pablo el Simple",
      "titulo_limpio": "Pablo el Simple",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1827&mode=indice&letter=p",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNinguna obra con el título Pablo el Simple aparece mencionada en los catálogos clásicos que hemos manejado. En el catálogo de Urzáiz tampoco aparece y no tenemos noticia de ningún testimonio. Hay varias obras en el calendario que tratan la vida de San Pablo pero la mayoría son autos sacramentales, San Antonio y San Pablo, La conversión de San Pablo, San Pablo y la caída de los ángeles. La comedia El horror de las montañas y portero de San Pablo, o simplemente El portero de San Pablo, que se representó en Madrid en 1636 según el calendario, es de Monroy y Silva y no parece tener nada que ver con Pablo el simple. Véanse las entradas correspondientes en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
