    {
      "@id": "https://comedia-cortesana.local/obra/CMC004041",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004041",
      "name": "Los desposorios de Isaac",
      "titulo": "Los desposorios de Isaac",
      "titulo_limpio": "Los desposorios de Isaac",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=640&mode=indice&letter=d",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLos desposorios de Isaac con Rebeca es un auto sacramental anónimo, que podría corresponder con uno de los dos autos titulados Los desposorios de Isaac recogidos en el Códice de Autos Viejos, cuyo manuscrito se conserva en la BNE bajo la signatura Ms. 14.711[[ (PM, 97-98; AM1, 237-39)]]. Por otro lado, en el mismo año de 1590 se representó en Sevilla un auto titulado Los desposorios de Isaac con Rebeca, que pensamos que es distinto del que nos ocupa: véase el registro correspondiente en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
