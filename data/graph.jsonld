      "identifier": "CMC004399",
      "name": "Todo es fácil a quien ama",
      "titulo": "Todo es fácil a quien ama",
      "titulo_limpio": "Todo es fácil a quien ama",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=175&mode=indice&letter=t",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo conservamos el texto de ninguna comedia titulada Todo es fácil a quien ama y no se menciona en ninguno de los catálogos que manejamos. San Román señaló, siguiendo a La Barrera, que aparece citada en la Loa sacramental de los títulos de comedias, atribuida sin fundamento a Lope de Vega, y consideró que se trata de una comedia perdida de Lope[[ (SR, LXXII-LXXIV; BL, 586)]]. Ante la ausencia de más datos positivos es imposible determinar la veracidad de esta atribución.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
