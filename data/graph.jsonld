    {
      "@id": "https://comedia-cortesana.local/obra/CMC003321",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003321",
      "name": "Fuenteovejuna",
      "titulo": "Fuenteovejuna",
      "titulo_limpio": "Fuenteovejuna",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3271&mode=indice&letter=f",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nFuenteovejuna es una comedia de Lope de Vega, tal como recogen todos los catálogos que manejamos[[(UT, 663; BL, 430; Art, 156v; Sal, 542; MeR, xxxiv; GaH, 76; MC, 46; Faj, f. 24r; Ch, 538, 549; MoB, 330-331)]]. Aparece en catálogos antiguos como Fuente Ovejuna aunque en las ediciones modernas ya figura como Fuenteovejuna y algún catálogo recoge variantes, como Fuente Ovejuna, todos a una, que aparece en Arteaga y Mesonero Romanos[[(Art, 156v; MeR, xxxiv)]] o La Fuente Ovejuna, en García la Huerta[[(GaH, 76)]]. Lope de Vega la incluyó en la segunda lista de El peregrino en su patria (Madrid, viuda de Alonso Martín, 1618). Apareció publicada por primera vez en la Docena Parte de las comedias de Lope de Vega Carpio (Madrid, Viuda de Alonso Martin, 1619). Se conservan dos copias manuscritas de la comedia, una en la Biblioteca Palatina de Parma (Signatura CC.* V. 28032/ XL) [[Restori, 26]] y otra perteneciente a la colección Holland en Melbury House [[(Presotto, 494)]]. Morley y Buerton fechan la composición de esta pieza en torno a 1612-1614 [[(MoB, 330-331)]]. Hay que advertir que existe otra obra con este mismo título, atribuida a Cristóbal de Monroy y Silva[[(UT, 457; BL, 264; Art, 156v; Sal, 604; MeR, xxxiv; GaH, 76; MC, 46; López Estrada)]], que es distinta a la que nos ocupa.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
