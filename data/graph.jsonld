    {
      "@id": "https://comedia-cortesana.local/obra/CMC003963",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003963",
      "name": "Lo que obliga la palabra",
      "titulo": "Lo que obliga la palabra",
      "titulo_limpio": "Lo que obliga la palabra",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=596&mode=indice&letter=l",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se conservan testimonios de ninguna comedia de este título, ni figura en los catálogos que hemos manejado. En la reciente edición de A lo que obliga el ser rey de Luis Vélez de Guevara, a cargo de Manson y Peale, con estudio introductorio de Hernández Araico, se plantea la posibilidad de que esta obra pudiese ser la misma que la titulada Lo que obliga la palabra por la similitud del título y porque Antonio de Prado representó ambas comedias[[ (L. Vélez de Guevara, A lo que obliga, p. 35)]]. No es posible determinar con las noticias disponibles si efectivamente se trata de la misma comedia, de manera que las mantenemos diferenciadas: véase la entrada correspondiente a A lo que obliga el ser rey en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
