        "schema:CreativeWork"
      ],
      "identifier": "CMC002619",
      "name": "Duelos de ingenio y fortuna",
      "titulo": "Duelos de ingenio y fortuna",
      "titulo_limpio": "Duelos de ingenio y fortuna",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "comedia",
      "estado_ficha": "cruda",
      "fuente_principal": "AMBAS",
      "pagina_pdf": 103,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1462&mode=indice&letter=d",
      "notas": "",
      "notas_bibliograficas": "Comedia de Bances Candamo. Hay manuscrito de esta «fiesta de SS. MM. al feliz cumplimiento de años del Rey nuestro señor don Carlos II, en el Coliseo Real del Buen Retiro» en la B.N.M., 16.591 (Paz, I, 171). Se imprimió en edición de lujo en Madrid: Bernardo de Villadiego, 1687 (véanse B.N.M., R.14.369; y el catálogo de la colección de don Arturo Sedó [Montaner, 35]). Salió más tarde en las Poesías cómicas de Bances (Madrid, 1722), I, 229-283 (la loa en las págs. 224-228).",
      "observaciones": "Atribución (CATCOM):\nLa comedia Duelos de ingenio y fortuna es obra de Francisco Bances Candamo, como recogen los catálogos que hemos manejado[[ (BL, 544; Art, 121; Sal, 367; MeR, 32; GaH, 61; MC, 35; UT, 152)]]. En la BNE se conserva un manuscrito de esta obra de letra de finales del siglo XVII bajo la signatura ms. 16.591[[ (PM, 171)]]. Se publicó primero en edición de lujo (Madrid, Bernardo de Villadiego, 1687)[[ (F, IX, 104)]] y posteriormente se incluyó en el tomo primero de las Poesías Cómicas, obras póstumas de D. Francisco Bances Candamo (Madrid, Blas de Villanueva, 1722)[[ (Sal, 367)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
