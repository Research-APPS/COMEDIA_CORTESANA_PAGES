    {
      "@id": "https://comedia-cortesana.local/obra/CMC004046",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004046",
      "name": "Los desposorios de Sansón",
      "titulo": "Los desposorios de Sansón",
      "titulo_limpio": "Los desposorios de Sansón",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1687&mode=indice&letter=d",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ningún auto titulado Los desposorios de Sansón en los repertorios que manejamos ni nos consta la existencia de testimonios de la obra que nos ocupa. Al tratarse de una representación temprana, de 1573, y puesto que el Códice de autos viejos contiene un auto titulado Sansón, podría pensarse que se trata de la misma obra. Sin embargo, el motivo de la composición que tratamos en este registro, si hacemos caso de su título, es muy distinto al del auto del Códice, que dramatiza el episodio del apresamiento de Sansón por los filisteos, su liberación y la destrucción de las columnas. Por esta razón, la identificación entre una y otra obra queda descartada.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
