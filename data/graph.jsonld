    {
      "@id": "https://comedia-cortesana.local/obra/CMC004827",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004827",
      "name": "El triunfo de la Iglesia (1560)",
      "titulo": "El triunfo de la Iglesia",
      "titulo_limpio": "El triunfo de la Iglesia (1560)",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1755&mode=indice&letter=t",
      "notas": "",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSánchez Arjona supuso que el auto titulado El triunfo de la Iglesia podría ser la obra de Sánchez de Badajoz titulada Farsa de la Iglesia. Sin embargo, Sentaurens menciona dicha obra como original del propio Juan de Figueroa[[ (SA, 20-21; Se, 165-67, 1149 n. 267)]], aunque no hay ningún dato que permita apoyar esta atribución. Ese título no figura en ninguno de los catálogos clásicos que hemos consultado, ni nos consta la existencia de testimonios. Existen otras obras de título similar u homónimas a la que nos ocupa que no están relacionadas con ella: una obra titulada La nave de San Pedro y triunfo de la Iglesia que fue representada en el Corpus de Sevilla en 1589, un auto de Lope de Vega titulado El triunfo de la iglesia y una comedia anónima titulada El triunfo de la iglesia representada en 1659.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
