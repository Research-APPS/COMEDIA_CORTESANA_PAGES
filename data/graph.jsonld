      "identifier": "CMC003675",
      "name": "La mentirosa verdad",
      "titulo": "La mentirosa verdad",
      "titulo_limpio": "La mentirosa verdad",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
