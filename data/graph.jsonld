      "identifier": "CMC003614",
      "name": "La gran Cenobia",
      "titulo": "La gran Cenobia",
      "titulo_limpio": "La gran Cenobia",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
