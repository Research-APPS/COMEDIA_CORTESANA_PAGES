      "identifier": "CMC004774",
      "name": "Las dueñas (1676)",
      "titulo": "Las dueñas",
      "titulo_limpio": "Las dueñas (1676)",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
