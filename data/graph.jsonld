        "schema:CreativeWork"
      ],
      "identifier": "CMC002915",
      "name": "El esclavo de Roma",
      "titulo": "El esclavo de Roma",
      "titulo_limpio": "El esclavo de Roma",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1773&mode=indice&letter=e",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl esclavo de Roma es una comedia de Lope de Vega, como recogen los catálogos clásicos que hemos consultado[[ (Faj, 21v; GaH, 69; MC, 40; Art, 136; MeR, XXXIII; BL, 547; Sal, 599; UT, II, 661)]]. La comedia se publicó en la Parte 8 de comedias del Fénix (Madrid, Viuda de Alonso Martín, 1617). Se conserva asimismo una copia manuscrita en la Biblioteca Palatina de Parma bajo la signatura CC.* V. 28032/ XXXII[[ (ARTELOPE; Pr, 185; Cacho, 167-68)]]. Por otro lado, Wilder llegó a la conclusión, tras estudiarl a primera lista de El peregrino en su patria (1604), que El esclavo de Roma fue estrenada por la compañía de Luis de Vergara, como corrobora la noticia de 1616[[ (W, 195)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
