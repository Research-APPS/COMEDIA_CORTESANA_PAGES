        "schema:CreativeWork"
      ],
      "identifier": "CMC002481",
      "name": "Cata Francia, Montesinos",
      "titulo": "Cata Francia, Montesinos",
      "titulo_limpio": "Cata Francia, Montesinos",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=215&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nAunque en la noticia de representación de la que damos cuenta se cita esta comedia como Catafrancia Montesinos[[ (E, 462-64)]], pensamos que se trata en realidad de Cata Francia, Montesinos, pues coincide con el título de un romance del Romancero viejo. En el documento mencionado en el calendario de representaciones, no se atribuye este título a autor alguno. Asimismo, ningún repertorio de los que manejamos dan cuenta de esta obra y tampoco nos consta la existencia de testimonios. Urzáiz la incluye en su catálogo como anónima[[ (UT, I, 69)]].",
