      "identifier": "CMC004250",
      "name": "Perseo",
      "titulo": "Perseo",
      "titulo_limpio": "Perseo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
