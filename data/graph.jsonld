    {
      "@id": "https://comedia-cortesana.local/obra/CMC004468",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004468",
      "name": "Ícaro",
      "titulo": "Ícaro",
      "titulo_limpio": "Ícaro",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2882&mode=indice&letter=i",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nJosé Pellicer y Tovar, al recoger la noticia de representación de este auto, menciona a Luis Vélez como autor de Ícaro, también lo cree así Cotarelo y Alenda y Mira, que sigue la noticia de Pellicer[[(CM3, 79-80; AM1, 277, V, 214, IX, 388, 497)]]. Sin embargo, Latorre y Badillo, a quien sigue Bergman, lo atribuye por error a Rojas Zorrilla[[ (Be, 538; LB, 207)]]. Este título no figura en ninguno de los catálogos clásicos que manejamos ni nos consta la existencia de testimonios de esta pieza dramática.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
