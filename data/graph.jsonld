        "schema:CreativeWork"
      ],
      "identifier": "CMC003752",
      "name": "La redención del cautivo",
      "titulo": "La redención del cautivo",
      "titulo_limpio": "La redención del cautivo",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
