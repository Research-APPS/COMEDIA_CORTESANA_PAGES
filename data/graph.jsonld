      "identifier": "CMC002891",
      "name": "El desdén vengado",
      "titulo": "El desdén vengado",
      "titulo_limpio": "El desdén vengado",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
