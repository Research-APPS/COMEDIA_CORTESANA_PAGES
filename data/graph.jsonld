    {
      "@id": "https://comedia-cortesana.local/obra/CMC002579",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002579",
      "name": "Descensión de la Virgen a dar la casulla a San Ildefonso",
      "titulo": "Descensión de la Virgen a dar la casulla a San Ildefonso",
      "titulo_limpio": "Descensión de la Virgen a dar la casulla a San Ildefonso",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1623&mode=indice&letter=d",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nDescensión de la Virgen a dar la casulla a San Ildefonso es un auto de José de Valdivielso, como se indica en la noticia de representación de 1616 que consignamos en el calendario y recogen varias fuentes consultadas[[ (GG6, 71-72, 77; BL, 595; AM1, 233-35; UT, I, 388)]]. En la BNE se conserva, con la signatura Res. 80, un manuscrito del auto con el título La descensión de Nuestra Señora en la Santa Iglesia de Toledo, cuando trujo la casulla a San Ildefonso, autógrafo del licenciado Francisco de Rojas, quien en una nota inicial escribe: “Compuesto por mi señor y grande amigo el Maestro Joseph de Valdivieso, que haya gloria”. Otra nota al final señala que la obra se acabó de trasladar en 1643[[ (PM, 147; Greer, “Manos”)]]. Por otro lado, tenemos constancia documental de la representación en 1591 de un auto titulado San Ildefonso, que no debe confundirse con el que nos ocupa.",
      "edicion_principe": "",
