    {
      "@id": "https://comedia-cortesana.local/obra/CMC002466",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002466",
      "name": "Buena sangre es lo mejor",
      "titulo": "Buena sangre es lo mejor",
      "titulo_limpio": "Buena sangre es lo mejor",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=245&mode=indice&letter=b",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEn la noticia de representación de 1627 se atribuye la comedia Buena sangre es lo mejor a Gaspar de Ávila (LL1, 177-78). Sin embargo, en los catálogos clásicos que hemos manejado esta obra aparece siempre atribuida a Francisco de Rojas Zorrilla (Art, 49r; GaH, 34; BL, 342, 532; Mac, 11; MC,18; MeR, XXVII). Urzáiz da cuenta del título como La buena sangre es lo mejor (UT, II, 567). La Barrera recoge en su catálogo la existencia de una suelta de esta comedia, sin aportar más datos (BL, 342). Sin embargo, actualmente no se conocen testimonios de esta comedia, por lo que no es posible corroborar o desmentir cualquiera de las dos identificaciones propuestas.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000089"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000089"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
      "tiene_representacion": [
        {
          "@id": "https://comedia-cortesana.local/representacion/REP000607"
        }
      ]
