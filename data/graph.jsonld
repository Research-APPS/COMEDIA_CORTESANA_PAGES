        "schema:CreativeWork"
      ],
      "identifier": "CMC003971",
      "name": "Lo que puede una sospecha",
      "titulo": "Lo que puede una sospecha",
      "titulo_limpio": "Lo que puede una sospecha",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=839&mode=indice&letter=l",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia Lo que puede una sospecha es de Antonio Mira de Amescua, como ya señaló Rennert en su día[[ (R2, 45)]]. Se atribuye a este dramaturgo en todos los catálogos clásicos que hemos manejado (Faj, 32r; MC, 63; GaH, 103; Art, 213v; MeR, XXXVIII; BL, 259). Valladares Reguero señala que se publicó en la Parte 4 del Laurel de comedias (Madrid, 1653) y que existe una suelta, sin datos bibliográficos, que atribuye la comedia a Mira de Amescua. También indica que se tiene noticia de lo que podría ser una segunda suelta u otro ejemplar de alguna de las dos ediciones mencionadas[[ (VR, 95)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
