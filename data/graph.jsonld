      "identifier": "CMC004083",
      "name": "Los palacios de Galiana",
      "titulo": "Los palacios de Galiana",
      "titulo_limpio": "Los palacios de Galiana",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
