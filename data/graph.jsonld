      ],
      "identifier": "CMC004792",
      "name": "La madre Teresa de Jesús (1624)",
      "titulo": "La madre Teresa de Jesús",
      "titulo_limpio": "La madre Teresa de Jesús (1624)",
      "alternateName": "",
      "tipo_obra": "auto",
