        "schema:CreativeWork"
      ],
      "identifier": "CMC002771",
      "name": "El abanillo",
      "titulo": "El abanillo",
      "titulo_limpio": "El abanillo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "en_revision",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=517&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa obra El abanillo es, sin lugar a dudas, de Lope de Vega. El propio dramaturgo la incluye en la segunda lista de El peregrino en su patria (1618)[[ (Per, FALTA p.)]] y con este título aparece en todos los catálogos clásicos [[ (MC, 14; GaH, 27; Art, 2r; BL, 428; MeR, XXVI)]] y demás obras de referencia que manejamos[[ (Ch, 545; MoB, 272-73; UT, II, 651; R1, 331)]]. De hecho, Morley y Bruerton incluyen esta comedia en la lista de obras auténticas de Lope y sitúan su composición en el periodo comprendido entre 1612 y 1618, probablemente hacia 1615[[ (MoB, 272-73)]]. No conservamos autógrafo de esta obra de Lope y aunque La Barrera se pregunta si pudo haber existido alguna suelta de la obra que nos ocupa, no nos consta ninguna edición contemporánea al autor (BL, 428). Hoy en día lo que se conserva es una copia manuscrita en la Biblioteca Palatina de Parma (Signatura CC.* V. 28032/ XV)[[ (ARTELOPE; MoB, 272-73)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
