    {
      "@id": "https://comedia-cortesana.local/obra/CMC003516",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003516",
      "name": "La constante bofetada",
      "titulo": "La constante bofetada",
      "titulo_limpio": "La constante bofetada",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1137&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl título de La constante bofetada no figura en ninguno de los catálogos clásicos que manejamos, mientras que Urzáiz lo incluye en su catálogo como obra anónima[[ (UT, I, 73)]]. Agustín de la Granja considera que podría ser obra de Mira de Amescua y sugiere la posibilidad de que se tratara de la obra del granadino conocida con el título de La rueda de la fortuna[[ (Gr, 72)]]. Dicha identificación entre ambos títulos entra dentro de lo posible, pero no podemos determinarlo con seguridad a partir de los datos disponibles: véase el registro correspondiente a La rueda de la fortuna en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
