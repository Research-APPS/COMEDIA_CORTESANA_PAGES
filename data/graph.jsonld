    {
      "@id": "https://comedia-cortesana.local/obra/CMC003821",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003821",
      "name": "La verdad averiguada",
      "titulo": "La verdad averiguada",
      "titulo_limpio": "La verdad averiguada",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3282&mode=indice&letter=v",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa verdad averiguada es una obra de Guillén de Castro. Figura con este título en algunos catálogos[[ (Art, 393; Gah, 192, MeR, LI; MC, 119)]]. La comedia es también conocida con otros títulos: El casamiento engañoso[[ (Art, 393; MeR, LI)]], La verdad averiguada y casamiento engañoso[[ (UT, I, 240; Faj, 53r; Sal, 660)]] y, por último, La verdad averiguada y engañoso casamiento[[ (BL, 590)]]. Con este último título se publicó en Valencia en la Segunda parte de las Comedias de don Guillen de Castro (Miguel Sorolla, 1625).",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
      "tiene_representacion": [
        {
          "@id": "https://comedia-cortesana.local/representacion/REP003227"
        }
      ]
    },
    {
      "@id": "https://comedia-cortesana.local/representacion/REP003227",
