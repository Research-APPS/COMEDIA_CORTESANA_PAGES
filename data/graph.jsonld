        "schema:CreativeWork"
      ],
      "identifier": "CMC003624",
      "name": "La historia de Carlos V",
      "titulo": "La historia de Carlos V",
      "titulo_limpio": "La historia de Carlos V",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2870&mode=indice&letter=h",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNinguno de los catálogos clásicos ni el más reciente de Urzáiz recoge una comedia con el título La historia de Carlos V, ni nos constan testimonios de la misma. Existen varias obras que contienen en su título referencia a la figura histórica de Carlos V. Podría tratarse, por ejemplo, de La mayor desgracia de Carlos V, también conocida como la primera parte de Carlos V, atribuida a Luis Vélez de Guevara; de La mayor hazaña de Carlos V, también conocida como la segunda parte de Carlos V, atribuida a Jiménez de Enciso. No tenemos suficientes datos para relacionarla con ninguna de estas u otras que traten de la figura del Emperador.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
