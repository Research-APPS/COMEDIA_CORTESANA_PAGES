      "identifier": "CMC003929",
      "name": "Las sierras de Guadalupe",
      "titulo": "Las sierras de Guadalupe",
      "titulo_limpio": "Las sierras de Guadalupe",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=749&mode=indice&letter=s",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nMérimée atribuyó Las sierras de Guadalupe a Lope de Vega[[ (M, 169)]] al dar cuenta de la noticia de representación de 1624, aunque Morley y Buerton consideran dudosa la autoría del Fénix[[ (MoB, 606)]]. La atribución a Lope figura en catálogos como los de Medel del Castillo, García de la Huerta, Arteaga, Mesonero Romanos y La Barrera[[ (MC, 108; GaH, 174; Art, 354r; MeR, XLVIII; BL, 454)]], así como en las dos ediciones sueltas que se conocen de Las sierras de Guadalupe, ambas sin datos bibliográficos[[ (ARTELOPE)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
