        "schema:CreativeWork"
      ],
      "identifier": "CMC003049",
      "name": "El mejor lirio francés",
      "titulo": "El mejor lirio francés",
      "titulo_limpio": "El mejor lirio francés",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2115&mode=indice&letter=m",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl mejor lirio francés tan solo se recoge en dos de los catálogos consultados: el de La Barrera y el de Arteaga[[ (BL, 531; Art, 47v)]], pero probablemente se refieren a la obra atribuida a Agustín Moreto El más ilustre francés, San Bernardo, impresa en 1658 en la Parte 21 de Comedias nuevas escogidas de los mejores ingenios de España (Madrid, Gregorio Rodríguez)[[ (UT, II, 470)]]. Sin embargo, la posible representación en 1620 que documentamos en el calendario no puede corresponder con la obra de Moreto (1618-1669), puesto que, según Kennedy, esta obra es probablemente de 1658[[ (K, 20)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
