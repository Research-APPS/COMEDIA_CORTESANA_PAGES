      ],
      "identifier": "CMC003547",
      "name": "La demanda que pone el demonio al género humano",
      "titulo": "La demanda que pone el demonio al género humano",
      "titulo_limpio": "La demanda que pone el demonio al género humano",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2332&mode=indice&letter=d",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSegún Sentaurens, La demanda que pone el demonio al género humano también es mencionado en la documentación de Sevilla como El pleito que pone el demonio a la naturaleza humana[[ (Se, 1137 n. 186)]]. Ninguno de estos títulos figura en los catálogos consultados. Asimismo, no tenemos constancia de la existencia de testimonios de esta obra. Por otro lado, tanto Sánchez Arjona como Sentaurens, afirman que el que proporcionó la letra para el auto La demanda que pone el demonio al género humano fue Luis Díaz, dorador y vecino de Sevilla[[ (SA, 54-56; Se, 1119 n. 64, 1260)]], de donde se podría deducir que Díaz compuso este auto, aunque también entra dentro de lo posible que simplemente fuese quien proporcionó la copia.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
