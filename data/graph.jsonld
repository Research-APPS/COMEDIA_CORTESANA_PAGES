      "identifier": "CMC003566",
      "name": "La engañosa burlada",
      "titulo": "La engañosa burlada",
      "titulo_limpio": "La engañosa burlada",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
