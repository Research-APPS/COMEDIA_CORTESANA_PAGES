      ],
      "identifier": "CMC003951",
      "name": "Llamados y escogidos",
      "titulo": "Llamados y escogidos",
      "titulo_limpio": "Llamados y escogidos",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
