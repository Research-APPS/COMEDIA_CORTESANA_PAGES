    {
      "@id": "https://comedia-cortesana.local/obra/CMC004233",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004233",
      "name": "Otón",
      "titulo": "Otón",
      "titulo_limpio": "Otón",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1786&mode=indice&letter=o",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia mencionada como Otón en la documentación de la época corresponde a la obra de Lope de Vega más conocida como La imperial de Otón[[ (Faj, 23r; MC, 56; GaH, 93; Art, 189r; MeR, XXXVI; BL, 556; UT, II, 666)]]. Figura en la lista de comedias de Lope incluida en la segunda edición de El peregrino en su patria bajo el título de Rodulfo y Otón[[ (MoB, 228; UT, II, 666)]]. Esta comedia se publicó con el título de La imperial de Otón en la Parte VIII de comedias del Fénix (Madrid, Viuda de Alonso Martín, 1617), aunque en la despedida de la obra se menciona el título como La imperial. Se conservan asimismo dos copias manuscritas de esta comedia. La primera, que lleva por título La imperial, es una copia apógrafa del siglo XVIII que forma parte de la colección Gálvez y que se conservar en la BNE bajo la signatura Ms. 22.424. La segunda copia manuscrita se conserva en la Biblioteca Palatina de Parma bajo la signatura CC.* V. 28032/ XXXIII[[ (ARTELOPE; Pr, 185; Cacho, 171-72)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
