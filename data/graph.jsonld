    {
      "@id": "https://comedia-cortesana.local/obra/CMC002487",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002487",
      "name": "Celos con celos se curan",
      "titulo": "Celos con celos se curan",
      "titulo_limpio": "Celos con celos se curan",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1886&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEn la Biblioteca Nacional de España, signatura Ms. 16809, se conserva una copia manuscrita de Celos con celos se curan, de Tirso de Molina. Paz y Melia aclara que esta comedia se publicó a nombre de Lope de Vega[[ (PM, 89)]]. Efectivamente, Celos con celos se curan se publicó apócrifamente a nombre de Lope de Vega en la Parte 27 de Extravagante en 1633[[ (Pr, 62-63)]], y algunos catálogos la atribuyen este título al Fénix[[ (Faj, 55r; MC, 123; Art, 64v; GaH, 198)]]. No obstante, es obra de Tirso de Molina y algunos repertorios así lo refrejan[[ (Hes, 799; UT, II, 627)]]. A nombre del mercedario aparece en otros repertorios[[ (BL, 534; Sal, 548; MeR, XXVIII)]] y en los testimonios impresos en forma de suelta que a su nombre se conservan[[ (Moll, 28; BS, 228; MPR, 134)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
