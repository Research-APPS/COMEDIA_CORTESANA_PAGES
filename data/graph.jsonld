    {
      "@id": "https://comedia-cortesana.local/obra/CMC002943",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002943",
      "name": "El galán agradecido",
      "titulo": "El galán agradecido",
      "titulo_limpio": "El galán agradecido",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2453&mode=indice&letter=g",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nComo se ha indciado, Lope de Vega incluyó El galán agradecido en la lista de comedias que figura en la primera edición de El peregrino en su patria (1604). Con esta atribución figura el título en varios de los catálogos consultados (UT, 652; BL, 430, 551; MeR, XXXIV; Art, 159r). Aunque no se conserva el texto de ninguna pieza titulada precisamente El galán agradecido, Morley y Bruerton propusieron que sería la obra que se publicó en la Parte 10 de las comedias de Lope (Barcelona, Sebastián de Cormellas, 1618) como El amante agradecido[[ (MoB, 48, 80, 146, 592)]]. Dichos estudiosos han fechado la composición de esta obra hacia 1602, lo cual resulta importante para sustentar la tesis de que en 1604 ya se encuentra en la lista de El peregrino, aunque con el título de El galán agradecido. Los editores más modernos de El amante agradecido, Omar Sanz y María Dolores Gómez Martín, concuerdan con Morley y Bruerton[[ (2010, 633)]]. Para más información sobre esta comedia y sus testimonios remitimos a la edición citada.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
