      "identifier": "CMC002787",
      "name": "El amor al uso",
      "titulo": "El amor al uso",
      "titulo_limpio": "El amor al uso",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
