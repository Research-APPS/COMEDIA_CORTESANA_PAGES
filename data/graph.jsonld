      ],
      "identifier": "CMC004464",
      "name": "¿Quién hallará mujer fuerte?",
      "titulo": "¿Quién hallará mujer fuerte?",
      "titulo_limpio": "¿Quién hallará mujer fuerte?",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "en_revision",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=85&mode=indice&letter=q",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa atribución de ¿Quién hallará mujer fuerte? a Pedro Calderón de la Barca no plantea problemas. La obra se publicó en la Primera Parte de los Autos Sacramentales de Calderón (Madrid, Fernández Buendía, 1677). Para una descripción detallada de los testimonios manuscritos e impresos conservados, véase la edición de I. Arellano y L. Galván[[ (¿Quién hallará...?, 2001, pp. 28-31)]]. Conservamos la memoria de las apariencias del auto que fue publicada, en su momento, por Shergold y Varey, y ha sido reeditada posteriormente en la mencionada edición[[ (PP, 330-32; SV5, 233-34; CM9, X, 18; Pa, 222-223; Wi, 97)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
