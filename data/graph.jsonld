      "identifier": "CMC002911",
      "name": "El ejemplo mayor de la desdicha y capitán Belisario",
      "titulo": "El ejemplo mayor de la desdicha y capitán Belisario",
      "titulo_limpio": "El ejemplo mayor de la desdicha y capitán Belisario",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
