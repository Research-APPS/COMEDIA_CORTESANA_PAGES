      "identifier": "CMC003618",
      "name": "La hermosa Florinda",
      "titulo": "La hermosa Florinda",
      "titulo_limpio": "La hermosa Florinda",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
