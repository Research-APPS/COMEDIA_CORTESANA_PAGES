      "identifier": "CMC004066",
      "name": "Los hechos del maestro Pelayo Correa",
      "titulo": "Los hechos del maestro Pelayo Correa",
      "titulo_limpio": "Los hechos del maestro Pelayo Correa",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2371&mode=indice&letter=h",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia Los hechos del maestro Pelayo Correa no aparece mencionada en los catálogos clásicos ni en los más recientes que manejamos ni consta atribución alguna de la autoría. El personaje de Pelayo Correa, fue maestro de la Orden de Santiago en Uclés, en el siglo XIII, y no ha de confundirse con Don Pelayo, protagonista de numerosas obras dedicadas a la legendaria fundación del reino de Asturias y a los inicios de la reconquista.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
