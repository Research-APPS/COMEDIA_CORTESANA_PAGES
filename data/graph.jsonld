    {
      "@id": "https://comedia-cortesana.local/obra/CMC003890",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003890",
      "name": "Las ferias del mundo",
      "titulo": "Las ferias del mundo",
      "titulo_limpio": "Las ferias del mundo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1072&mode=indice&letter=f",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nPor las razones expuestas en el calendario, es difícil saber si Las ferias del mundo era un auto o una comedia. De todos modos, no se menciona en los catálogos que manejamos ninguna comedia ni ningún auto titulados Las ferias del mundo ni nos consta la existencia de testimonios de una obra de este título. Domínguez Búrdalo, al recoger la confusa noticia del dietario de Sommaia cita la representación salmantina de 1604 como “Las ferias del mundo, Autos de Valladolid” preguntándose si se trataría de una obra o dos[[ (DES, 148; D. Búrdalo, p. 200)]]. Urzáiz, partiendo de Domínguez Búrdalo, recoge la obra con el título Las ferias del mundo. Autos de Valladolid y la considera una única obra anónima[[ (UT, I, 85)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
