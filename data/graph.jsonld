      "identifier": "CMC004059",
      "name": "Los esclavos libres",
      "titulo": "Los esclavos libres",
      "titulo_limpio": "Los esclavos libres",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
