      "identifier": "CMC003155",
      "name": "El rayo de Cataluña y prodigio de Aragón (primera parte)",
      "titulo": "El rayo de Cataluña y prodigio de Aragón (primera parte)",
      "titulo_limpio": "El rayo de Cataluña y prodigio de Aragón (primera parte)",
      "alternateName": "",
