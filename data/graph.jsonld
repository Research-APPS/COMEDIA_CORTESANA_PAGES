      ],
      "identifier": "CMC003122",
      "name": "El primer conde de Flandes",
      "titulo": "El primer conde de Flandes",
      "titulo_limpio": "El primer conde de Flandes",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=828&mode=indice&letter=p",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl primer conde de Flandes es una comedia que se considera actualmente obra de Antonio Mira de Amescua, aunque también se ha atribuido a Fernando de Zárate. Se publicó por primera vez en la Parte 29 de la colección de Comedias escogidas (Madrid, José Fernández de Buendía, 1688) con atribución a Fernando de Zárate[[ (CM15, 627-630)]], mientras que en la BNE se conserva una copia manuscrita del siglo XVII, con la signatura Ms. 16688 y atribución a Mira de Amescua[[ (PM, 447; Manos; VR, 140-41)]]. Casi todos los catálogos clásicos que manejamos atribuyen la comedia a Zárate[[ (Art, 299v; MeR, XLIII; GaH, 146; MC, 91)]], exceptuando el catálogo de Salvá, que atribuye la obra a Mira de Amescua y la distingue de una homónima de Zárate[[ (Sal, 638)]], y el de La Barrera, que atribuye El primer conde de Flandes a Mira de Amescua y también a Zárate[[ (BL, 574)]]. Miguel Martínez Aguilar, editor reciente de la comedia, tras cotejar ambas copias, concluye que se trata de dos versiones del mismo texto, cuya autoría no duda en conceder Mira de Amescua[[ (Antonio Mira de Amescua, Teatro completo. Volumen 1, Agustín de la Granja (Coord.), Granada, Universidad de Granada, 2001, pp. 487-617)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
