    {
      "@id": "https://comedia-cortesana.local/obra/CMC003508",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003508",
      "name": "La cena de Cristo pleiteada",
      "titulo": "La cena de Cristo pleiteada",
      "titulo_limpio": "La cena de Cristo pleiteada",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2625&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ningún auto titulado La cena de Cristo pleiteada en los catálogos clásicos que manejamos ni nos consta la existencia de testimonios de esta obra. Tampoco Alenda y Mira menciona en su catálogo obra alguna con este título. Hay que advertir que existe una obra titulada La cena de Cristo de Rojas Zorrilla, que es posterior al auto que nos ocupa. Marcos Álvarez, por su parte apunta a la semejanza en el título de este auto con el titulado Un pleito de alimentos que pone el hombre a Cristo que se representó en 1593[[ (F, XVII, 63-64)]], pero nos parece que se trata de obras diferentes.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
