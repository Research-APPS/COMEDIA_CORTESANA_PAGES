    {
      "@id": "https://comedia-cortesana.local/obra/CMC003771",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003771",
      "name": "La santa de mala fama",
      "titulo": "La santa de mala fama",
      "titulo_limpio": "La santa de mala fama",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1456&mode=indice&letter=s",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa única referencia a una obra titulada La santa de mala fama se halla en la noticia de representación de 1609 de la que hemos dado cuenta. Este título no figura en ninguno de los catálogos clásicos que hemos manejado ni nos consta la existencia de testimonios de esta obra, que consideramos por lo tanto anónima, como también hace Urzáiz, quien la recoge a partir de la noticia de 1609 que incluimos en el calendario[[ (UT, I, 122)]].",
      "edicion_principe": "",
