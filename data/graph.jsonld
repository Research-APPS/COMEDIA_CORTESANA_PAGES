        "schema:CreativeWork"
      ],
      "identifier": "CMC003020",
      "name": "El llegar en ocasión",
      "titulo": "El llegar en ocasión",
      "titulo_limpio": "El llegar en ocasión",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2287&mode=indice&letter=l",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nTal y como se indica en la noticia de representación de 1616[[ (DM1, 284-86)]] y recogen varios de los catálogos consultados[[ (Faj, 33r; GaH, 101; Art, 217; MeR, XXXVIII; BL, 560; UT, II, 669; MoB, 349-50)]], la comedia El llegar en ocasión es obra de Lope de Vega. Esta comedia se publicó en la Parte VI (Madrid, Viuda de Alonso Martín, 1615) de comedias del Fénix. Se conserva asimismo una copia manuscrita en la BNE bajo la signatura Ms. 16.646[[ (ARTELOPE; PM, 321)]]. Tenemos constancia de la existencia de un auto con el mismo título: véase el registro correspondiente en CATCOM.",
