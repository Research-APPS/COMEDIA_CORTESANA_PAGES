      "identifier": "CMC003066",
      "name": "El mármol de Felisardo",
      "titulo": "El mármol de Felisardo",
      "titulo_limpio": "El mármol de Felisardo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
