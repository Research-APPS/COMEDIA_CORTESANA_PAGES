      ],
      "identifier": "CMC002598",
      "name": "Don Gil de las calzas verdes",
      "titulo": "Don Gil de las calzas verdes",
      "titulo_limpio": "Don Gil de las calzas verdes",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
