    {
      "@id": "https://comedia-cortesana.local/obra/CMC003886",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003886",
      "name": "Las famosas asturianas y rey don Alfonso",
      "titulo": "Las famosas asturianas y rey don Alfonso",
      "titulo_limpio": "Las famosas asturianas y rey don Alfonso",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2256&mode=indice&letter=f",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLas famosas asturianas y rey don Alfonso es la misma comedia que Las famosas asturianas, de Lope de Vega[[ (SR, LXXII, 174; Artelope)]]. En la Biblioteca Palatina de Parma, signatura CC* V. 28032/XXXIX, se conserva una copia manuscrita atribuida a Lope de Las famosas asturianas[[ (MCacho, 190, 494)]]. Con este título, que figura en los últimos versos de la tercera jornada, se publicó en la Parte 18 de las comedias del autor (Madrid, Juan González, 1623) y así a parece en los catálogos clásicos que manejamos[[ (BL, 529; Art, 146v; Sal, 572; MeR, XXXIII; GaH, 72; MC, 43)]]. Las famosas asturianas aparece en la segunda lista de El peregrino en su patria (1618) con el título Las asturianas, nombre que también recogen algunos catálogos[[ (Artelope, BL, 529; Sal, 572; MeR, XXXIII)]]. Arteaga, por su parte, añade el título Las asturianas famosas[[ (Art, 146v)]]. En todos los casos la obra aparece atribuida al Fénix. Morley y Bruerton no dudan de la fiabilidad de esta atribución y consideran que fue compuesta probablemente en 1612[[ (Artelope; MoB, 596)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
