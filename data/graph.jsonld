      "identifier": "CMC003031",
      "name": "El marqués de las Navas",
      "titulo": "El marqués de las Navas",
      "titulo_limpio": "El marqués de las Navas",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
