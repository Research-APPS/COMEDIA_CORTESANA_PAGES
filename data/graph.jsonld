        "schema:CreativeWork"
      ],
      "identifier": "CMC003042",
      "name": "El mayor trance de honor",
      "titulo": "El mayor trance de honor",
      "titulo_limpio": "El mayor trance de honor",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=564&mode=indice&letter=m",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl mayor trance de honor es obra de Jacinto Cordero, tal y como se indica en varios de los catálogos clásicos que manejamos[[ (BL, 563; Art, 237v; MeR, XIL; MC, 69)]] y en el más reciente de Héctor Urzáiz[[ (UT, I, 267)]]. En la BNE se conserva, con la signatura Res. 185, el manuscrito autógrafo firmado en Lisboa a nombre de Jacinto Cordero [[ (PM, 346)]]. Se publicó en el volumen Seis comedias famosas (Lisboa, Pedro Craesbeeck, 1630) de obras de Cordeiro. Según La Barrera y Paz y Melia, se publicó en forma de suelta, aunque no hemos localizado más datos de esta edición (BL, 100; PM, 346). La identificación de la comedia titulada Trances de honor con El mayor trance de honor de la noticia del calendario de 1628 ya la propuso Urzáiz [[ (UT, II, 450-51)]] y nos parece verosímil, tanto por la similitud en el título como por el hecho de que el manuscrito autógrafo de El mayor trance de honor contiene un reparto vinculado a la compañía de Jerónimo Almella. En el inventario al que se refiere el documento de 1628, Mémimée lee como posible atribución de la comedia bien Guillén de Castro, bien Luis Vélez. En cambio, Esquerdo atribuye la obra a Mira de Amescua. Todas ellas son atribuciones erróneas.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
