        "schema:CreativeWork"
      ],
      "identifier": "CMC003956",
      "name": "Lo mejor es lo mejor",
      "titulo": "Lo mejor es lo mejor",
      "titulo_limpio": "Lo mejor es lo mejor",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "zarzuela",
      "estado_ficha": "cruda",
      "fuente_principal": "FUENTESIX",
      "pagina_pdf": 1,
      "mecenas": "",
      "musica_conservada": true,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "",
      "notas": "",
      "notas_bibliograficas": "Según Barrera, 71, Lo mejor es lo mejor, o antes que amor es la patria, y primer cerco de Roma es de Antonio Folch de Cardona, impresa en Madrid en 1683, y escrita para las fiestas del casamiento de Carlos II con María Luisa de Borbón. En la B.N.M. hay el manuscrito con loa y tres sainetes, 16.518; y además cinco copias manuscritas: 14.766, 9.401, 16.302, 16.077 y 16.647 (Paz, I, 294). Hay copia manuscrita en la B.M.M. (Cambronero); y otra en la Biblioteca Municipal de Valencia, Teatro antiguo español, tomo IX, sig. 2.952/144 (véase Evangelina Rodríguez, en Teatro y prácticas escénicas, II [Londres, 1986], 360–362). Hay música del siglo XVIII por el P. Antonio Soler en el Archivo de Música del Monasterio de San Lorenzo el.",
      "observaciones": "",
      "edicion_principe": "Madrid en 1683",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
