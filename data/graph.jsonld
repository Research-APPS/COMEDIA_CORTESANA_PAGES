    {
      "@id": "https://comedia-cortesana.local/obra/CMC003249",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003249",
      "name": "El triunfo de la Iglesia",
      "titulo": "El triunfo de la Iglesia",
      "titulo_limpio": "El triunfo de la Iglesia",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1756&mode=indice&letter=t",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl triunfo de la Iglesia figura sin atribución en la noticia de representación de 1659 y este título no figura en ninguno de los catálogos clásicos que hemos consultado ni nos consta la existencia de ejemplares. Existe un auto sacramental homónimo de Lope de Vega[[ (UT, II, 689)]], pero nos parece que no puede identificarse con la obra que nos ocupa dado que en la noticia del calendario se identifica esta obra como una “comedia vieja”[[ (F, XXXVI, 500-501)]]. Hay también otros autos sacramentales del siglo XVI de título idéntico que nada tienen que ver con la comedia que nos ocupa.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
