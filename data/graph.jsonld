    {
      "@id": "https://comedia-cortesana.local/obra/CMC002839",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002839",
      "name": "El capuchino español",
      "titulo": "El capuchino español",
      "titulo_limpio": "El capuchino español",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=801&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl capuchino español es una comedia que figura como anónima en todos los catálogos que hemos consultado[[ (UT, I, 68; BL, 533; Art, 56v; Art, 114r; MeR, XXVII, XXXI; GaH, 37; MC, 19; F, IX, 74)]], donde también aparece con las variantes de título El capuchino español, don Tiburcio de Reding[[ (UT, I, 68; BL, 533; F, IX, 74)]], Don Tiburcio Redin[[ (Art, 56v; GaH, 37)]] o Don Tiburcio de Redin[[ (Art, 114r)]]. La Barrera[[ (BL, 533)]] fecha El capuchino español en el segundo tercio del siglo XVIII, pero Shergold y Varey señalan que La Barrera se estaría refiriendo posiblemente a una refundición dieciochesca de esta comedia[[ (F, IX, 74)]]. Se publicó suelta en Madrid en 1747[[ (UT, I, 68; catálogo de la British Library)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
