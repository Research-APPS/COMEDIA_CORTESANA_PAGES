        "schema:CreativeWork"
      ],
      "identifier": "CMC004371",
      "name": "Sin secreto no hay amor",
      "titulo": "Sin secreto no hay amor",
      "titulo_limpio": "Sin secreto no hay amor",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2034&mode=indice&letter=s",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLos catálogos clásicos y el más reciente de Urzáiz atribuyen este título a Lope de Vega[[(ARTELOPE; MoB, 99; Ch, 98; UT, II, 512, 681; BL, 434; Art, 355v; MeR, XLVIII; GaH, 174; MC, 168; Presotto, 2000: 363)]]. Urzáiz informa de que fue atribuida a Montalbán en una suelta sin datos de imprenta, pero afirma que es de Lope. En el British Museum de Londres se conserva el manuscrito autógrafo de Sin secreto no hay amor de Lope de Vega, fechado en Madrid el 18 de julio de 1626, con signatura Ms. Egerton 548. En la BNE, se encuentra una copia manuscrita del autógrafo con letra del XIX, signatura Ms. 14.995 [[(PM, 515)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
