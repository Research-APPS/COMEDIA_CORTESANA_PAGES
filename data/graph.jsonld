      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=251&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEnríquez Gómez, en el prólogo de su poema Sansón Nazareno, impreso en Ruan, 1636, cita como suya La casa de Austria en España[[ (BL, 141, 533)]]. Además, la comedia aparece en el Índice de Arteaga atribuida a Antonio Enríquez Gómez[[ (Art, 58r)]], y la misma atribución recoge Urzáiz[[ (UT, I, 300)]]. La Barrera y Urzáiz señalan que existe una suelta de esta comedia[[ (BL, 141; UT, I, 300)]], aunque no ofrecen los datos bibliográficos y Glen Dille indica que no se tiene constancia de la existencia de ningún testimonio de esta obra[[ (Glen F. Dille, Antonio Enríquez Gómez, Boston, Twayne Publishers, 1988, p. 22)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
