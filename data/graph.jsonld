      "identifier": "CMC002586",
      "name": "Di mentira y sacarás verdad",
      "titulo": "Di mentira y sacarás verdad",
      "titulo_limpio": "Di mentira y sacarás verdad",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
