    {
      "@id": "https://comedia-cortesana.local/obra/CMC004081",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004081",
      "name": "Los nuevos mártires de Argel",
      "titulo": "Los nuevos mártires de Argel",
      "titulo_limpio": "Los nuevos mártires de Argel",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=413&mode=indice&letter=n",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLos nuevos mártires de Argel aparece atribuida a Lope de Vega en el documento de 1628 del que damos cuenta en las noticias de representación. A partir de esta noticia, recoge Urzáiz recoge la información de que se trata de una comedia “desconocida a nombre de Lope” [[ (UT, II, 674)]]. El título se conoce solamente a través del documento publicado por Esquerdo[[ (E, 434-36)]]. Ni Chorley ni Morley y Bruerton incluyen la comedia en sus obras y no figura en ninguno de los catálogos clásicos que hemos manejado. Por tanto, no nos consta la existencia de testimonios de esta obra.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
