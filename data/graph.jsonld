      "name": "El nuevo rey Gallinato",
      "titulo": "El nuevo rey Gallinato",
      "titulo_limpio": "El nuevo rey Gallinato",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
