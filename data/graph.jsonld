    {
      "@id": "https://comedia-cortesana.local/representacion/REP001799",
      "@type": [
        "cmc:Representacion",
        "schema:Event"
      ],
      "identifier": "REP001799",
      "name": "1630-10-19",
      "startDate": "1630-10-19",
