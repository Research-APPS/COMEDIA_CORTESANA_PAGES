    {
      "@id": "https://comedia-cortesana.local/obra/CMC004384",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004384",
      "name": "También se ama en el abismo",
      "titulo": "También se ama en el abismo",
      "titulo_limpio": "También se ama en el abismo",
      "alternateName": "",
      "tipo_obra": "zarzuela",
      "genre": "tragedia",
      "estado_ficha": "en_revision",
      "fuente_principal": "AMBAS",
      "pagina_pdf": 223,
      "mecenas": "",
      "musica_conservada": true,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1387&mode=indice&letter=t",
      "notas": "",
      "notas_bibliograficas": "Zarzuela de Salazar y Torres, impresa en Escogidas XXXVIII (Madrid, 1672), 87-124: «Fiesta de zarzuela, a los años de la Reyna nuestra Señora Doña María Ana de Austria.» A pesar de esta aserveración, O'Connor, Hispanófila, núm. 67 (1979), 76-78, demuestra que se escribió para festejar el cumpleaños de Carlos II, el 6 de noviembre de 1670. Según Barrera, 289, José Ortí y Moles añadió una tercera jornada a esta obra, después de la muerte de Salazar y Torres, para una representación en la academia del Alcázar de Valencia en 1680.",
      "observaciones": "Atribución (CATCOM):\nTambién se ama en el abismo es una obra atribuida a Agustín de Salazar y Torres[[(Art, 365; GaH, 179 F, IX, 222; Sal, 652; UT, II, 492, 592)]]. No obstante, según La Barrera, José Ortí y Moles añadió una tercera jornada a esta obra después de la muerte de Salazar y Torres, para una representación en la Academia del Alcázar de Valencia en 1680[[(BL, 289; ]]. No es posible saber si esta versión refundida fue la empleada para alguna de las representaciones posteriores a esta fecha, de las que damos cuenta en el calendario. La obra fue impresa con atribución a Agustín de Salazar en la Parte 38 de la colección de Comedias Escogidas (Madrid, Lucas Antonio de Bedmar, 1672) con la indicación: “Fiesta de zarzuela, a los años de la Reyna nuestra Señora Doña María Ana de Austria”[[(CM15, 809; F, IX, 222)]] y posteriormente se publicó en el segundo tomo del volumen titulado Cítara de Apolo: Loas y comedias diferentes (Madrid, Francisco Sanz, 1681) junto a la loa que, como indica Thomas Austin O'Connor, se refiere a una reposición de la zarzuela para celebrar los años de Carlos II. Se conservan asimismo varias ediciones sueltas de esta comedia, sin datos bibliográficos, de los siglos XVII y XVIII recopiladas por O'Connor[[(O'Connor, 2006, p. 7, pp. 33-34; VE, 171-72; MPR, 121)]].",
      "edicion_principe": "Escogidas XXXVIII (Madrid",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
