      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=274&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia de El afanador de Utrera es obra de Luis de Belmonte Bermúdez, como recogen varios catálogos clásicos que hemos manejado, como Arteaga, La Barrera o Urzáiz[[ (Art, 7; BL, 524; UT, I, 161)]]. La comedia se publicó a nombre de este dramaturgo en la Parte 32 de la colección de Comedias Escogidas (Madrid, Andrés García de la Iglesia, 1669)[[ (CM15, 777, 781)]]. Se publicó también en forma de suelta; tenemos noticia de un ejemplar impreso en Sevilla (José Antonio de Hermosilla, s.a.)[[ (BS, 24-25)]] y uno impreso en Valencia, del que da noticia Fajardo[[ (Faj, 3r)]], aunque parece que no se conserva actualmente ningún ejemplar de esta edición valenciana.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
