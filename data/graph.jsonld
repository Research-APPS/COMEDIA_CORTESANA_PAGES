    {
      "@id": "https://comedia-cortesana.local/obra/CMC002438",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002438",
      "name": "Angélica",
      "titulo": "Angélica",
      "titulo_limpio": "Angélica",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=193&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia que figura en el documento de 1616 simplemente como Angélica es la comedia más conocida por el título de Angélica en el Catay, obra de Lope de Vega[[ (MoB, 50, 81)]]. Angélica en el Catay fue mencionda por Lope en la primera lista de El peregrino en su patria (1604), por lo tanto tuvo que representarse antes de esta fecha. Thornton Wilder, tras estudiar este listado de comedias, llegó a la conclusión de que, de las obras allí citadas, Luis de Vergara habría estrenado esta obra, como corrobora la noticia de 1616 que recopilamos en el calendario. La comedia se publicó en la Parte 8 de comedias del Fénix (Madrid, Viuda de Alonso Martín, 1617) y se conserva asimismo una copia manuscrita en la Biblioteca Palatina de Parma bajo la signatura CC.* V. 28032/XXXV[[ (ARTELOPE; Cacho, 178)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
