        "schema:CreativeWork"
      ],
      "identifier": "CMC002551",
      "name": "Cómo se quita el amor",
      "titulo": "Cómo se quita el amor",
      "titulo_limpio": "Cómo se quita el amor",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=308&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEn los catálogos clásicos que hemos manejado no figura ninguna obra con el título de Cómo se quita el honor, ni tampoco con el de Cómo se quita el amor y no nos consta la existencia de testimonios conservados de las mismas. Existe una comedia de Pérez de Montalbán de título similar Cómo se guarda el honor que según Parker fue compuesta en torno a 1633. En este caso no podría ser la que nos ocupa por cuestiones cronológicas[[ (Pr1, 240)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
