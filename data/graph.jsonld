      "identifier": "CMC003206",
      "name": "El secreto bien guardado",
      "titulo": "El secreto bien guardado",
      "titulo_limpio": "El secreto bien guardado",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
