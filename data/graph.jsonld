    {
      "@id": "https://comedia-cortesana.local/obra/CMC002473",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002473",
      "name": "Carlos V",
      "titulo": "Carlos V",
      "titulo_limpio": "Carlos V",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2110&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNinguno de los catálogos clásicos ni el más reciente de Urzáiz recoge una comedia con este título ni nos constan testimonios de la misma. Existen varias comedias que contienen el nombre de Carlos V en el título o que tratan sobre el Emperador. No obstante, por la fecha de representación, creemos que podría tratarse de La mayor desgracia de Carlos V, también conocida como la primera parte de Carlos V, atribuida a Luis Vélez de Guevara; de La mayor hazaña de Carlos V, también conocida como la segunda parte de Carlos V, atribuida a Jiménez de Enciso; o de Carlos V en Francia, atribuida a Lope de Vega. Para más información, remitimos a los registros correspondientes en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
      "tiene_representacion": [
        {
          "@id": "https://comedia-cortesana.local/representacion/REP000628"
        }
      ]
    },
    {
      "@id": "https://comedia-cortesana.local/representacion/REP000628",
