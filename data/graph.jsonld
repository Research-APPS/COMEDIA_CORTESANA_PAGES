        "schema:CreativeWork"
      ],
      "identifier": "CMC003242",
      "name": "El tirano castigado",
      "titulo": "El tirano castigado",
      "titulo_limpio": "El tirano castigado",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=442&mode=indice&letter=t",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEsta comedia de Lope de Vega aparece citada en los dos listados de El peregrino en su patria (1604, 1618)[[ (ARTELOPE; UT, II, 682; MoB, 259-60; BL, 432; Art, 370r; Sal, 538; MeR, XLIX; GaH, 181; Faj, 50r; MC, 112; Ch, 555)]]. En la BNE, se conserva una copia apógrafa procedente de la colección Gálvez con signatura Mss. 22422, ff. 59r-119r. Por ella sabemos que Lope firmó el original el 17 de julio de 1599. La comedia se publicó en la Parte 4 de las comedias del dramaturgo (Madrid, Miguel Serrano de Vargas, 1614). En la Biblioteca de la Universidad de Sevilla, se conserva una copia manuscrita con letra del siglo XIX, signatura Ms. A 250/155(06). Para los detalles bibliográficos, consúltese la edición de Margarita Freixas[[ (2002)]]. No hay que confundir esta comedia con el auto de Lope de Vega del mismo título. Por otro lado, existe una refundición, que lleva el mismo título, mismo título de Juan Bautista Diamante.",
      "edicion_principe": "",
