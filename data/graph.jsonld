      "identifier": "CMC004337",
      "name": "San Raimundo",
      "titulo": "San Raimundo",
      "titulo_limpio": "San Raimundo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
