        "schema:CreativeWork"
      ],
      "identifier": "CMC003926",
      "name": "Las pruebas de Cristo",
      "titulo": "Las pruebas de Cristo",
      "titulo_limpio": "Las pruebas de Cristo",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2445&mode=indice&letter=p",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLas pruebas de Cristo es un auto sacramental de Antonio Mira de Amescua. Tanto Alenda y Mira como Valladares Reguero, Cotarelo y Héctor Urzáiz atribuyen la obra a Mira de Amescua[[ (AM1, 105; VR, 145; CM14, 77; UT, II, 452)]]. Por lo que respecta a los repertorios clásicos, sólo Mesonero Romanos atribuye Las pruebas de Cristo a Mira de Amescua[[ (MeR, XLIV)]], pues el resto de catálogos la incluyen como una obra anónima[[ (Art, 429r; GaH, 216; MC, 132)]]. Las pruebas de Cristo se publicó a nombre de Mira de Amescua en Autos sacramentales (Madrid, María de Quiñones, 1655) y luego en Autos de los mejores ingenios (Madrid, 1675). En la BNE se conserva, con la signatura Ms. 16690, una copia manuscrita del siglo XVII con el título Las pruebas de Cristo[[ (PM, 456-457)]]. Debemos advertir que, en el libro de escribanía que mencionamos en la noticia de 1651 del calendario, se atribuyen los dos autos representados en ese año a Calderón de la Barca, pero Sánchez Arjona cree que Las pruebas de Cristo sería en realidad el auto de Mira de Amescua[[ (SA, 393)]]. Como señala Ángel Valbuena Prat, Calderón se inspiró en el auto de Mira para su obra Las órdenes militares[[ (Calderón de la Barca. Obras completas. Autos sacramentales, III, Madrid, Aguilar, 1991, pág. 1012)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
