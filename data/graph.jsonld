      ],
      "identifier": "CMC003721",
      "name": "La perfecta casada",
      "titulo": "La perfecta casada",
      "titulo_limpio": "La perfecta casada",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
