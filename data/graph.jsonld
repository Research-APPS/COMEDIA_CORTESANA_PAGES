    {
      "@id": "https://comedia-cortesana.local/obra/CMC004758",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004758",
      "name": "Amor, ingenio y mujer (1623)",
      "titulo": "Amor, ingenio y mujer",
      "titulo_limpio": "Amor, ingenio y mujer (1623)",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
