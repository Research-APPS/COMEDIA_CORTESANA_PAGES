      ],
      "identifier": "CMC003786",
      "name": "La serrana de la Vera de Plasencia",
      "titulo": "La serrana de la Vera de Plasencia",
      "titulo_limpio": "La serrana de la Vera de Plasencia",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2383&mode=indice&letter=s",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEn los repertorios que manejamos, no figura ninguna comedia titulada La serrana de la Vera de Plasencia, y tampoco nos constan testimonios. No obstante, hay que decir que tanto Lope de Vega como Vélez de Guevara compusieron comedias tituladas La serrana de la Vera, que son posteriores a la que nos ocupa. Asimismo, existe un auto titulado La montañesa, también conocido como La serrana de la Vera[[ (UT, I, 296)]], y otro de Valdivielso titulado La serrana de la Vera de Plasencia con los que no debe confundirse esta comedia. Para más detalles sobre estas composiciones, véanse registros correspondientes en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
