    {
      "@id": "https://comedia-cortesana.local/obra/CMC002498",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002498",
      "name": "Coloquio de María Estuardo",
      "titulo": "Coloquio de María Estuardo",
      "titulo_limpio": "Coloquio de María Estuardo",
      "alternateName": "",
      "tipo_obra": "otro",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2989&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl texto de este coloquio es hoy desconocido y el título que le da Lohmann (u otro similar) no consta en ninguno de los catálogos clásicos consultados. En la entrada correspondiente a la Tragedia de María Estuardo, dentro de la base de datos TeatrEsco, a cargo d eJulio Alonso Asenjo, se atribuye la composición del coloquio a Hernando de Mendoza, jesuita y rector del Colegio de San Pablo. La representación fue dispuesta en honor al hermano del autor: García Hurtado de Mendoza, marqués de Cañete y virrey del Perú entre 1589 y 1596[[ (Alonso Asenjo, Julio, Catálogo Antiguo Teatro Escolar, http://parnaseo.uv.es/Ars/teatresco/BaseDatos/Bases_teatro_Escolar.htm)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
