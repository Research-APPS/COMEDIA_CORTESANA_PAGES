        "schema:CreativeWork"
      ],
      "identifier": "CMC003667",
      "name": "La madre de Dios",
      "titulo": "La madre de Dios",
      "titulo_limpio": "La madre de Dios",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2574&mode=indice&letter=m",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNinguno de los catálogos clásicos manejados recoge un auto sacramental titulado La madre de Dios, ni hay testimonios del mismo. Urzáiz Tortajada cita un auto anónimo con el título La madre de Jesús, representado en Burgos en 1624[[ (UT, I, 100)]]. No obstante, tras consultar la fuente de la que Urzáiz Tortajada extrae esta información, puede comprobarse que se trata de un error de Miguel Gallo en un trabajo de 1996[[ (\"Balance de la actividad teatral...\", 1996, p. 266)]]: en la transcripción del documento realizada por el propio Miguel Gallo en 1994, él mismo cita correctamente el título, que no es otro que La madre Teresa de Jesús[[ (MG1, 168)]]. Sobre este auto, véase la ficha correspondiente en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
