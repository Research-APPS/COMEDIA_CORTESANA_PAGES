        "schema:CreativeWork"
      ],
      "identifier": "CMC003811",
      "name": "La vengadora de las mujeres",
      "titulo": "La vengadora de las mujeres",
      "titulo_limpio": "La vengadora de las mujeres",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1399&mode=indice&letter=v",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo hay duda en la atribución de esta comedia a Lope de Vega y así lo recogen todos los catálogos clásicos y el más reciente de Héctor Urzáiz[[ (UT, II, 683; BL, 246, 444; Art, 391v; Sal, 543; MeR, L; GaH, 191; Faj, 52v; MC, 118; F, IX, 237)]]. Según Morley y Bruerton, se trata de una obra de autoría fiable escrita probablemente entre 1615 y 1620[[ (MoB, 402)]]. La obra fue impresa en la Parte 15 de las comedias de Lope de Vega (Madrid, Fernando Correa, 1621) y circuló suelta a nombre del dramaturgo durante el siglo XVII[[ (ARTELOPE; Ch, 539, 555)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
