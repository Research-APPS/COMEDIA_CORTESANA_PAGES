    {
      "@id": "https://comedia-cortesana.local/obra/CMC002832",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002832",
      "name": "El caballero del Fénix",
      "titulo": "El caballero del Fénix",
      "titulo_limpio": "El caballero del Fénix",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=411&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa documentación del Corpus de Madrid, a la que hemos aludido en el calendario de representaciones, atribuye este auto a Lope de Vega. De hecho, ya el 19 de abril de 1608, el autor Alonso de Riquelme, encargado de representar dos de los cuatro autos del Corpus de ese año, notificó a las autoridades madrileñas que Lope de Vega estaba escribiendo los autos, que \"por ser cosa de tanto cuidado ai alguna dilación en ellos\", y que se entregarían lo antes posible[[ (PP, II, 37-38; SV1, 19)]]. En los catálogos clásicos que hemos manejado no aparece recogido El caballero del Fénix, auto que Héctor Urzáiz recoge como una pieza lopesca perdida[[ (UT, II, 685)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
