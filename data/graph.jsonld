    {
      "@id": "https://comedia-cortesana.local/obra/CMC003636",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003636",
      "name": "La imperial de Toledo",
      "titulo": "La imperial de Toledo",
      "titulo_limpio": "La imperial de Toledo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=396&mode=indice&letter=i",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia que figura con el título de La imperial de Toledo en la noticia de representación de 1604 es la misma obra que, con el título La imperial Toledo, figura en la lista de sus comedias que Lope de Vega incluyó en la primera edición de El peregrino en su patria (1604) y de la que actualmente no se conocen testimonios[[ (UT, II, 666; Ch, 550)]]. Diversos catálogos clásicos recogen la autoría de Lope de esta pieza perdida[[ (BL, 556; Art, 189; MeR, XXXVI)]]. Por su parte, Thornton Wilder, al estudiar esta lista de comedias, llegó a la conclusión de que habría sido estrenada por Porres, como corroboraría la noticia de representación de 1604[[ (W, 195, 197-99; UT, II, 666)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
