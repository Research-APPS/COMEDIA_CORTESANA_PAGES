        "schema:CreativeWork"
      ],
      "identifier": "CMC004119",
      "name": "Lérida",
      "titulo": "Lérida",
      "titulo_limpio": "Lérida",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1857&mode=indice&letter=l",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ninguna comedia titulada Lérida en los catálogos clásicos que manejamos ni nos consta la existencia de testimonios de la obra que nos ocupa. No obstante, varios catálogos clásicos atribuyen a Pedro de Soria una obra titulada El sitio de Lérida [[ (MC, 108; GaH, 175; Art, 357r; BL, 376 y 583)]], conservada en un manuscrito con letra del siglo XVII en la Biblioteca Nacional de Madrid, en el que se atribuye esta obra a Lorenzo de Prado, aunque el nombre de Lorenzo de Prado aparece enmendado con letra algo posterior y sustituido por el \"Del Licenciado D. Pedro de Soria\", según observa Paz y Melia. En este mismo manuscrito, al final de la segunda jornada, se incluye una nota en la que se indica \"Del amistad tan famosa Vincentius Álvarez scripcit han[c] comediam\", nota que procede de la misma mano que escribió la comedia (PM, 515, nº 3400) —y que debe de ser la del copista—. De todos modos, no es seguro que la obra Lérida sea la misma que El sitio de Lérida.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
