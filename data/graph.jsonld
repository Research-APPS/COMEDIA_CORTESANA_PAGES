      "identifier": "CMC002862",
      "name": "El conde de Fuentes",
      "titulo": "El conde de Fuentes",
      "titulo_limpio": "El conde de Fuentes",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
