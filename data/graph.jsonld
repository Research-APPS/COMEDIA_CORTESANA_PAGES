    {
      "@id": "https://comedia-cortesana.local/obra/CMC002459",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002459",
      "name": "Barlán y Josafat (segunda parte)",
      "titulo": "Barlán y Josafat (segunda parte)",
      "titulo_limpio": "Barlán y Josafat (segunda parte)",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=246&mode=indice&letter=b",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEs muy probable que esta obra esté relacionada con la versión refundida de la comedia de Lope Barlaán y Josafat que se publicó en la Parte 24 de comedias de Lope aparecida en Zaragoza en 1641 y en cuyo final se anuncia una segunda parte de la historia de Barlaán y Josafat. Sobre esta versión refundida, véanse las observaciones hechas en su día por Montesinos[[ (Mo2, 169, 213-217)]]. Carecemos de noticias acerca de la autoría de la obra que nos ocupa, de la que no conservamos tampoco ningún testimonio.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
