    {
      "@id": "https://comedia-cortesana.local/obra/CMC003218",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003218",
      "name": "El señor de buenas noches",
      "titulo": "El señor de buenas noches",
      "titulo_limpio": "El señor de buenas noches",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1179&mode=indice&letter=s",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl señor de las buenas noches es el título que figura en las dos noticias de representación que documentamos en el calendario, aunque en la mayor parte de los catálogos clásicos que manamos aparece como El señor de noches buenas, título que aparece identificado con Don Enrique del Rincón en muchos de los catálogos clásicos que manejamos[[ (BL, 543; Art, 112r; MeR, XLVIII; GaH, 173; MC, 107; Faj, 48r)]]. En la BNE, signatura 17.301, se conserva un manuscrito de El señor de buenas noches. En este manuscrito aparece una censura firmada por Juan Navarro de Espinosa, en la que se atribuye la comedia a Antonio Hurtado de Mendoza[[ (PM, 509)]], atribución que aparece en algunos catálogos[[ (MeR, XLVIII; GaH, 173; MC, 107; Faj, 48)]]. No obstante, Arteaga, que también atribuye la comedia a Mendoza, advierte que es igual a la de Cubillo de Aragón[[ (Art, 112r)]]. Efectivamente, El señor de noches buenas se publicó en la recopilación de las obras de Cubillo titulada El enano de las musas (Madrid, María de Quiñones, 1654). En esa edición, el propio Cubillo explica que la atribución a Hurtado de Mendoza es errónea[[ (Sal, 649; UT, I, 276)]]. También en una suelta sin pie de imprenta y en el catálogo de La Barrera, la comedia aparece atribuida a Cubillo[[ (BL, 543MPR, 115)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
