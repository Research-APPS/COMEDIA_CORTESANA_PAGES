      ],
      "identifier": "CMC002944",
      "name": "El galán de la Membrilla",
      "titulo": "El galán de la Membrilla",
      "titulo_limpio": "El galán de la Membrilla",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2966&mode=indice&letter=g",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa obra no presenta problemas de atribución a Lope de Vega puesto que se conserva el manuscrito autógrafo, fechado el 20 de abril de 1615, en la British Library, signatura Ms. Egerton 547, y se imprimió en la Parte 10 (Barcelona, Sebastián de Cormellas, 1618) de las comedias de Lope de Vega[[ (UT, II, 663; BL, 450, 462; Art, 159r; MeR, XXXIV; GaH, 77; MC, 46; Faj, 24v; ARTELOPE; Sal, 541; Pre, 243; Pr, 187-188; Ch, 538)]]. Asimismo, en la Biblioteca Palatina de Parma, se conserva una copia manuscrita con signatura CC.* V. 28032/ XXVI[[ (MCacho, 146-147)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
