    {
      "@id": "https://comedia-cortesana.local/obra/CMC003389",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003389",
      "name": "La Camándula",
      "titulo": "La Camándula",
      "titulo_limpio": "La Camándula",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3019&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa Camándula figura sin atribución en la noticia de representación de 1623, aunque Cotarelo la identificó con el título Los bandos de Rávena, y fundación de la Camándula y la atribuyó a Lope de Vega[[ (CM1, 432 n.1)]]. Sin embargo, no tenemos constancia de la existencia de ninguna comedia del Fénix con este título y el título de Los bandos de Rávena, y fundación de la Camándula corresponde a una comedia de Juan de Matos Fragoso: véase el registro correspondiente. No es posible identificar La Camándula con esta comedia de Matos dado que la fecha de 1623 es demasiado temprana para ser obra de este dramaturgo. El título de La Camándula no figura en ninguno de los catálogos clásicos que hemos manejado y no nos consta la existencia de ejemplares de esta obra.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
