    {
      "@id": "https://comedia-cortesana.local/obra/CMC004229",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004229",
      "name": "Olimpa y Vireno",
      "titulo": "Olimpa y Vireno",
      "titulo_limpio": "Olimpa y Vireno",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=486&mode=indice&letter=o",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nOlimpa y Vireno es una comedia de Juan Pérez de Montalbán que figura también con los títulos de Olimpia y Vireno u Olimpa y Vereno, como se recoge en todos los catálogos clásicos que manejamos [[(BL, 267, 570; Art, 274v, 532r; Sal, 480, 632; MeR, XXXVI, XLII; GaH, 134; MC, 82; Faj, 39v; Sal, 480, 632) ]] y en varios de los catálogos y obras de referencia más recientes[[ (R2, 48; UT, I, 91; II, 510, 615; TESO; F, IX, 135, 177; PM, 261, n. 1746, 407, n. 2677; BS, 218; VE, 150, 219; Pr, 79, 81, 83, 85; Pr1, 309-313)]]. Olimpa y Vireno se publicó primero en la Parte 29 de la colección de Diferentes Autores (Valencia, S. Esparsa, 1636) y posteriormente en la Parte 1 de comedias de Montalbán (Valencia, Claudio Macé, 1652). También hay constancia de una decena de ediciones en forma de suelta, sobre todo del siglo XVIII: para detalles bibliográficos concretos de estas suelta, véase el catálogo de Profeti[[ (Pr1, 309-13)]]. Por otra parte, Shergold y Varey mencionan que en la BNE hay un manuscrito de una comedia anónima titulada El imposible vencido, y historia de Olimpa y Vireno, que Paz y Melia identifica con la comedia que nos ocupa[[ (PM, 261)]], pero los mismos investigadores señalan que se trata de una identificación errónea y que se trata de una obra distinta a la comedia de Montalbán[[ (F, IX, 135, 177)]]. Según esto, Mesonero Romanos y Paz y Melia se equivocaron al indicar[[ (MeR, XXXVI; PM, 261)]] como título alternativo para la obra el de El imposible vencido.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
