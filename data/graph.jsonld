      "identifier": "CMC002543",
      "name": "Cómo ha de ser el señor",
      "titulo": "Cómo ha de ser el señor",
      "titulo_limpio": "Cómo ha de ser el señor",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
