      "identifier": "CMC004467",
      "name": "África por Carlos V",
      "titulo": "África por Carlos V",
      "titulo_limpio": "África por Carlos V",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=115&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl título de esta comedia no aparece mencionado en los catálogos que manejamos, ni nos consta la existencia de testimonios de esta obra. Por la temática que sugiere el título, podría relacionarse con La mayor desgracia de Carlos V, también titulada Carlos V sobre Argel, en cuyo primer y segundo acto se trata de la jornada y derrota de Argel, y en cuyo tercer acto tiene lugar la victoria de Carlos V en Túnez; o con la titulada Carlos V en Túnez. Para más información sobre estos títulos, consúltense los registros correspondientes en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
