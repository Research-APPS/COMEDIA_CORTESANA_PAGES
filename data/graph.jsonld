      ],
      "identifier": "CMC004028",
      "name": "Los celos de San José",
      "titulo": "Los celos de San José",
      "titulo_limpio": "Los celos de San José",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
