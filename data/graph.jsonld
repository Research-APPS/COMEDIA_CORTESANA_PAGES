    {
      "@id": "https://comedia-cortesana.local/obra/CMC003942",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003942",
      "name": "Las viudas",
      "titulo": "Las viudas",
      "titulo_limpio": "Las viudas",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2720&mode=indice&letter=v",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSe publicó por primera vez en la Segunda parte de las comedias (Madrid, Imprenta del Reino, 1635) de Tirso de Molina y posteriormente en Entremeses nuevos. Primera parte (Zaragoza, Pedro Lanaja y Lamarca, 1640). Se conserva una copia manuscrita en la Biblioteca del Institut del Teatre de Barcelona, signatura 61.587[[ (SiP, 68)]]. A pesar de haber sido incluido en la Segunda parte de las comedias de Tirso, Salvá, debía dudar de su autoría y lo incluyó en su catálogo como anónimo[[ (Sal, 523, 705)]]. Por su parte La Barrera lo incluye en el suyo atribuido a Tirso con dudas[[ (BL, 653)]]. Cotarelo lo incluyó en su Colección de entremeses, loas, bailes, jácaras y mojigangas, desde fines del siglo XVI a mediados del XVIII[[ (1911, I, lxxiv-lxxviii, 187-190)]]. Según Urzáiz es de Quiñones de Benavente[[ (UT, II, 540)]]. No debe confundirse con el sainete anónimo de mismo título, cuyo manuscrito se conserva en la Biblioteca Nacional de España, signatura mss. 14.514[[ (PM, 577)]], ni con el entremés Las viudas fingidas de Manuel Coello Rebello, catalogado por Arteaga, García la Huerta y Urzáiz[[ (Art, 494v; GaH, 243; UT, I, 265)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
