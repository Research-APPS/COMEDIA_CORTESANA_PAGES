      "identifier": "CMC003964",
      "name": "Lo que pasa en un mesón",
      "titulo": "Lo que pasa en un mesón",
      "titulo_limpio": "Lo que pasa en un mesón",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
