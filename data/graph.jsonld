      "identifier": "CMC003562",
      "name": "La encomienda bien guardada",
      "titulo": "La encomienda bien guardada",
      "titulo_limpio": "La encomienda bien guardada",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
