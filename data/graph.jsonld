      "identifier": "CMC002814",
      "name": "El bobo del colegio",
      "titulo": "El bobo del colegio",
      "titulo_limpio": "El bobo del colegio",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
