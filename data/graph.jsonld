      "identifier": "CMC003807",
      "name": "La traición leal",
      "titulo": "La traición leal",
      "titulo_limpio": "La traición leal",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
