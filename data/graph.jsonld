      "identifier": "CMC003082",
      "name": "El noble siempre es valiente",
      "titulo": "El noble siempre es valiente",
      "titulo_limpio": "El noble siempre es valiente",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
