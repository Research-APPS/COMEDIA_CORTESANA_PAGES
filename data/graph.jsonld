        "schema:CreativeWork"
      ],
      "identifier": "CMC003160",
      "name": "El remediador",
      "titulo": "El remediador",
      "titulo_limpio": "El remediador",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2488&mode=indice&letter=r",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl remediador es un entremés de Quiñones de Benavente, incluido en la Jocoseria. Con esta atribución consta en algunos de los catálogos clásicos consultados[[ (BL, 644, 745; Sal, 701; Cotarelo, Colección de entremeses, LXXVIII)]], así como en el de Urzáiz[[ (UT, II, 538)]] y otros repertorios[[ (SiP, 52; PM, 472)]]. Se conserva una versión manuscrita del entremés en la BNE (ms. 15.957), con algunas variaciones con respecto al impreso. El entremés se imprimió, sin atribución, junto al auto El niño pastor, de Lope de Vega[[ (UT, II, 692)]], dentro de las Fiestas del santísimo sacramento (1644), cuyo manuscrito se encuentra en la Biblioteca Palatina de Parma[[ (Cacho, Manuscritos hispánicos, 50)]]. Este hecho lleva a Salvá a preguntarse si El remediador es obra del Fénix, aunque registra igualmente en su catálogo el que se incluye en la Jocoseria a nombre de Quiñones[[ (Sal, 701)]]. Madroñal atribuye el entremés a Quiñones con seguridad[[ (Madroñal, “Dos nuevos entremeses”, 174)]]. Paz y Meliá lo registra como baile y no como entremés[[ (PM, 472)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
