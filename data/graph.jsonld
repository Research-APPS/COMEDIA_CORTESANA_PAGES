      ],
      "identifier": "CMC003473",
      "name": "La aurora del sol divino",
      "titulo": "La aurora del sol divino",
      "titulo_limpio": "La aurora del sol divino",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2508&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa aurora del sol divino es una comedia de Francisco Jiménez Sedeño. Como se ha indicado ya en el calendario, en la Biblioteca Nacional de España se conserva un manuscrito de la obra (Ms. 16.621) con firma y rúbrica de Francisco Jiménez Sedeño, al final de la primera y la segunda jornadas[[ (PM, 39)]]. Asimismo, Moll documenta la existencia de una suelta a nombre de Jiménez Sedeño, publicada por la imprenta Santa Cruz de Salamanca en año desconocido[[ (Moll, 17)]]. Los repertorios consultados dan cuenta de esta comedia, y en todos los casos se atribuye al mencionado dramaturgo[[ (BL, 199; Art, 38v; Sal, 572; MeR, XXVI; GaH, 28; MC, 14; Faj, 8v; UT, I, 379)]]. Según recoge Urzáiz, La aurora del sol de divino aparece atribuida erróneamente a Francisco Jiménez de Cisneros [sic, por \"Sedeño\" ]en un catálogo manuscrito de la Biblioteca Menéndez Pelayo de Santander[[ (UT, I, 376)]]. Según Paz y Melia, el Barón de Schack la atribuyó equivocadamente a Francisco de Monteser[[ (UT, I, 376; PM, 39; BL, 271)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
