    {
      "@id": "https://comedia-cortesana.local/obra/CMC003944",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003944",
      "name": "Las ánimas del purgatorio",
      "titulo": "Las ánimas del purgatorio",
      "titulo_limpio": "Las ánimas del purgatorio",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": true,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=670&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl auto Las ánimas del purgatorio figura como anónimo en los catálogos de Arteaga y La Barrera; este último lo recoge como un manuscrito que perteneció a la Biblioteca de Osuna[[ (Art, 27r; BL, 593)]], no obstante, como señala Alenda y Mira, el manuscrito no aparece en Paz y Melia[[ (AM1, 369)]]. Por otro lado, no debe confundirse esta obra con la zarzuela en un acto que recoge en su catálogo Arteaga, titulada Las ánimas del purgatorio[[ (Art, 27r)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
