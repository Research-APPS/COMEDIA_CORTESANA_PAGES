    {
      "@id": "https://comedia-cortesana.local/obra/CMC002889",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002889",
      "name": "El desdichado en su patria",
      "titulo": "El desdichado en su patria",
      "titulo_limpio": "El desdichado en su patria",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
