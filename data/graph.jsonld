    {
      "@id": "https://comedia-cortesana.local/obra/CMC002557",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002557",
      "name": "Dar tiempo al tiempo",
      "titulo": "Dar tiempo al tiempo",
      "titulo_limpio": "Dar tiempo al tiempo",
      "alternateName": "Amar y dar tiempo al tiempo",
      "tipo_obra": "comedia",
      "genre": "comedia",
      "estado_ficha": "cruda",
      "fuente_principal": "AMBAS",
      "pagina_pdf": 91,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=357&mode=indice&letter=d",
      "notas": "",
      "notas_bibliograficas": "Comedia de Calderón, impresa en Escogidas XVII (Madrid, 1662), fols. 1 r. - 22 v. Según Hesse, PQ, XXVII (1948), 45, ésta es la edición príncipe. Según los documentos, obra del Conde de las Torres, y así lo tiene Barrera, 402, pero sin indicar si la conocía impresa o manuscrita. Consta en los índices de Fajardo, Medel, García de la Huerta y Artcaga.",
      "observaciones": "Atribución (CATCOM):\nSubirats, al dar cuenta de algunas representaciones palaciegas de la comedia Dar tiempo al tiempo que hemos manejado, señala correctamente que es obra de Calderón de la Barca [[(Sub, 435)]]. Con este título y atribución la recogen los repertorios clásicos [[(BL, 540; Sal, 586; Art, 93r; MeR, XXX; MC, 28; GaH, 50)]]. La misma comedia aparece también en el documento de 1697 con el título alternativo de Amar y dar tiempo al tiempo [[(F, VI, 298)]]. Se trata de una comedia de Calderón de la Barca que fue publicada por primera vez en la Parte 17 de la colección de Comedias Escogidas (Madrid, Melchor Sánchez, 1662) y, posteriormente, en la Parte 6 del teatro de Calderón editada por Vera Tassis (Madrid, Francisco Sánchez, 1683). Se conocen asimismo siete ediciones sueltas, todas con el título de Dar tiempo al tiempo y atribución a Calderón, y muchas sin datos bibliográficos. Para más detalles de estas sueltas, consúltese K. y R. Reichenberger [[(RR, I, 207; CM15, 455)]].",
      "edicion_principe": "Escogidas XVII (Madrid",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
