      "identifier": "CMC003575",
      "name": "La estatua de Prometeo",
      "titulo": "La estatua de Prometeo",
      "titulo_limpio": "La estatua de Prometeo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
