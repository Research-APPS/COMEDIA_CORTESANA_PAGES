    {
      "@id": "https://comedia-cortesana.local/obra/CMC004107",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004107",
      "name": "Los valles de Sopetrán",
      "titulo": "Los valles de Sopetrán",
      "titulo_limpio": "Los valles de Sopetrán",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1043&mode=indice&letter=v",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLos valles de Sopetrán figura como una obra anónima en algunos de los catálogo clásicos que manejamos[[ (BL, 589; Art, 387v; MC, 116)]]. Se conservan tres manuscritos de Los valles de Sopetrán. El primero de ellos se encuentra en la Biblioteca del Instituto del Teatro de Barcelona, signatura Ms. 82659[[ (SiP, 28)]], y en él se atribuye la autoría a \"Lanini, Diamante y Bustos\". Un segundo testimonio (signatura CC*IV 28033, Tomo 81, PP/30) se conserva en la Biblioteca Palatina de Parma[[ (MCacho, 127-28; 493)]] y en él no figura autoría. El último manuscrito se halla en la Biblioteca Municipal de Madrid[[ (Tea 1-10-6)]], y en él que se atribuye la obra a Diego de Aguayo y Terones[[ (UT, I, 45)]]. Actualiza el estado de la cuestión con detalles sobre los tres testimonios, el artículo de Javier J. Jacobo[[ (2023)]], quien a partir de las censuras incluidas en alguno de los testimonios propone la hipótesis de que se trataría de una obra colaborada entre Francisco de Lanini, Juan Bautista Diamante y Francisco González de Bustos. El estudio estilométrico que proporciona ETSO parece confirmar la autoría de Bustos y Lanini aunque la atribución a Diamante no resulta concluyente desde este punto de vista. En todo caso se trataría de una comedia colaborada. Esta conclusión deja a Aguayo como un posible copista o propietario del manuscrito o apuntador que pertenecería a la compañía de Francisca Correa cuando hizo la copia.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
