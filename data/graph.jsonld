    {
      "@id": "https://comedia-cortesana.local/obra/CMC003276",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003276",
      "name": "El viaje del hombre",
      "titulo": "El viaje del hombre",
      "titulo_limpio": "El viaje del hombre",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2531&mode=indice&letter=v",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ningún auto titulado El viaje del hombre en los catálogos que manejamos ni nos consta la existencia de testimonios. Tan solo Alenda y Mira menciona un auto de ese título atribuido a Lope de Vega[[ (AM1, 232)]]. Héctor Urzáiz recoge la opinión de Valentín Azcune[[ (”Comedia del viaje del hombre”. Dicenda, 15, 1977, 61-99]]) quien cree que esta obra es la misma que la comedia del mismo título que figura en El peregrino en su patria como “comedia alegórica”[[ (UT, II, 683-84, 689)]]. No obstante las representaciones que recogemos en el calendario son demasiado tempranas para poder relacionarlas con una obra del Fénix. Por otro lado, Sánchez Arjona supuso que el auto que nos ocupa podría ser el mismo que el titulado La residencia del hombre, que se incluye en el Códice de Autos Viejos[[ (SA, 57)]]. Pero se trata de una mera conjetura sin mayor fundamento.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
