    {
      "@id": "https://comedia-cortesana.local/obra/CMC003795",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003795",
      "name": "La taberna del infierno (primera parte)",
      "titulo": "La taberna del infierno (primera parte)",
      "titulo_limpio": "La taberna del infierno (primera parte)",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1183&mode=indice&letter=t",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl baile de La taberna del infierno (primera parte) no aparece mencionado en ninguno de los catálogos clásicos[[ (BL, Art, Sal, MeR, GaH, MC, Faj, Sal)]] que manejamos, con la excepción del catálogo más reciente de Urzáiz, donde viene recogido como entremés anónimo[[ (UT, I, 124)]]. Como mencionamos en la noticia de representación, el título aparece sin atribución de autor en una lista que había preparado Tomás Fernández de las obras que poseía y que aún no había representado en Sevilla, en la que aparece mencionada la segunda parte de La taberna del infierno[[ (SA, 310-13)]]. Bergman, al recoger la misma información que Sánchez-Arjona, menciona que esta obra tal vez salió de la pluma de Quiñones de Benavente, como muchas de las demás obras del listado[[ (Be, 173-74)]], sin que pueda confirmarse o desmentirse esta hipótesis por la ausencia del texto. Por ello, consideramos este baile como anónimo. No nos consta la existencia de testimonios de la obra que nos ocupa.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
