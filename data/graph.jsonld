        "schema:CreativeWork"
      ],
      "identifier": "CMC003952",
      "name": "Llegar una dicha a tiempo",
      "titulo": "Llegar una dicha a tiempo",
      "titulo_limpio": "Llegar una dicha a tiempo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=100&mode=indice&letter=l",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEsta obra, cuyo título, tal y como se refleja en los documentos mencionados, ofrece variantes, aparece en el documento de 1640 como Llegar una dicha a tiempo y atribuido a Alonso de Lugo[[ (BD2, 57-59)]], autoría no confirmada por ninguna otra fuente. No aparece mencionada en los catálogos que manejamos ni se incluye en las grandes colecciones de obras teatrales de la época. Urzáiz la da como anónima[[ (UT, I, 63)]].Por cuestiones de fecha, claramente no es la comedia titulada Llegar a tiempo de Gaspar Zavala y Zamora, dramaturgo del siglo XVIII[[ (CG, 253; Moll, 93)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
