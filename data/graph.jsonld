      "identifier": "CMC002968",
      "name": "El hidalgote de Jaca",
      "titulo": "El hidalgote de Jaca",
      "titulo_limpio": "El hidalgote de Jaca",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
