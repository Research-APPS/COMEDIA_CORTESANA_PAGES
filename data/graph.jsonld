    {
      "@id": "https://comedia-cortesana.local/obra/CMC002823",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002823",
      "name": "El caballero",
      "titulo": "El caballero",
      "titulo_limpio": "El caballero",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1126&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nCon el título El caballero hallamos una comedia de Agustín Moreto sobre la que ningún catálogo ofrece duda en su atribució[[n (UT, II, 468; BL, 278-79; Art, 51r; Sal, 405, 468; MeR, XXVII; GaH, 35; Faj, 11v; MC, 21; F, IX, 70)]]. La comedia fue impresa por vez primera a nombre de Moreto en la Parte 19 de la colección de Comedia escogidas (Madrid, Pablo del Val, 1663) y circuló suelta atribuida a Moreto durante el XVIII (CM15, 466; Moll, 21, nº 136; BS, 57, nº177; MPR, 20, nº 100a; CG, 185, nº 242). Fajardo mencionó una hipotética Parte 2 de la colección de Comedias escogidas en la que figuraba esta obra Y podría tratarse de la misma que menciona Kennedy, de 1652 (K, 201); sin embargo, nada más hemos hallado acerca de este volumen de la colección.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
