      }
    },
    {
      "@id": "https://comedia-cortesana.local/obra/CMC003179",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003179",
      "name": "El rey don Pedro el Justiciero",
      "titulo": "El rey don Pedro el Justiciero",
      "titulo_limpio": "El rey don Pedro el Justiciero",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=222&mode=indice&letter=r",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nCon este título no hallamos ninguna comedia en los catálogos clásicos ni en el más reciente de Urzáiz, ni nos constan testimonios de la misma. A. de la Granja cree que la obra representada en Salamanca debió de ser Las audiencias del rey don Pedro de Lope[[ (Gr, 72)]]. A pesar de que la mayor parte de los catálogos atribuyen esta comedia a Lope, según Morley y Bruerton se trata de una comedia de dudosa o incierta autenticidad cuya escritura datan entre 1613 y 1620 suponiendo que sea del Fénix[[ (UT, II, 654; BL, 529; Art, 37v; MeR, XXVI; MoB, 423-24)]]. García de la Huerta y Medel la traen sin atribución[[ (GaH, 28; MC, 14)]]. De esta comedia se conserva una copia manuscrita del XVII, sin atribución, en la BNE con signatura Ms. 16.762[[ (PM, 38, nº296)]]. Si Las audiencias del Rey Don Pedro es una comedia de Lope de Vega, no puede tratarse de la comedia mencionada en el calendario, pues la fecha de escritura que aportan Morley y Bruerton es posterior. Según San Román, también podría referirse a El médico de su honra o El infanzón de Illescas (en CATCOM, El rey don Pedro en Madrid)[[ (Sr, LXXI)]]. Además también podría relacionarse con la comedia El rey don Pedro el Cruel. No obstante, todas estas comedias parecen ser posteriores a esta que abordamos. Véanse los registros correspondientes en CATCOM para más información.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
