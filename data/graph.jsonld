    {
      "@id": "https://comedia-cortesana.local/obra/CMC003005",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003005",
      "name": "El juramento ante Dios y lealtad contra el amor",
      "titulo": "El juramento ante Dios y lealtad contra el amor",
      "titulo_limpio": "El juramento ante Dios y lealtad contra el amor",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2715&mode=indice&letter=j",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl juramento ante Dios y lealtad contra el amor es una comedia de Jacinto Cordero que también se conoce por los títulos de El juramento ante Dios, Lealtad contra el amor o La lealtad contra el amor y juramento ante Dios. Figura con atribución a este dramaturgo en los catálogos clásicos que hemos manejado[[ (BL, 100, 557, 687; Art, 201v, 206r, 500v, 513r; Sal, 415; MeR, XXXVII; GaH, 98, 100; MC, 60-61; Faj, 30v; UT, I, 267; RB, 124)]]. Medel del Castillo menciona una obra titulada Lealtad contra el amor como anónima[[ (MC, 61)]], pero pensamos que se trata de un error ya que también mencionan la obra titulada El juramento ante Dios y la atribuye a Jacinto Cordero[[ (MC, 60)]]. Esta comedia se publicó con el título de El juramento ante Dios y lealtad contra el amor y a nombre de Jacinto Cordero en la Parte 44 de Comedias de diferentes autores (Zaragoza, Herederos de Pedro Lanaja y Lamarca, 1652)[[ (Pr, 143, 148, 150, 217)]], así como en la Parte 6 de Comedias escogidas (Zaragoza, Herederos de Pedro Lanaja y Lamarca, 1653)[[ (CM15, 262-64)]]. Con el mismo título y atribución se publicó en diversas ocasiones en forma de suelta durante el siglo XVIII en Madrid, Barcelona y Sevilla[[ (Moll, 86; BS, 167-68; MPR, 68; Pr, 143, 148, 150, 217)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
