      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=404&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se puede identificar este auto, por cuestión cronológica, con el auto posterior de Agustín Moreto titulado La casa de Austria del que se conserva una copia manuscrita de mano de Martínez de Mora en la BNE, con la signatura Ms. 15.237, auto que se imprimió con el título La gran casa de Austria, y divina Margarita en Navidad y Corpus Cristi, Madrid, 1664[[ (PM, 81)]], auto del que dan noticia también La Barrera[[ (BL, 596, 710)]] y Ciria Matilla[[ (CiM, 75)]]. No se han encontrado en los catálogos que manejamos más noticias del auto que se menciona en el documento de 1621.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
