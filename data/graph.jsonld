      "identifier": "CMC003778",
      "name": "La selva sin amor",
      "titulo": "La selva sin amor",
      "titulo_limpio": "La selva sin amor",
      "alternateName": "",
      "tipo_obra": "otro",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
