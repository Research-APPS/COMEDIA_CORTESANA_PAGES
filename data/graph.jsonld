    {
      "@id": "https://comedia-cortesana.local/obra/CMC002474",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002474",
      "name": "Carlos V en Francia",
      "titulo": "Carlos V en Francia",
      "titulo_limpio": "Carlos V en Francia",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2107&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEn la Universidad de Pennsylvania se conserva el manuscrito autógrafo de esta comedia con título, que no es de mano de Lope, de Lo que pasó César Carlos Quinto en Francia (signatura Ms. Codex 63). El autógrafo está fechado en Toledo, a 20 de noviembre de 1604[[ (Pre, 141-148)]]. Los versos finales del tercer acto la mencionan por el título alternativo Lo que pasó César Carlos V en Francia. Lope citó la comedia en el segundo listado de El peregrino en su patria (1618) por el título Carlos V en Francia. Todos los catálogos clásicos y el más reciente de Urzáiz traen la atribución a Lope[[ (UT, II, 656; BL, 436; Art, 57r; Sal, 545; MeR, XXVII; GaH, 37; Faj, 11v; MC, 19; MoB, 85; Ch, 546)]]. La obra fue impresa en la Parte 19 de las comedias de Lope (Madrid, Juan González, 1624). En la BNE, se conserva un apógrafo de la colección Sanz de Pliegos, signatura Ms. 14.865[[ (PM, 60-61, nº 408; ARTELOPE)]]. Asimismo Silvia Iriso[[ (\"Estudio de la colección Gálvez...”, 1997, 99)]] señala la existencia de otro apógrafo de esta comedia, procedente de la colección Gálvez y hoy en paradero desconocido. Existe una comedia representada en 1606 y titulada Los triunfos de Carlos V (véase registro en CATCOM), pero no hay razones suficientes para identificarla con la de Lope.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
