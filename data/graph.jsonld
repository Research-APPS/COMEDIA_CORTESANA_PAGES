      "identifier": "CMC004047",
      "name": "Los desposorios de la Virgen",
      "titulo": "Los desposorios de la Virgen",
      "titulo_limpio": "Los desposorios de la Virgen",
      "alternateName": "",
      "tipo_obra": "auto",
