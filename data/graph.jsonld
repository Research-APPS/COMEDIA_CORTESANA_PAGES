      "identifier": "CMC003313",
      "name": "Fieras afemina amor",
      "titulo": "Fieras afemina amor",
      "titulo_limpio": "Fieras afemina amor",
      "alternateName": "",
      "tipo_obra": "entremes",
      "genre": "comedia",
      "estado_ficha": "cruda",
      "fuente_principal": "AMBAS",
      "pagina_pdf": 117,
      "mecenas": "",
      "musica_conservada": false,
