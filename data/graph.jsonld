    {
      "@id": "https://comedia-cortesana.local/obra/CMC002385",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002385",
      "name": "Acertar errando",
      "titulo": "Acertar errando",
      "titulo_limpio": "Acertar errando",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
