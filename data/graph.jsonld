    {
      "@id": "https://comedia-cortesana.local/obra/CMC004770",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004770",
      "name": "El conde Peranzules (1627)",
      "titulo": "El conde Peranzules",
      "titulo_limpio": "El conde Peranzules (1627)",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3027&mode=indice&letter=c",
      "notas": "",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl conde Peranzules es una comedia anónima de la que no nos consta la existencia de testimonios. Creemos que se trata de la misma obra que aparece con el título de El conde don Peranzules y sin atribución en algunos de los catálogos que hemos manejado[[ (MC, 24; GaH, 43; Art, 77v; MeR, XXIX; BL, 537)]]. Tenemos también constancia de la existencia de una comedia titulada El conde Peranzules y escrita por Alfonso Hurtado de Velasco, de la que existen noticias datadas en 1593 y 1597. Nos parece que esta comedia es demasiado temprana como para corresponder con la noticia de representación que nos ocupa, aunque no puede descartarse que se trate de la misma obra: véase el registro correspondiente.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
