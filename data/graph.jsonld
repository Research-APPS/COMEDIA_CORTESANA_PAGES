        "schema:CreativeWork"
      ],
      "identifier": "CMC002842",
      "name": "El carretero",
      "titulo": "El carretero",
      "titulo_limpio": "El carretero",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3068&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nUrzáiz [[(UT, I, 68)]]vincula en su catálogo el título El carretero a la comedia citada por La Barrera como El carretero de la Mancha[[(BL, 533)]]. También García Gómez [[(Vida teatral en Córdoba, p. 117)]]señala que El carretero podría corresponderse con la comedia anónima que figura en La Barrera, El carretero de la Mancha. Por su parte, Arteaga [[(Art, 58)]]y García de la Huerta [[(GaH, 37)]]recogen también el título El carretero de la Mancha como anónima. En la biblioteca de la Fundación Lázaro Galdiano se conserva una copia manuscrita de la primera jornada de la comedia El carretero de la Mancha, que incluye la siguiente nota final firmada y rubricada por Juan Rodríguez de Artiaga: \"Lo que ha de cantar el carro canta la carreta y el carretero de la Mancha es muy buena comedia y la puede representar Antonio de Granados autor de comedias y se puede representar en Ocaña a dos de agosto de 1616 años\". (https://bibliotecavirtualmadrid.comunidad.madrid/bvmadrid_publicacion/es/consulta/registro.do?id=3546) No debe confundirse este título con otras piezas breves homónimas: un baile de Agustín Salazar y Torres, del que se conserva manuscrito en la BNE[[(PM, 80)]] y una mojiganga de Calderón que lleva los títulos de La muerte y El carretero, de la que puede verse el registro correspondiente para más detalles.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
