      "identifier": "CMC004109",
      "name": "Los vencidos vencedores",
      "titulo": "Los vencidos vencedores",
      "titulo_limpio": "Los vencidos vencedores",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
