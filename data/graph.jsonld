        "schema:CreativeWork"
      ],
      "identifier": "CMC004297",
      "name": "Roma sitiada",
      "titulo": "Roma sitiada",
      "titulo_limpio": "Roma sitiada",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1979&mode=indice&letter=r",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ninguna comedia titulada Roma sitiada en los catálogos que manejamos ni nos consta la existencia de testimonios de la obra que nos ocupa. Domínguez Búrdalo plantea la posible identificación de Roma sitiada bien con Roma abrasada de Lope de Vega, bien con El cerco de Roma por el rey Desiderio de Vélez de Guevara. Por su parte Urzáiz tan solo se refiere a la posible identificación de Roma sitiada con Roma abrasada de Lope de Vega[[ (Domínguez Búrdalo, p. 210; UT, II, 678)]]. Sin embargo, descartamos la identificación con la obra de Lope Roma abrasada, ya que el argumento de esta última gira en torno a las crueldades de Nerón y el incendio de Roma, sin hacer referencia en ningún momento al sitio de la ciudad. Respecto a la posible identificación con El cerco de Roma por el rey Desiderio de Vélez de Guevara, que plantea Domínguez Búrdalo, hay que señalar que la representación de 1606 que incluimos en el calendario sería demasiado temprana para tratarse de la obra de este dramaturgo, si se escribió alrededor de 1613, como proponían Henryk Ziomek y Ann Nickerson Hughes en la edición crítica de la comedia[[ (Henryk Ziomek y Ann Nickerson Hughes, “El cerco...”, p. 4)]]. Sin embargo, más recientemente G. Peale en su edición, argumentando razones de tipo métrico, propone la identificación de Roma sitiada con la obra de Vélez[[ (p. 30, 47)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
