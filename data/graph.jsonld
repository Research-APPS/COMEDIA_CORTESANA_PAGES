    {
      "@id": "https://comedia-cortesana.local/obra/CMC002773",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002773",
      "name": "El acierto en el engaño y robador de su honra",
      "titulo": "El acierto en el engaño y robador de su honra",
      "titulo_limpio": "El acierto en el engaño y robador de su honra",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1683&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl acierto en el engaño y robador de su honra, que figura también como El acierto en el engaño o El robador de su honra en varios catálogos, es una comedia de Luis de Belmonte Bermúdez, tal y como figura en los catálogos clásicos que hemos manejado[[ (BL, 30, 523; Art, 5r, 326r; MeR, XXIII, XLV; GaH, 13, 60; MC, 4, 99)]], así como en algunos catálogos y obras de referencia más modernos[[ (UT, I, 161; PM, 5-6, 482)]]. Una copia manuscrita de El acierto en el engaño y robador de su honra se conserva en la BNE bajo la signatura Ms. 15.009[[ (PM, 5-6)]]. Según Paz y Melia se imprimió suelta[[ (PM, 5)]], pero no tenemos constancia de la existencia de ediciones impresas de esta obra[[ (Román San Rubio, “Catálogo...”)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000124"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000124"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
