    {
      "@id": "https://comedia-cortesana.local/obra/CMC004773",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004773",
      "name": "Los desposorios de Nuestra Señora (1578)",
      "titulo": "Los desposorios de Nuestra Señora",
      "titulo_limpio": "Los desposorios de Nuestra Señora (1578)",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3052&mode=indice&letter=d",
      "notas": "",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLos desposorios de Nuestra Señora es un auto sacramental anónimo y no tenemos constancia de la existencia de testimonios de esta obra. Un auto titulado Los desposorios de Nuestra Señora aparece recogido en los catálogos de García de la Huerta, Medel del Castillo, Arteaga, Mesonero Romanos y La Barrera[[ (GaH, 205; MC, 127; Art, 416r; MeR, XXX; BL, 595)]], pero no sabemos si se trata de la obra que nos ocupa. Existen noticias de representación de un auto o autos titulados Los desposorios de Nuestra Señora y fechados en 1612 y 1614, así como de la existencia de un auto titulado Los desposorios de la Virgen, obra de Juan Caxesi. Asimismo, existe un auto titulado Los desposorios de la Virgen y nacimiento de Cristo y atribuido a Juan Esteban[[ (UT, I, 307)]], del que se conserva un manuscrito en la BNE bajo la signatura Ms. 17.240[[ (PM, 150)]]. Sin embargo, pesamos que, por la distancia cronológica, la obra que nos ocupa es distinta de estos otros autos: véanse los registros correspondientes en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
