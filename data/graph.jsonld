    {
      "@id": "https://comedia-cortesana.local/obra/CMC004240",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004240",
      "name": "Pasión vencida de afecto",
      "titulo": "Pasión vencida de afecto",
      "titulo_limpio": "Pasión vencida de afecto",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "comedia",
      "estado_ficha": "cruda",
      "fuente_principal": "AMBAS",
      "pagina_pdf": 182,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2126&mode=indice&letter=p",
      "notas": "",
      "notas_bibliograficas": "Comedia de Diamante, impresa en sus Comedias (primera parte) (Madrid, 1670), 123-157 (hay dos series de paginaciones en este tomo): «Fiesta que se representó a su Magestad.» La versión primitiva de esta obra parece ser una comedia de Jerónimo de Cuellar, ahora perdida. El pago del 17 de noviembre de 1706 a José de Cañizares se refiere a una nueva versión suya, impresa suelta, de la cual existe, según Paul Mérimée, 122, n. 23, un manuscrito en la B.M.M., 1-56-6, que se denomina «Segunda parte». La primera jornada es de Solis, la segunda de Coello, y la tercera de Calderón. Salió en Escogidas VIII (Madrid, 1657), fols. 106 r. - 134 v. Según Hesse, PQ, XXVII (1948), 44, ésta es la edición príncipe; pero se convocan en la atribución de las jornadas a los distintos dramaturgos. Vera Tassis, en la Verdadera quinta parte, la tiene por una de las comedias de Calderón «donde tiene vna jornada... la tercera». Hay copias manuscritas: en la B.N.M., 15.408 (con portada y otros tres dibujos en color, uno al final de cada jornada, pero que no tienen interés para la escenografía de la obra) y 18.074 (Paz, I, 422); en la B.M.M., dos (con censura de 1783) (Cambronero); en la biblioteca de la Hispanic Society of America, B2607/1 (Regueiro y Reichenberger, I, 101-102); y en la Colección Borbón-Lorenzana de la Biblioteca Pública de Toledo (Esteve Barba, 195).",
      "observaciones": "Atribución (CATCOM):\nTodos los catálogos clásicos consultados coinciden en atribuir la comedia Pasión vencida de afecto a Juan Bautista Diamante[[ (BL, 571; Art, 282r; Sal, 633; MeR, XLII; GaH, 138; MC, 84; Faj, 40r)]]. La obra se imprimió en la Primera parte de sus Comedias (Madrid, García de la Iglesia, 1670)[[ (F, IX, 181; UT, I, 287)]].",
      "edicion_principe": "sus Comedias (primera parte) (Madrid",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
