      "identifier": "CMC003958",
      "name": "Lo que es no casarse a gusto",
      "titulo": "Lo que es no casarse a gusto",
      "titulo_limpio": "Lo que es no casarse a gusto",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=359&mode=indice&letter=l",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia Lo que es no casarse a gusto se atribuye, sin vacilaciones, a Mira de Amescua en los catálogos en que aparece[[ (BL, 260; Art, 211v; MeR, XXXVII; UT, II, 447)]]. Valladares Reguero lista un manuscrito en la British Library, con signatura Add. 33.475, que considera del siglo XVII, aunque el catálogo de la biblioteca lo recoge como del siglo XVIII, así como una edición suelta, sin datos bibliográficos, pero que sería de la segunda mitad del siglo XVII[[ (VR, 92; CM14, 18-20)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
