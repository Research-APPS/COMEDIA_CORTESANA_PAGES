      ],
      "identifier": "CMC003331",
      "name": "Gravedad en Villaverde",
      "titulo": "Gravedad en Villaverde",
      "titulo_limpio": "Gravedad en Villaverde",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=472&mode=indice&letter=g",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEn la noticia de representación de 1627 se atribuye Gravedad en Villaverde a Lope de Vega[[ (LL1, 177-78)]]. Sin embargo, es en realidad obra de Juan Pérez de Montalbán, como recogen los catálogos que hemos manejado[[ (Faj, 26r; MC, 50; GaH, 82; Art, 167v; MeR, XXXV; BL, 268, 690; UT, II, 509)]]. La comedia se publicó a nombre de Montalbán por primera vez en la Parte 9 de la colección de Comedias Escogidas (Madrid, G. Rodríguez, 1657)[[(CM15, 418-421)]]. Se tiene noticia también de una edición suelta, sin datos bibliográficos y con atribución a Montalbán[[ (Pr1, 154-56, 265)]], y Arteaga afirma que se publicó suelta en Valencia, aunque no tenemos constancia de la existencia de ejemplares de esta edición[[ (Art, 26r)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
