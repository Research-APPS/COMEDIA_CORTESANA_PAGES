      "name": "El poder de la amistad y venganza sin castigo",
      "titulo": "El poder de la amistad y venganza sin castigo",
      "titulo_limpio": "El poder de la amistad y venganza sin castigo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
