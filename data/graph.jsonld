      "identifier": "CMC004274",
      "name": "Quien mal piensa así se agravia",
      "titulo": "Quien mal piensa así se agravia",
      "titulo_limpio": "Quien mal piensa así se agravia",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1432&mode=indice&letter=q",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl título Quien mal piensa así se agravia no consta en ninguno de los repertorios clásicos que utilizamos. Asimismo, no nos consta la existencia de testimonios de la pieza. También es posible que la lectura correcta fuera Quien mal piensa a sí se agravia.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
