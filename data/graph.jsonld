      ],
      "identifier": "CMC003062",
      "name": "El monte santo",
      "titulo": "El monte santo",
      "titulo_limpio": "El monte santo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
