      "identifier": "CMC002640",
      "name": "El Caín de Cataluña",
      "titulo": "El Caín de Cataluña",
      "titulo_limpio": "El Caín de Cataluña",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
