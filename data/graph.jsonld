    {
      "@id": "https://comedia-cortesana.local/obra/CMC003688",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003688",
      "name": "La muerte de Séneca",
      "titulo": "La muerte de Séneca",
      "titulo_limpio": "La muerte de Séneca",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1286&mode=indice&letter=m",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEn la mayoría de los catálogos clásicos que hemos manejado no figura obra alguna con el título La muerte de Séneca. Urzáiz alude a la representación de 1640 e incluye La muerte de Séneca en su lista de obras anónimas[[ (UT, I, 105)]]. No nos consta la existencia de testimonios del texto. La obra que nos ocupa es distinta de la del mismo título que Arteaga atribuye a Valladares[[ (Art, 251)]], pues, según Herrera Navarro, Antonio de Valladares de Sotomayor nació alrededor de 1740. En cualquier caso, Herrera Navarro cita La muerte de Séneca entre las obras atribuidas a Valladares de Sotomayor, pero cuyo texto no se conserva[[ (Herrera Navarro, Catálogo de autores..., p. 462)]].Debe tratarse de un error de atribución.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
