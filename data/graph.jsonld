      "identifier": "CMC003965",
      "name": "Lo que pasa en una tarde",
      "titulo": "Lo que pasa en una tarde",
      "titulo_limpio": "Lo que pasa en una tarde",
      "alternateName": "",
      "tipo_obra": "comedia",
