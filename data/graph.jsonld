    {
      "@id": "https://comedia-cortesana.local/obra/CMC004168",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004168",
      "name": "Nadie diga mal del día hasta que la luz se acabe",
      "titulo": "Nadie diga mal del día hasta que la luz se acabe",
      "titulo_limpio": "Nadie diga mal del día hasta que la luz se acabe",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2007&mode=indice&letter=n",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nComo se ha señalado, en la BNE se conserva un manuscrito de la comedia Nadie diga mal del día hasta que la luz se acabe, en el que se indica que se trata de una \"Comedia de Francisco Mudarra, autor de comedias de Su Majestad\". El manuscrito lleva fecha de 1617 y Paz y Melia se preguntaba al catalogarlo si podía tratarse de un manuscrito autógrafo, señalando que C. A. de la Barrera la mencionaba en su catálogo como anónima[[ (PM, 374-75, n° 2501)]]. En otros catálogos, como el de Arteaga, Medel o García la Huerta aparece el título de la comedia sin ninguna noticia sobre su posible autoría[[ (Art, 256v; BL, 567; GaH, 123; MC, 75)]]. No obstante, con atribución a Francisco Mudarra apareció también descrito en el Catálogo de la Biblioteca del Duque de Osuna de José María Rocamora[[ (p. 97)]]. Es difícil saber si se trata de una obra de Mudarra, o de un manuscrito del que fue copista o que fue de su propiedad.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
