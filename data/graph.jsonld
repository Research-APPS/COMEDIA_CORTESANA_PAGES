        "schema:CreativeWork"
      ],
      "identifier": "CMC002452",
      "name": "Aunuch",
      "titulo": "Aunuch",
      "titulo_limpio": "Aunuch",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=225&mode=indice&letter=a",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nCon el título Aunuch no figura en ninguno de los catálogos clásicos ni en el más reciente de Urzaiz ninguna comedia, ni hemos encontrado ningún testimonio. Según Rubio y Balaguer, podría tratarse de una adaptación del Eunuco de Terencio, como se ha indicado. La Barrera, Arteaga y Salvá recogen la traducción del Eunuchus de Terencio realizada por Pedro Simón Abri[[l (BL, 4, 548; Art, 143v; Sal, 600)]]; sin embargo, por la fecha que consta en el calendario parece improbable que se trate de dicha traducción pues el año de nacimiento de Abril fue 1530. Asimismo, como indica Rubio y Balaguer, quizás se tratase de una traducción o una adaptación al catalán de la obra de Terencio de la cual no tenemos datos.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
