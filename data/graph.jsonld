        "schema:CreativeWork"
      ],
      "identifier": "CMC003637",
      "name": "La impresión de las llagas de San Francisco",
      "titulo": "La impresión de las llagas de San Francisco",
      "titulo_limpio": "La impresión de las llagas de San Francisco",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1921&mode=indice&letter=i",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ninguna comedia titulada La impresión de las llagas de san Francisco en los catálogos que manejamos ni nos consta la existencia de testimonios de la obra que nos ocupa. Urzáiz la incluye entre las obras anónimas[[ (UT, I, 91)]].Hay que advertir que existe una comedia titulada San Francisco que, en principio, es diferente de la obra que nos ocupa. Además, nos consta la existencia de varias comedias dedicadas a las figuras de san Francisco de Asís, san Francisco de Paula, san Francisco Javier o san Francisco de Padua. No se puede aventurar la relación de ninguna de ellas con la obra que nos ocupa.",
      "edicion_principe": "",
