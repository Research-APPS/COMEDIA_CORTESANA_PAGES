    {
      "@id": "https://comedia-cortesana.local/obra/CMC003329",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003329",
      "name": "Gradas de San Felipe",
      "titulo": "Gradas de San Felipe",
      "titulo_limpio": "Gradas de San Felipe",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2163&mode=indice&letter=g",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ningún auto titulado Gradas de San Felipe en los catálogos clásicos que hemos manejado, ni nos consta la existencia de testimonios conservados de la obra que nos ocupa. Sin embargo, Reichenberger y Reichenberger[[(RR, I, 777)]] atribuyen este auto a Calderón, remitiendo a lo dicho por Cotarelo[[(CM9, 243)]] y sobre todo a la información aportada por Shergold y Varey[[(SV5, XIX)]], de la que hemos dado cuenta en la notica incluida en 1643 en el calendario.",
      "edicion_principe": "",
