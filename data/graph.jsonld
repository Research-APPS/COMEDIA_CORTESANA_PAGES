    {
      "@id": "https://comedia-cortesana.local/obra/CMC004439",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004439",
      "name": "Venta y remate sacramental",
      "titulo": "Venta y remate sacramental",
      "titulo_limpio": "Venta y remate sacramental",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3166&mode=indice&letter=v",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl auto titulado Venta y remate sacramental no se encuentra en ninguno de los catálogos consultados, salvo en el de Urzáiz que cita la misma noticia que recogemos en el calendario[[ (UT, 130)]]. No tenemos indicios acerca de la autoría de esta pieza y no se ha encontrado, hasta el momento, testimonio alguno.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
