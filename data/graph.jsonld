      ],
      "identifier": "CMC004300",
      "name": "Salir el amor al mundo",
      "titulo": "Salir el amor al mundo",
      "titulo_limpio": "Salir el amor al mundo",
      "alternateName": "",
      "tipo_obra": "zarzuela",
      "genre": "zarzuela",
      "estado_ficha": "cruda",
      "fuente_principal": "FUENTESIX",
      "pagina_pdf": 5,
      "mecenas": "",
      "musica_conservada": true,
      "compositor": "Sebastián Durón en la B",
      "fecha_creacion": "",
      "url_catcom": "",
      "notas": "",
      "notas_bibliograficas": "Existe Salir el amor del mundo, zarzuela de Cañizares. El manuscrito se conserva en la B.N.M., 17.203 (Paz, I, 493). Hay música de Sebastián Durón en la B.N.M., M.2.283: «Fiesta que se hizo a SS.MM.» de una «fiesta repetida», y una representación de Venir el amor al mundo (q.v.), representado por Cárdenas en Toledo el 5 de junio del mismo año. Sobre la confusión entre estos dos títulos, véase la edición de Salir el amor del mundo por Antonio Martín (Málaga, 1979), 81-83.",
      "observaciones": "",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
