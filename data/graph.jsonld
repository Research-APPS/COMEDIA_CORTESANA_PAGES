      "pagina_pdf": 1,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "",
      "notas": "",
      "notas_bibliograficas": "Comedia de Diamante, impresa en sus Comedias (primera parte) (Madrid, 1670), 234-250 (hay dos series de paginaciones en este tomo): «Fiesta que se representó a sus Magestades en la Zarzuela». Hay copia manuscrita, con ocho hojas al final impresas, en la B.N.M., 15.194 (Paz, I, 547). Una carta del 25 de abril de 1686 habla de «los versos cantados que a añadido Diamante».",
      "observaciones": "",
      "edicion_principe": "sus Comedias (primera parte) (Madrid",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
