        "schema:CreativeWork"
      ],
      "identifier": "CMC003374",
      "name": "Julián Romero",
      "titulo": "Julián Romero",
      "titulo_limpio": "Julián Romero",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2101&mode=indice&letter=j",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa comedia titulada Julián Romero se conserva, atribuida a Lope de Vega, en la \"extravagante\" Parte 27 de la colección de Diferentes autores (“Barcelona, Sebastián de Cormellas, 1633”), volumen contrahecho cuyo título completo es Las comedias del Fénix de España Lope de Vega Carpio. Parte veinte y siete. La pieza se conserva asimismo en una suelta de la BNE —procedente del tomo 133 de la Biblioteca de Osuna, como estudió Germán Vega— que a su vez deriva de la Parte 27[[ (VG; Pr, 62-69; ARTELOPE; UT, 667; Ch, 550)]]. La autoría de Lope, repetida por todos los catálogos clásicos manejados que citan la comedia[[ (Art, f. 201r; Sal, 613-614; GaH, 98; MC, 60; Faj, f. 30v)]], se considera hoy muy dudosa, a juzgar por el examen métrico de Morley y Bruerton y por la falta de fiabilidad de la Parte 27[[ (MoB, 488; VG)]]. Por su parte, el análisis estilométrico de ETSO adjudica Julián Romero a la pluma de Damián Salucio del Poyo; tal atribución, aunque deberá corroborarse con un estudio en profundidad, se antoja más probable que la de Lope.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
