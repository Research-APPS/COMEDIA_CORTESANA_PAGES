      "identifier": "CMC003633",
      "name": "La humildad soberbia",
      "titulo": "La humildad soberbia",
      "titulo_limpio": "La humildad soberbia",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2457&mode=indice&letter=h",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa humildad soberbia es una comedia de Guillén de Castro, tal y como recogen los catálogos clásicos que hemos consultado[[ (BL, 82, 555; Sal, 611; MeR, XXXVI, GaH, 92; MC, 55; Faj, 28v; Art, 187v; GaG1, 285; UT, I, 238)]]. Esta comedia se publicó en la Parte 1 de las comedias del dramaturgo (Valencia, Felipe Mey, 1618)[[ (UT, I, 238; BL, 82; Sal, 383; Faj, 28v]]). Por último, no hay que confundir la comedia que nos ocupa con otra obra titulada La humildad y soberbia, de Lope de Vega: para más información, véase el registro correspondiente en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
