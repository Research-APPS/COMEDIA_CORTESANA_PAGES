        "schema:CreativeWork"
      ],
      "identifier": "CMC003999",
      "name": "Los Porceles de Murcia",
      "titulo": "Los Porceles de Murcia",
      "titulo_limpio": "Los Porceles de Murcia",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1788&mode=indice&letter=p",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLos Porceles de Murcia es una comedia de autoría fiable de Lope de Vega, citada en el segundo listado de El peregrino en su patria (1618). La obra fue impresa en la Parte 7 de las comedias de Lope de Vega (Madrid, Viuda de Alonso Martín, 1617)[[ (Pr, 184)]]. Todos los catálogos clásicos y el más reciente de Urzáiz recogen esta atribución[[ (UT, II, 676; BL, 441; Art, 294v; Sal, 540; MeR, XLIII; GaH, 144; Faj, 41v; MC, 88)]]. Según Morley y Bruerton, la comedia fue escrita probablemente entre 1604 y 1608[[ (ARTELOPE; MoB, 378; Ch, 552)]]. Existe una edición crítica moderna de la comedia a cargo de Francisco Lobera Serrano[[ (Lope de Vega, Los porceles de Murcia, en Comedias de Lope de Vega, VII, II, Lleida, Milenio, 2008, pp. 707-836)]], en la que se reafirman tanto la autoría como la datación y se exponen una serie de elementos internos y externos que las respaldan.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
