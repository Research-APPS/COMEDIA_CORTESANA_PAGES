    {
      "@id": "https://comedia-cortesana.local/obra/CMC003351",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003351",
      "name": "Hero y Leandro",
      "titulo": "Hero y Leandro",
      "titulo_limpio": "Hero y Leandro",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2813&mode=indice&letter=h",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nHero y Leandro es una comedia de Antonio Mira de Amescua. En la BNE, bajo la signatura Ms. 15367, se conserva una copia manuscrita fechada en 1699 de la comedia con el título Leandro y Hero y atribución a Mira de Amescua. En la misma biblioteca, bajo la signatura Ms. 15264, se encuentra una copia del siglo XIX, con el título de Hero y Leandro[[ (PM, 246-247; MANOS; VR, 86-87)]]. Una obra homónima aparece mencionada en el listado de comedias del Peregrino en su patria, de Lope de Vega, que no debe confundirse con la comedia que nos ocupa. Efectivamente, muchos de los repertorios clásicos manejados mencionan que ambos dramaturgos compusieron una obra con este título[[ (BL, 554; Art, 178v; MeR, XXXV; UT, II, 447, 665)]]. García de la Huerta y Medel del Castillo solo mencionan la atribución a Mira de Amescua [[(GaH, 86; MC, 52)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
