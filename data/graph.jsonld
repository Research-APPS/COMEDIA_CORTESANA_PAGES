      "identifier": "CMC004036",
      "name": "Los corporales de Daroca",
      "titulo": "Los corporales de Daroca",
      "titulo_limpio": "Los corporales de Daroca",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
