      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1896&mode=indice&letter=b",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl bobo del colegio es una comedia de Lope de Vega, publicada por primera en la Parte 14 de las comedias del dramaturgo (Madrid, Viuda de Fernando Correa Montenegro, 1621). Morley y Bruerton avalan la autoría de la obra[[ (MoB, 292-293, 595)]], que aparece citada en la segunda parte de El Peregrino en su patria[[ (ARTELOPE; Ch, 526)]]. Con este título y atribución consta en todos los repertorios clásicos consultados[[ (BL, 443-444, 531; Art, 47r; Sal, 543; MeR, xxvi; GaH, 33; MC, 17; Faj, 10v)]], así como en el catálogo de Urzáiz[[ (UT, II, 655; Pr, 193)]]. Acerca de la datación de la comedia y otros detalles, puede consultarse la edición crítica a cargo Jorge Checa[[ (VEGA CARPIO, Lope de, El bobo del colegio, ed. Jorge Checa, en Comedias de Lope de Vega. Parte XIV, coord. José Enrique López Martínez, Madrid, Gredos, 2015, 2 vols, II, pp. 555-724)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
