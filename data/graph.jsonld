        "schema:CreativeWork"
      ],
      "identifier": "CMC003552",
      "name": "La devoción de la misa",
      "titulo": "La devoción de la misa",
      "titulo_limpio": "La devoción de la misa",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2543&mode=indice&letter=d",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nLa mayoría de catálogos clásicos que manejamos vinculan este título únicamente con el auto sacramental La devoción de la misa de Calderón, representado en 1658[[(BL, 595; Art, 416; Sal, 666; MeR, XXX; MC, 126; GaH, 205; PM, 153)]]. Pero el título de la noticia de representación aquí recogida se corresponde con la comedia homónima de Luis Vélez de Guevara[[(Pr, 25; CM10, 282; UT, 701)]], que fue impresa a su nombre, como hemos señalado en el calendario, en la Parte XXI de Diferentes autores con la indicación \"Representola Valdés\". Según Cotarelo y Mori[[(CM10, 282)]], Schaeffer, al editarla en 1887, la citaba como integrante de un tomo de comedias y como no conocida impresa en la primera mitad del XVII[[(CM10, 282)]]. Existe edición moderna, a cargo de Peale, Manson y González Martínez[[ (2020)]], en cuyo estudio pueden consultarse los detalles de la transmisión del texto.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
