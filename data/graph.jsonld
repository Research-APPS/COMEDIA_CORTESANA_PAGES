      "identifier": "CMC003753",
      "name": "La reina Ester",
      "titulo": "La reina Ester",
      "titulo_limpio": "La reina Ester",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
