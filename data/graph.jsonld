      ],
      "identifier": "CMC002403",
      "name": "Amar, servir y esperar",
      "titulo": "Amar, servir y esperar",
      "titulo_limpio": "Amar, servir y esperar",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
