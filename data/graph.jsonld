      "name": "El José de las mujeres, Santa Eugenia",
      "titulo": "El José de las mujeres, Santa Eugenia",
      "titulo_limpio": "El José de las mujeres, Santa Eugenia",
      "alternateName": "",
      "tipo_obra": "comedia",
