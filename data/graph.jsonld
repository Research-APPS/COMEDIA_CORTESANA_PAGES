      "identifier": "CMC004197",
      "name": "No le arriendo la ganancia",
      "titulo": "No le arriendo la ganancia",
      "titulo_limpio": "No le arriendo la ganancia",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
