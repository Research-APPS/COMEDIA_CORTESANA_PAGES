      "identifier": "CMC003574",
      "name": "La esposa del cielo",
      "titulo": "La esposa del cielo",
      "titulo_limpio": "La esposa del cielo",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
