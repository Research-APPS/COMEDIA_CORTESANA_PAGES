      "identifier": "CMC003324",
      "name": "Galán, valiente y discreto",
      "titulo": "Galán, valiente y discreto",
      "titulo_limpio": "Galán, valiente y discreto",
      "alternateName": "",
      "tipo_obra": "comedia",
