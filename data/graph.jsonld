      "identifier": "CMC004123",
      "name": "Marcos Jarra el bandolero",
      "titulo": "Marcos Jarra el bandolero",
      "titulo_limpio": "Marcos Jarra el bandolero",
      "alternateName": "",
      "tipo_obra": "comedia",
