    {
      "@id": "https://comedia-cortesana.local/obra/CMC004126",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004126",
      "name": "Mañana será otro día",
      "titulo": "Mañana será otro día",
      "titulo_limpio": "Mañana será otro día",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=593&mode=indice&letter=m",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo hay ninguna duda sobre la atribución de Mañana será otro día a Pedro Calderón de la Barca. Casi todos los catálogos clásicos atribuyen la obra a este autor[[ (Faj, 33r; Art, 223r; MC, 66; GaH, 107; Sal, 372; BL, 561)]] y aparece en las listas tempranas de sus obras teatrales[[ (Wi, 97)]]. La única voz menos segura es la de Mesonero Romanos, que da como atribución “Calderón o Lope”[[ (MeR, XXXVIII)]], sin explicar la duda. Cruickshank explora la fecha de composición de la obra en Don Pedro Calderón[[(pp. 174-77)]]. La obra se publicó en la Parte 7 de Calderón (Madrid, Francisco Sanz, 1683) y bajo su nombre en El mejor de los mejores libros de comedias (Madrid, María de Quiñones, 1653)[[ (Sal, 462)]]. En las ediciones sueltas de que tenemos noticia Mañana será otro día siempre se atribuye a Calderón[[ (CG, 263; Moll, 96; BS, 716; Szilvia E. Szmuk, 131)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
