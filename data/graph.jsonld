        "schema:CreativeWork"
      ],
      "identifier": "CMC003120",
      "name": "El premio vencedor",
      "titulo": "El premio vencedor",
      "titulo_limpio": "El premio vencedor",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2240&mode=indice&letter=p",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNo se menciona ninguna comedia titulada El premio vencedor en los catálogos clásicos que manejamos ni nos consta la existencia de testimonios de la obra que nos ocupa. Domínguez Búrdalo interpreta la información confusa que trae el diario de Girolamo da Sommaia (”Represento Pinedo de i Milanesi, el premio vencedor”) y cita la representación salamantina de 1604 que incluimos en el calendario como “Los milaneses, el premio vencedor” preguntándose si el título corresponde a una o dos piezas[[ (DES, 147; Domínguez Búrdalo, p. 200)]]. Urzáiz, partiendo de Domínguez Búrdalo, recoge la comedia con el título Los milaneses, el premio vencedor y la considera una obra anónima[[ (UT, I, 104, 114)]]. Resulta extraño que se trate de dos obras, cuando lo habitual era que una compañía representase tan sólo una comedia el mismo día en el corral de Salamanca.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
