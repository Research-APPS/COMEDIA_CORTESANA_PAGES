    {
      "@id": "https://comedia-cortesana.local/obra/CMC004780",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004780",
      "name": "Las flores (1680)",
      "titulo": "Las flores",
      "titulo_limpio": "Las flores (1680)",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
