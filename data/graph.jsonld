    {
      "@id": "https://comedia-cortesana.local/obra/CMC003770",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003770",
      "name": "La sangre vence imposibles",
      "titulo": "La sangre vence imposibles",
      "titulo_limpio": "La sangre vence imposibles",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1556&mode=indice&letter=s",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nNinguno de los catálogos clásicos recoge una comedia con el título La sangre vence imposibles ni nos constan testimonios de la misma. Urzáiz la cataloga también como anónima[[ (UT, I, 121)]]. Shergold y Varey señalan la posibilidad de que esta representación sea realmente la de Amor vence imposibles, del 23 de octubre, como ya hemos indicado en el calendario[[ (F, IX, 59, 210)]]. Pero bajo este título tampoco aparece ninguna comedia en los catálogos consultados[[ (UT, I, 61)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
