    {
      "@id": "https://comedia-cortesana.local/obra/CMC004308",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004308",
      "name": "San Bartolomé en Armenia",
      "titulo": "San Bartolomé en Armenia",
      "titulo_limpio": "San Bartolomé en Armenia",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1448&mode=indice&letter=s",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSan Bartolomé en Armenia es una comedia de Cristóbal de Monroy y Silva y así lo recogen la mayor parte de los catálogos, excepto Huerta y Medel que la traen sin atribución[[ (UT, II, 458; BL, 264; Art, 332r; Sal, 646; MeR, XLVI; GaH, 163; Faj, 47r; MC, 101)]]. La comedia se imprimió suelta (s.l., s.i., s.a.) a nombre de Monroy[[ (Vega García Luengos; Fernández Lara; del Rey Sayagués, 2001, III, 1178)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
