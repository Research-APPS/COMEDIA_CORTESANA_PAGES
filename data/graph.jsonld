    {
      "@id": "https://comedia-cortesana.local/obra/CMC004220",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004220",
      "name": "Obligar contra su sangre",
      "titulo": "Obligar contra su sangre",
      "titulo_limpio": "Obligar contra su sangre",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=941&mode=indice&letter=o",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nObligar contra su sangre es una comedia que se considera obra de Antonio Mira de Amescua, tal y como figura en varios de los catálogos clásicos que manejamos[[ (BL, 570; Art, 272v; Sal, 632; MeR, XLII; GaH, 133; MC, 81)]]. En la BNE, bajo la signatura Ms. 18.142, se conserva un manuscrito fechado en 1636 de Obligar contra su sangre[[ (PM, 402)]]. En la portada de este manuscrito se atribuye la comedia a un dramaturgo llamado Antonio, pero cuyo apellido resulta ilegible. Cotarelo interpretó, aunque con duda, que el nombre que figura es el de Antonio de Mendoza, y desestimó la paternidad a Mira aduciendo que si la comedia fue compuesta de 1636, esta no podía ser del mencionado dramaturgo porque en ese periodo “ya estaba en Guadix, olvidado del mundo, a no ser que el poseedor del manuscrito lo hubiese guardado hasta que le pareció llegado el momento de representar la obra”[[ (CM14, 48)]]. No obstante, Valladares Reguero no considera que haya motivos para poner en entredicho la autoría de Mira, pues su nombre también figura en las anotaciones finales del manuscrito y, además, la crítica reciente ha destacado que la estancia de Mira en Guadix no supuso un apartamiento de las letras[[ (VR, 128)]]. Por otro lado, la fecha presente en el manuscrito no indica necesariamente la fecha en que se compuso la comedia. Se conservan tres ediciones sueltas de Obligar contra su sangre a nombre de Mira de Amescua[[ (Moll, 121; MPR, 94)]], sin datos de impresión o ya del siglo XVIII[[ (VR, 128-129)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
