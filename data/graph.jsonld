      "identifier": "CMC003710",
      "name": "La nueva victoria de don Gonzalo de Córdoba",
      "titulo": "La nueva victoria de don Gonzalo de Córdoba",
      "titulo_limpio": "La nueva victoria de don Gonzalo de Córdoba",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
