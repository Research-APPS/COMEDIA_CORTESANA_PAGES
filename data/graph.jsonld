    {
      "@id": "https://comedia-cortesana.local/obra/CMC004042",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC004042",
      "name": "Los desposorios de Isaac con Rebeca",
      "titulo": "Los desposorios de Isaac con Rebeca",
      "titulo_limpio": "Los desposorios de Isaac con Rebeca",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=1416&mode=indice&letter=d",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nSegún hipótesis de Sánchez Arjona, el auto Los desposorios de Isaac con Rebeca, también conocido con el título de El desposorio de Isaac con Rebeca, podría ser uno de los dos autos titulados Los desposorios de Isaac recogidos en el Códice de Autos Viejos[[ (SA, 81)]], cuyo manuscrito se conserva en la BNE bajo la signatura Ms. 14.711[[ (PM, 97-98; AM1, 237-39)]]. Esta hipótesis es verosímil, aunque no la podemos confirmar ni desmentir. Por otro lado, en el mismo año de 1590 se representó en Madrid un auto titulado Los desposorios de Isaac, que pensamos que es distinto del que nos ocupa: véase el registro correspondiente en CATCOM.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000086"
      },
      "documentada_en": [
        {
          "@id": "https://comedia-cortesana.local/fuente/catcom"
        }
      ],
      "tiene_representacion": [
        {
          "@id": "https://comedia-cortesana.local/representacion/REP003389"
        }
      ]
    },
    {
      "@id": "https://comedia-cortesana.local/representacion/REP003389",
      "@type": [
        "cmc:Representacion",
        "schema:Event"
      ],
      "identifier": "REP003389",
