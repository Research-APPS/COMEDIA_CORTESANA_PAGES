      "identifier": "CMC002852",
      "name": "El celoso prudente",
      "titulo": "El celoso prudente",
      "titulo_limpio": "El celoso prudente",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
