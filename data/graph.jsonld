    {
      "@id": "https://comedia-cortesana.local/obra/CMC003064",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC003064",
      "name": "El mundi nuevo",
      "titulo": "El mundi nuevo",
      "titulo_limpio": "El mundi nuevo",
      "alternateName": "",
      "tipo_obra": "pieza_breve",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=3299&mode=indice&letter=m",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEl mundi nuevo es una mojiganga de Suárez de Deza, según los catálogos clásicos que manejamos[[(BL, 636; Sal, 698)]], el más reciente de Urzáiz [[(UT, 193, 619)]], y también la colección de piezas breves de Cotarelo y Mori [[(CM, CCLI)]]. De acuerdo con estas fuentes, se imprimió en la Parte Primera de Donaires de Tersícore, de Suárez de Deza (Madrid, Melchor Sánchez, 1663). Adviértase que existen más piezas breves con títulos muy similares que no deben ser confundidas con la mojiganga en cuestión. Sobre ello, véase Pagés Larraya, 1977 y Plata, 2009.",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
