      "identifier": "CMC004796",
      "name": "La ninfa del cielo (1619)",
      "titulo": "La ninfa del cielo",
      "titulo_limpio": "La ninfa del cielo (1619)",
      "alternateName": "",
      "tipo_obra": "auto",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
