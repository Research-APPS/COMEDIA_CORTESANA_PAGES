    {
      "@id": "https://comedia-cortesana.local/obra/CMC002537",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002537",
      "name": "Cumplir con su obligación",
      "titulo": "Cumplir con su obligación",
      "titulo_limpio": "Cumplir con su obligación",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=2145&mode=indice&letter=c",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nCumplir con su obligación es una comedia de Juan Pérez de Montalbán, tal y como se indica en todos los catálogos clásicos que manejamos[[ (Faj, 14v; MC, 27; GaH, 49; MeR, XXIX; Sal, 480, 585; Art, 89v; BL, 267-68, 539)]] y en algunos más recientes[[ (R1, 337; Moll, 37; BS, 84; MPR, 31; Pr1, 107, 109-10, 213-14, 241-43, 560; UT, II, 507; TESO)]]. Cumplir con su obligación se publicó en la Parte 1 de las comedias de Montalbán (Madrid, Imprenta del Reino, 1635)[[ (BL, 267-68, 539; Pr1, 107; TESO)]] y posteriormente se publicó en forma de suelta al menos en cuatro ediciones en Sevilla, Madrid y Valencia, aparecidas entre finales del siglo XVII y durante el siglo XVIII[[ (Pr1, 241-42)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
        "@id": "https://comedia-cortesana.local/autor/AUT000164"
      },
      "autor": {
        "@id": "https://comedia-cortesana.local/autor/AUT000164"
      },
      "documentada_en": [
