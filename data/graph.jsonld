        "schema:CreativeWork"
      ],
      "identifier": "CMC003595",
      "name": "La francesilla",
      "titulo": "La francesilla",
      "titulo_limpio": "La francesilla",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
      "fecha_creacion": "",
      "url_catcom": "https://catcom.uv.es/consulta/browserecord.php?id=120&mode=indice&letter=f",
      "notas": "Importado desde CATCOM backup",
      "notas_bibliograficas": "",
      "observaciones": "Atribución (CATCOM):\nEsta comedia de Lope se publicó en la Parte 13 (Madrid, Viuda de Alonso Martín, 1620), en donde el dramaturgo dejó constancia de que la había estrenado el autor Nicolás de los Ríos. El propio Lope la incluyó en su lista de comedias aparecida en la primera edición de El peregrino en su patria (1604). Se conserva un manuscrito apógrafo en la BNE bajo la signatura Ms. 22423[[ (ARTELOPE)]]. Morley y Bruerton la incluyen entre las auténticas de Lope y sitúan su fecha de composición entre 1595 y 1596 [[ (MoB, 46, 78)]].",
      "edicion_principe": "",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
