    {
      "@id": "https://comedia-cortesana.local/obra/CMC002486",
      "@type": [
        "cmc:Obra",
        "schema:CreativeWork"
      ],
      "identifier": "CMC002486",
      "name": "Celos aun del aire matan",
      "titulo": "Celos aun del aire matan",
      "titulo_limpio": "Celos aun del aire matan",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "comedia",
      "estado_ficha": "en_revision",
      "fuente_principal": "FUENTESIX",
      "pagina_pdf": 6,
      "mecenas": "",
      "musica_conservada": true,
      "compositor": "Juan Hidalgo para la primera jornada; en la Biblioteca Pública de Évora se encuentra un manuscrito de la música de la obra entera (Alegría",
      "fecha_creacion": "",
      "url_catcom": "",
      "notas": "",
      "notas_bibliograficas": "Comedia de Calderón, impresa en Escogidas XIX (Madrid, 1663), fols. 194 r. - 212 r.: «Fiesta que se representó a sus Magestades en el Buen Retiro. Cantada.» Según Hesse, PQ, XXVII (1948), 45, esta es la edición príncipe. K. y R. Reichenberger, I, 177, anotan un manuscrito de esta comedia conservado en el Palacio de Liria. Hay versión manuscrita de un tono sacado de esta comedia en la B.N.M., 17.666, págs. 486-489 (véase E. M. Wilson, RABM, LXVIII [1960], 483-486), y otro ejemplar manuscrito en la Colección Borbón-Lorenzano de la Biblioteca Pública de Toledo (Goldberg, núm. 130, págs. 151-152). Subirá publicó en 1933 la música de Juan Hidalgo para la primera jornada; en la Biblioteca Pública de Évora se encuentra un manuscrito de la música de la obra entera (Alegría, 64).",
      "observaciones": "",
      "edicion_principe": "Escogidas XIX (Madrid",
      "manuscritos_conocidos": "",
      "ediciones_conocidas": "",
      "testimonio_manuscrito": false,
      "testimonio_impreso": false,
      "author": {
