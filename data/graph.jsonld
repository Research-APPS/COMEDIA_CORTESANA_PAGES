      "identifier": "CMC002969",
      "name": "El hijo de Marco Aurelio",
      "titulo": "El hijo de Marco Aurelio",
      "titulo_limpio": "El hijo de Marco Aurelio",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
      "estado_ficha": "cruda",
      "fuente_principal": "CATCOM",
      "pagina_pdf": null,
      "mecenas": "",
      "musica_conservada": false,
      "compositor": "",
