      "identifier": "CMC003151",
      "name": "El rapto de Elías",
      "titulo": "El rapto de Elías",
      "titulo_limpio": "El rapto de Elías",
      "alternateName": "",
      "tipo_obra": "comedia",
      "genre": "",
